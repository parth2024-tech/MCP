script-source,31,node:diagnostics_channel,'use strict';\n\nconst {\n  ArrayPrototypeAt\x2C\n  ArrayPrototypeIndexOf\x2C\n  ArrayPrototypePush\x2C\n  ArrayPrototypePushApply\x2C\n  ArrayPrototypeSlice\x2C\n  ArrayPrototypeSplice\x2C\n  ObjectDefineProperty\x2C\n  ObjectGetPrototypeOf\x2C\n  ObjectSetPrototypeOf\x2C\n  PromisePrototypeThen\x2C\n  PromiseReject\x2C\n  ReflectApply\x2C\n  SafeFinalizationRegistry\x2C\n  SafeMap\x2C\n  SymbolDispose\x2C\n  SymbolHasInstance\x2C\n} = primordials;\n\nconst {\n  codes: {\n    ERR_INVALID_ARG_TYPE\x2C\n  }\x2C\n} = require('internal/errors');\nconst {\n  validateFunction\x2C\n} = require('internal/validators');\n\nconst { triggerUncaughtException } = internalBinding('errors');\n\nconst dc_binding = internalBinding('diagnostics_channel');\nconst { subscribers: subscriberCounts } = dc_binding;\n\nconst { WeakReference } = require('internal/util');\nconst { isPromise } = require('internal/util/types');\n\n// Can't delete when weakref count reaches 0 as it could increment again.\n// Only GC can be used as a valid time to clean up the channels map.\nclass WeakRefMap extends SafeMap {\n  #finalizers = new SafeFinalizationRegistry((key) => {\n    // Check that the key doesn't have any value before deleting\x2C as the WeakRef for the key\n    // may have been replaced since finalization callbacks aren't synchronous with GC.\n    if (!this.has(key)) this.delete(key);\n  });\n\n  set(key\x2C value) {\n    this.#finalizers.register(value\x2C key);\n    return super.set(key\x2C new WeakReference(value));\n  }\n\n  get(key) {\n    return super.get(key)?.get();\n  }\n\n  has(key) {\n    return !!this.get(key);\n  }\n\n  incRef(key) {\n    return super.get(key)?.incRef();\n  }\n\n  decRef(key) {\n    return super.get(key)?.decRef();\n  }\n}\n\nfunction markActive(channel) {\n  // eslint-disable-next-line no-use-before-define\n  ObjectSetPrototypeOf(channel\x2C ActiveChannel.prototype);\n  channel._subscribers = [];\n  channel._stores = new SafeMap();\n}\n\nfunction maybeMarkInactive(channel) {\n  // When there are no more active subscribers or bound\x2C restore to fast prototype.\n  if (!channel._subscribers.length && !channel._stores.size) {\n    // eslint-disable-next-line no-use-before-define\n    ObjectSetPrototypeOf(channel\x2C Channel.prototype);\n    channel._subscribers = undefined;\n    channel._stores = undefined;\n  }\n}\n\nclass RunStoresScope {\n  #stack;\n\n  constructor(activeChannel\x2C data) {\n    // eslint-disable-next-line no-restricted-globals\n    using stack = new DisposableStack();\n\n    // Enter stores using withScope\n    if (activeChannel._stores) {\n      for (const entry of activeChannel._stores.entries()) {\n        const store = entry[0];\n        const transform = entry[1];\n\n        let newContext = data;\n        if (transform) {\n          try {\n            newContext = transform(data);\n          } catch (err) {\n            process.nextTick(() => {\n              triggerUncaughtException(err\x2C false);\n            });\n            continue;\n          }\n        }\n\n        stack.use(store.withScope(newContext));\n      }\n    }\n\n    // Publish data\n    activeChannel.publish(data);\n\n    // Transfer ownership of the stack\n    this.#stack = stack.move();\n  }\n\n  [SymbolDispose]() {\n    this.#stack[SymbolDispose]();\n  }\n}\n\n// TODO(qard): should there be a C++ channel interface?\nclass ActiveChannel {\n  subscribe(subscription) {\n    validateFunction(subscription\x2C 'subscription');\n    this._subscribers = ArrayPrototypeSlice(this._subscribers);\n    ArrayPrototypePush(this._subscribers\x2C subscription);\n    channels.incRef(this.name);\n    if (this._index !== undefined) subscriberCounts[this._index]++;\n  }\n\n  unsubscribe(subscription) {\n    const index = ArrayPrototypeIndexOf(this._subscribers\x2C subscription);\n    if (index === -1) return false;\n\n    const before = ArrayPrototypeSlice(this._subscribers\x2C 0\x2C index);\n    const after = ArrayPrototypeSlice(this._subscribers\x2C index + 1);\n    this._subscribers = before;\n    ArrayPrototypePushApply(this._subscribers\x2C after);\n\n    channels.decRef(this.name);\n    if (this._index !== undefined) subscriberCounts[this._index]--;\n    maybeMarkInactive(this);\n\n    return true;\n  }\n\n  bindStore(store\x2C transform) {\n    const replacing = this._stores.has(store);\n    if (!replacing) {\n      channels.incRef(this.name);\n      if (this._index !== undefined) subscriberCounts[this._index]++;\n    }\n    this._stores.set(store\x2C transform);\n  }\n\n  unbindStore(store) {\n    if (!this._stores.has(store)) {\n      return false;\n    }\n\n    this._stores.delete(store);\n\n    channels.decRef(this.name);\n    if (this._index !== undefined) subscriberCounts[this._index]--;\n    maybeMarkInactive(this);\n\n    return true;\n  }\n\n  get hasSubscribers() {\n    return true;\n  }\n\n  publish(data) {\n    const subscribers = this._subscribers;\n    for (let i = 0; i < (subscribers?.length || 0); i++) {\n      try {\n        const onMessage = subscribers[i];\n        onMessage(data\x2C this.name);\n      } catch (err) {\n        process.nextTick(() => {\n          triggerUncaughtException(err\x2C false);\n        });\n      }\n    }\n  }\n\n  withStoreScope(data) {\n    return new RunStoresScope(this\x2C data);\n  }\n\n  runStores(data\x2C fn\x2C thisArg\x2C ...args) {\n    // eslint-disable-next-line no-unused-vars\n    using scope = this.withStoreScope(data);\n    return ReflectApply(fn\x2C thisArg\x2C args);\n  }\n}\n\nclass Channel {\n  constructor(name) {\n    this._subscribers = undefined;\n    this._stores = undefined;\n    this.name = name;\n    if (typeof name === 'string') {\n      this._index = dc_binding.getOrCreateChannelIndex(name);\n    }\n\n    channels.set(name\x2C this);\n  }\n\n  static [SymbolHasInstance](instance) {\n    const prototype = ObjectGetPrototypeOf(instance);\n    return prototype === Channel.prototype ||\n           prototype === ActiveChannel.prototype;\n  }\n\n  subscribe(subscription) {\n    markActive(this);\n    this.subscribe(subscription);\n  }\n\n  unsubscribe() {\n    return false;\n  }\n\n  bindStore(store\x2C transform) {\n    markActive(this);\n    this.bindStore(store\x2C transform);\n  }\n\n  unbindStore() {\n    return false;\n  }\n\n  get hasSubscribers() {\n    return false;\n  }\n\n  publish() {}\n\n  runStores(data\x2C fn\x2C thisArg\x2C ...args) {\n    return ReflectApply(fn\x2C thisArg\x2C args);\n  }\n\n  withStoreScope() {\n    // Return no-op disposable for inactive channels\n    return {\n      [SymbolDispose]() {}\x2C\n    };\n  }\n}\n\nconst channels = new WeakRefMap();\n\nfunction channel(name) {\n  const channel = channels.get(name);\n  if (channel) return channel;\n\n  if (typeof name !== 'string' && typeof name !== 'symbol') {\n    throw new ERR_INVALID_ARG_TYPE('channel'\x2C ['string'\x2C 'symbol']\x2C name);\n  }\n\n  return new Channel(name);\n}\n\nfunction subscribe(name\x2C subscription) {\n  return channel(name).subscribe(subscription);\n}\n\nfunction unsubscribe(name\x2C subscription) {\n  return channel(name).unsubscribe(subscription);\n}\n\nfunction hasSubscribers(name) {\n  const channel = channels.get(name);\n  if (!channel) return false;\n\n  return channel.hasSubscribers;\n}\n\nconst boundedEvents = [\n  'start'\x2C\n  'end'\x2C\n];\n\nfunction assertChannel(value\x2C name) {\n  if (!(value instanceof Channel)) {\n    throw new ERR_INVALID_ARG_TYPE(name\x2C ['Channel']\x2C value);\n  }\n}\n\nfunction emitNonThenableWarning(fn) {\n  process.emitWarning(`tracePromise was called with the function '${fn.name || '<anonymous>'}'\x2C ` +\n                      'which returned a non-thenable.');\n}\n\nfunction channelFromMap(nameOrChannels\x2C name\x2C className) {\n  if (typeof nameOrChannels === 'string') {\n    return channel(`tracing:${nameOrChannels}:${name}`);\n  }\n\n  if (typeof nameOrChannels === 'object' && nameOrChannels !== null) {\n    const channel = nameOrChannels[name];\n    assertChannel(channel\x2C `nameOrChannels.${name}`);\n    return channel;\n  }\n\n  throw new ERR_INVALID_ARG_TYPE('nameOrChannels'\x2C\n                                 ['string'\x2C 'object'\x2C className]\x2C\n                                 nameOrChannels);\n}\n\nclass BoundedChannelScope {\n  #context;\n  #end;\n  #scope;\n\n  constructor(boundedChannel\x2C context) {\n    // Only proceed if there are subscribers\n    if (!boundedChannel.hasSubscribers) {\n      return;\n    }\n\n    const { start\x2C end } = boundedChannel;\n    this.#context = context;\n    this.#end = end;\n\n    // Use RunStoresScope for the start channel\n    this.#scope = new RunStoresScope(start\x2C context);\n  }\n\n  [SymbolDispose]() {\n    if (!this.#scope) {\n      return;\n    }\n\n    // Publish end event\n    this.#end.publish(this.#context);\n\n    // Dispose the start scope to restore stores\n    this.#scope[SymbolDispose]();\n    this.#scope = undefined;\n  }\n}\n\nclass BoundedChannel {\n  constructor(nameOrChannels) {\n    for (let i = 0; i < boundedEvents.length; ++i) {\n      const eventName = boundedEvents[i];\n      ObjectDefineProperty(this\x2C eventName\x2C {\n        __proto__: null\x2C\n        value: channelFromMap(nameOrChannels\x2C eventName\x2C 'BoundedChannel')\x2C\n      });\n    }\n  }\n\n  get hasSubscribers() {\n    return this.start?.hasSubscribers ||\n      this.end?.hasSubscribers;\n  }\n\n  subscribe(handlers) {\n    for (let i = 0; i < boundedEvents.length; ++i) {\n      const name = boundedEvents[i];\n      if (!handlers[name]) continue;\n\n      this[name]?.subscribe(handlers[name]);\n    }\n  }\n\n  unsubscribe(handlers) {\n    let done = true;\n\n    for (let i = 0; i < boundedEvents.length; ++i) {\n      const name = boundedEvents[i];\n      if (!handlers[name]) continue;\n\n      if (!this[name]?.unsubscribe(handlers[name])) {\n        done = false;\n      }\n    }\n\n    return done;\n  }\n\n  withScope(context = {}) {\n    return new BoundedChannelScope(this\x2C context);\n  }\n\n  run(context\x2C fn\x2C thisArg\x2C ...args) {\n    context ??= {};\n    // eslint-disable-next-line no-unused-vars\n    using scope = this.withScope(context);\n    return ReflectApply(fn\x2C thisArg\x2C args);\n  }\n}\n\nfunction boundedChannel(nameOrChannels) {\n  return new BoundedChannel(nameOrChannels);\n}\n\nclass TracingChannel {\n  #callWindow;\n  #continuationWindow;\n\n  constructor(nameOrChannels) {\n    // Create a BoundedChannel for start/end (call window)\n    if (typeof nameOrChannels === 'string') {\n      this.#callWindow = new BoundedChannel(nameOrChannels);\n      this.#continuationWindow = new BoundedChannel({\n        start: channel(`tracing:${nameOrChannels}:asyncStart`)\x2C\n        end: channel(`tracing:${nameOrChannels}:asyncEnd`)\x2C\n      });\n    } else if (typeof nameOrChannels === 'object') {\n      this.#callWindow = new BoundedChannel({\n        start: nameOrChannels.start\x2C\n        end: nameOrChannels.end\x2C\n      });\n      this.#continuationWindow = new BoundedChannel({\n        start: nameOrChannels.asyncStart\x2C\n        end: nameOrChannels.asyncEnd\x2C\n      });\n    }\n\n    // Create individual channel for error\n    ObjectDefineProperty(this\x2C 'error'\x2C {\n      __proto__: null\x2C\n      value: channelFromMap(nameOrChannels\x2C 'error'\x2C 'TracingChannel')\x2C\n    });\n  }\n\n  get start() {\n    return this.#callWindow.start;\n  }\n\n  get end() {\n    return this.#callWindow.end;\n  }\n\n  get asyncStart() {\n    return this.#continuationWindow.start;\n  }\n\n  get asyncEnd() {\n    return this.#continuationWindow.end;\n  }\n\n  get hasSubscribers() {\n    return this.#callWindow.hasSubscribers ||\n      this.#continuationWindow.hasSubscribers ||\n      this.error?.hasSubscribers;\n  }\n\n  subscribe(handlers) {\n    // Subscribe to call window (start/end)\n    if (handlers.start || handlers.end) {\n      this.#callWindow.subscribe({\n        start: handlers.start\x2C\n        end: handlers.end\x2C\n      });\n    }\n\n    // Subscribe to continuation window (asyncStart/asyncEnd)\n    if (handlers.asyncStart || handlers.asyncEnd) {\n      this.#continuationWindow.subscribe({\n        start: handlers.asyncStart\x2C\n        end: handlers.asyncEnd\x2C\n      });\n    }\n\n    // Subscribe to error channel\n    if (handlers.error) {\n      this.error.subscribe(handlers.error);\n    }\n  }\n\n  unsubscribe(handlers) {\n    let done = true;\n\n    // Unsubscribe from call window\n    if (handlers.start || handlers.end) {\n      if (!this.#callWindow.unsubscribe({\n        start: handlers.start\x2C\n        end: handlers.end\x2C\n      })) {\n        done = false;\n      }\n    }\n\n    // Unsubscribe from continuation window\n    if (handlers.asyncStart || handlers.asyncEnd) {\n      if (!this.#continuationWindow.unsubscribe({\n        start: handlers.asyncStart\x2C\n        end: handlers.asyncEnd\x2C\n      })) {\n        done = false;\n      }\n    }\n\n    // Unsubscribe from error channel\n    if (handlers.error) {\n      if (!this.error.unsubscribe(handlers.error)) {\n        done = false;\n      }\n    }\n\n    return done;\n  }\n\n  traceSync(fn\x2C context = {}\x2C thisArg\x2C ...args) {\n    if (!this.hasSubscribers) {\n      return ReflectApply(fn\x2C thisArg\x2C args);\n    }\n\n    const { error } = this;\n\n    // eslint-disable-next-line no-unused-vars\n    using scope = this.#callWindow.withScope(context);\n    try {\n      const result = ReflectApply(fn\x2C thisArg\x2C args);\n      context.result = result;\n      return result;\n    } catch (err) {\n      context.error = err;\n      error.publish(context);\n      throw err;\n    }\n  }\n\n  tracePromise(fn\x2C context = {}\x2C thisArg\x2C ...args) {\n    if (!this.hasSubscribers) {\n      const result = ReflectApply(fn\x2C thisArg\x2C args);\n      if (typeof result?.then !== 'function') {\n        emitNonThenableWarning(fn);\n      }\n      return result;\n    }\n\n    const { error } = this;\n    const continuationWindow = this.#continuationWindow;\n\n    function reject(err) {\n      context.error = err;\n      error.publish(context);\n      // Use continuation window for asyncStart/asyncEnd\n      // eslint-disable-next-line no-unused-vars\n      using scope = continuationWindow.withScope(context);\n      // TODO: Is there a way to have asyncEnd _after_ the continuation?\n      return PromiseReject(err);\n    }\n\n    function resolve(result) {\n      context.result = result;\n      // Use continuation window for asyncStart/asyncEnd\n      // eslint-disable-next-line no-unused-vars\n      using scope = continuationWindow.withScope(context);\n      // TODO: Is there a way to have asyncEnd _after_ the continuation?\n      return result;\n    }\n\n    // eslint-disable-next-line no-unused-vars\n    using scope = this.#callWindow.withScope(context);\n    try {\n      const result = ReflectApply(fn\x2C thisArg\x2C args);\n      // If the return value is not a thenable\x2C return it directly with a warning.\n      // Do not publish to asyncStart/asyncEnd.\n      if (typeof result?.then !== 'function') {\n        emitNonThenableWarning(fn);\n        context.result = result;\n        return result;\n      }\n      // For native Promises use PromisePrototypeThen to avoid user overrides.\n      if (isPromise(result)) {\n        return PromisePrototypeThen(result\x2C resolve\x2C reject);\n      }\n      // For custom thenables\x2C call .then() directly to preserve the thenable type.\n      return result.then(resolve\x2C reject);\n    } catch (err) {\n      context.error = err;\n      error.publish(context);\n      throw err;\n    }\n  }\n\n  traceCallback(fn\x2C position = -1\x2C context = {}\x2C thisArg\x2C ...args) {\n    if (!this.hasSubscribers) {\n      return ReflectApply(fn\x2C thisArg\x2C args);\n    }\n\n    const { error } = this;\n    const continuationWindow = this.#continuationWindow;\n\n    function wrappedCallback(err\x2C res) {\n      if (err) {\n        context.error = err;\n        error.publish(context);\n      } else {\n        context.result = res;\n      }\n\n      // Use continuation window for asyncStart/asyncEnd around callback\n      // eslint-disable-next-line no-unused-vars\n      using scope = continuationWindow.withScope(context);\n      return ReflectApply(callback\x2C this\x2C arguments);\n    }\n\n    const callback = ArrayPrototypeAt(args\x2C position);\n    validateFunction(callback\x2C 'callback');\n    ArrayPrototypeSplice(args\x2C position\x2C 1\x2C wrappedCallback);\n\n    // eslint-disable-next-line no-unused-vars\n    using scope = this.#callWindow.withScope(context);\n    try {\n      return ReflectApply(fn\x2C thisArg\x2C args);\n    } catch (err) {\n      context.error = err;\n      error.publish(context);\n      throw err;\n    }\n  }\n}\n\nfunction tracingChannel(nameOrChannels) {\n  return new TracingChannel(nameOrChannels);\n}\n\ndc_binding.linkNativeChannel((name) => channel(name));\n\nmodule.exports = {\n  channel\x2C\n  hasSubscribers\x2C\n  subscribe\x2C\n  tracingChannel\x2C\n  unsubscribe\x2C\n  boundedChannel\x2C\n  Channel\x2C\n  BoundedChannel\x2C\n};\n

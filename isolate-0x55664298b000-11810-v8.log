script-source,415,/home/thor/skiils/tools/server/node_modules/file-uri-to-path/index.js,\n/**\n * Module dependencies.\n */\n\nvar sep = require('path').sep || '/';\n\n/**\n * Module exports.\n */\n\nmodule.exports = fileUriToPath;\n\n/**\n * File URI to Path function.\n *\n * @param {String} uri\n * @return {String} path\n * @api public\n */\n\nfunction fileUriToPath (uri) {\n  if ('string' != typeof uri ||\n      uri.length <= 7 ||\n      'file://' != uri.substring(0\x2C 7)) {\n    throw new TypeError('must pass in a file:// URI to convert to a file path');\n  }\n\n  var rest = decodeURI(uri.substring(7));\n  var firstSlash = rest.indexOf('/');\n  var host = rest.substring(0\x2C firstSlash);\n  var path = rest.substring(firstSlash + 1);\n\n  // 2.  Scheme Definition\n  // As a special case\x2C <host> can be the string "localhost" or the empty\n  // string; this is interpreted as "the machine from which the URL is\n  // being interpreted".\n  if ('localhost' == host) host = '';\n\n  if (host) {\n    host = sep + sep + host;\n  }\n\n  // 3.2  Drives\x2C drive letters\x2C mount points\x2C file system root\n  // Drive letters are mapped into the top of a file URI in various ways\x2C\n  // depending on the implementation; some applications substitute\n  // vertical bar ("|") for the colon after the drive letter\x2C yielding\n  // "file:///c|/tmp/test.txt".  In some cases\x2C the colon is left\n  // unchanged\x2C as in "file:///c:/tmp/test.txt".  In other cases\x2C the\n  // colon is simply omitted\x2C as in "file:///c/tmp/test.txt".\n  path = path.replace(/^(.+)\\|/\x2C '$1:');\n\n  // for Windows\x2C we need to invert the path separators from what a URI uses\n  if (sep == '\\\\') {\n    path = path.replace(/\\//g\x2C '\\\\');\n  }\n\n  if (/^.+\\:/.test(path)) {\n    // has Windows drive at beginning of path\n  } else {\n    // unix path\u2026\n    path = sep + path;\n  }\n\n  return host + path;\n}\n

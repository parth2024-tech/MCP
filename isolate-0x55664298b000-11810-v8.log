script-source,412,/home/thor/skiils/tools/server/src/services/session-state.js,const fs = require('fs');\nconst path = require('path');\nconst { logger } = require('../utils/logger');\n\nconst STATE_FILE = path.join(process.cwd()\x2C 'skills_session_state.json');\n\nclass SessionState {\n  constructor(sessionId) {\n    this.sessionId = sessionId;\n    this.state = this._loadState();\n    \n    if (!this.state[this.sessionId]) {\n      this.state[this.sessionId] = {\n        startedAt: new Date().toISOString()\x2C\n        skills: {}\n      };\n      this._saveState();\n    }\n  }\n\n  _loadState() {\n    try {\n      if (fs.existsSync(STATE_FILE)) {\n        const data = fs.readFileSync(STATE_FILE\x2C 'utf8');\n        return JSON.parse(data);\n      }\n    } catch (err) {\n      logger.error('SessionState'\x2C `Failed to load state file: ${err.message}`);\n    }\n    return {};\n  }\n\n  _saveState() {\n    try {\n      fs.writeFileSync(STATE_FILE\x2C JSON.stringify(this.state\x2C null\x2C 2)\x2C 'utf8');\n    } catch (err) {\n      logger.error('SessionState'\x2C `Failed to save state file: ${err.message}`);\n    }\n  }\n\n  /**\n   * Initialize a skill in the current session.\n   * @param {string} skillName \n   * @param {string[]} stepIds \n   */\n  initSkill(skillName\x2C stepIds = []) {\n    const session = this.state[this.sessionId];\n    \n    // Don't overwrite if already initialized\x2C but we could append new steps if needed\n    if (!session.skills[skillName]) {\n      const stepsState = {};\n      for (const id of stepIds) {\n        stepsState[id] = {\n          status: 'pending'\x2C\n          history: [] // { status\x2C timestamp\x2C context }\n        };\n      }\n      \n      session.skills[skillName] = {\n        loadedAt: new Date().toISOString()\x2C\n        steps: stepsState\n      };\n      \n      this._saveState();\n      logger.info('SessionState'\x2C `Initialized telemetry for skill: ${skillName} (${stepIds.length} steps)`);\n    }\n  }\n\n  /**\n   * Log a step transition.\n   * @param {string} skillName \n   * @param {string} stepId \n   * @param {string} status - started\x2C completed\x2C skipped\x2C blocked\x2C failed\n   * @param {string} context - optional context/reason\n   */\n  logStep(skillName\x2C stepId\x2C status\x2C context = '') {\n    const session = this.state[this.sessionId];\n    if (!session.skills[skillName]) {\n      throw new Error(`Skill ${skillName} has not been loaded in this session.`);\n    }\n\n    const skill = session.skills[skillName];\n    if (!skill.steps[stepId]) {\n      // Allow dynamic steps just in case\x2C though they should be initialized\n      skill.steps[stepId] = { status: 'pending'\x2C history: [] };\n    }\n\n    const timestamp = new Date().toISOString();\n    \n    skill.steps[stepId].status = status;\n    skill.steps[stepId].history.push({\n      status\x2C\n      timestamp\x2C\n      context\n    });\n\n    this._saveState();\n    logger.info('SessionState'\x2C `Logged step ${stepId} as ${status} [${skillName}]`);\n  }\n\n  /**\n   * Get a report of the current session's skill progression.\n   */\n  getReport() {\n    const session = this.state[this.sessionId];\n    const report = {\n      sessionId: this.sessionId\x2C\n      uptime_seconds: Math.floor((Date.now() - new Date(session.startedAt).getTime()) / 1000)\x2C\n      active_skills: Object.keys(session.skills)\x2C\n      skills: {}\n    };\n\n    for (const [skillName\x2C skillData] of Object.entries(session.skills)) {\n      const steps = skillData.steps;\n      let completed = 0;\n      let skipped = 0;\n      let failed = 0;\n      let pending = 0;\n      let blocked = 0;\n      \n      const stepDetails = {};\n      \n      for (const [stepId\x2C stepData] of Object.entries(steps)) {\n        if (stepData.status === 'completed') completed++;\n        else if (stepData.status === 'skipped') skipped++;\n        else if (stepData.status === 'failed') failed++;\n        else if (stepData.status === 'blocked') blocked++;\n        else pending++;\n        \n        // Calculate time spent if completed/skipped/failed from 'started'\n        let timeSpentMs = 0;\n        let startedTime = null;\n        for (const evt of stepData.history) {\n          if (evt.status === 'started') {\n            startedTime = new Date(evt.timestamp).getTime();\n          } else if (startedTime && ['completed'\x2C 'skipped'\x2C 'failed'\x2C 'blocked'].includes(evt.status)) {\n            timeSpentMs += new Date(evt.timestamp).getTime() - startedTime;\n            startedTime = null;\n          }\n        }\n        \n        stepDetails[stepId] = {\n          current_status: stepData.status\x2C\n          time_spent_seconds: Math.round(timeSpentMs / 1000)\x2C\n          transitions: stepData.history.length\n        };\n      }\n      \n      report.skills[skillName] = {\n        summary: {\n          total_steps: Object.keys(steps).length\x2C\n          completed\x2C\n          skipped\x2C\n          failed\x2C\n          blocked\x2C\n          pending\n        }\x2C\n        steps: stepDetails\n      };\n    }\n\n    return report;\n  }\n}\n\nmodule.exports = SessionState;\n

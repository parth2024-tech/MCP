script-source,416,/home/thor/skiils/tools/server/src/tools/get_model_config.js,const { logAccess } = require('../utils/logger');\nconst { routeModel } = require('../services/model-router');\n\nmodule.exports = (deps) => ({\n  name: 'get_model_config'\x2C\n  description: 'Analyzes a user request and returns the optimal LLM model\x2C temperature\x2C and token limit for that task type.'\x2C\n  inputSchema: {\n    type: 'object'\x2C\n    properties: {\n      request: {\n        type: 'string'\x2C\n        description: 'The user request text to analyze for task type and model routing.'\n      }\n    }\x2C\n    required: ['request']\n  }\x2C\n  handler: async (args) => {\n    const config = await routeModel(args.request); // awaiting in case it's refactored to async\n    logAccess('mcp-client'\x2C 'get_model_config'\x2C 'authorized'\x2C 0\x2C { task_type: config.task_type\x2C model: config.model });\n    return config;\n  }\n});\n

es by score.\n * @property {boolean} [percentage=false] Whether to return the boxes coordinates in percentage (true) or in pixels (false).\n * \n * @callback ObjectDetectionPipelineCallback Detect objects (bounding boxes & classes) in the image(s) passed as inputs.\n * @param {ImagePipelineInputs} images The input images.\n * @param {ObjectDetectionPipelineOptions} [options] The options to use for object detection.\n * @returns {Promise<ObjectDetectionPipelineOutput|ObjectDetectionPipelineOutput[]>} A list of objects or a list of list of objects. \n * \n * @typedef {ImagePipelineConstructorArgs & ObjectDetectionPipelineCallback & Disposable} ObjectDetectionPipelineType\n */\n\n/**\n * Object detection pipeline using any `AutoModelForObjectDetection`.\n * This pipeline predicts bounding boxes of objects and their classes.\n * \n * **Example:** Run object-detection with `Xenova/detr-resnet-50`.\n * ```javascript\n * const detector = await pipeline('object-detection'\x2C 'Xenova/detr-resnet-50');\n * const img = 'https://huggingface.co/datasets/Xenova/transformers.js-docs/resolve/main/cats.jpg';\n * const output = await detector(img\x2C { threshold: 0.9 });\n * // [{\n * //   score: 0.9976370930671692\x2C\n * //   label: "remote"\x2C\n * //   box: { xmin: 31\x2C ymin: 68\x2C xmax: 190\x2C ymax: 118 }\n * // }\x2C\n * // ...\n * // {\n * //   score: 0.9984092116355896\x2C\n * //   label: "cat"\x2C\n * //   box: { xmin: 331\x2C ymin: 19\x2C xmax: 649\x2C ymax: 371 }\n * // }]\n * ```\n */\nexport class ObjectDetectionPipeline extends (/** @type {new (options: ImagePipelineConstructorArgs) => ObjectDetectionPipelineType} */ (Pipeline)) {\n\n    /**\n     * Create a new ObjectDetectionPipeline.\n     * @param {ImagePipelineConstructorArgs} options An object used to instantiate the pipeline.\n     */\n    constructor(options) {\n        super(options);\n    }\n\n    /** @type {ObjectDetectionPipelineCallback} */\n    async _call(images\x2C {\n        threshold = 0.9\x2C\n        percentage = false\x2C\n    } = {}) {\n\n        const isBatched = Array.isArray(images);\n\n        if (isBatched && images.length !== 1) {\n            throw Error("Object detection pipeline currently only supports a batch size of 1.");\n        }\n        const preparedImages = await prepareImages(images);\n\n        const imageSizes = percentage ? null : preparedImages.map(x => [x.height\x2C x.width]);\n\n        const { pixel_values\x2C pixel_mask } = await this.processor(preparedImages);\n        const output = await this.model({ pixel_values\x2C pixel_mask });\n\n        // @ts-ignore\n        const processed = this.processor.feature_extractor.post_process_object_detection(output\x2C threshold\x2C imageSizes);\n\n        // Add labels\n        const id2label = this.model.config.id2label;\n\n        // Format output\n        /** @type {ObjectDetectionPipelineOutput[]} */\n        const result = processed.map(batch => (\n            batch.boxes.map((box\x2C i) => ({\n                score: batch.scores[i]\x2C\n                label: id2label[batch.classes[i]]\x2C\n                box: get_bounding_box(box\x2C !percentage)\x2C\n            }))\n        ))\n\n        return isBatched ? result : result[0];\n    }\n}\n\n\n/**\n * @typedef {Object} ZeroShotObjectDetectionOutput\n * @property {string} label Text query corresponding to the found object.\n * @property {number} score Score corresponding to the object (between 0 and 1).\n * @property {BoundingBox} box Bounding box of the detected object in image's original size\x2C or as a percentage if `percentage` is set to true.\n * \n * @typedef {Object} ZeroShotObjectDetectionPipelineOptions Parameters specific to zero-shot object detection pipelines.\n * @property {number} [threshold=0.1] The probability necessary to make a prediction.\n * @property {number} [topk=null] The number of top predictions that will be returned by the pipeline.\n * If the provided number is `null` or higher than the number of predictions available\x2C it will default\n * to the number of predictions.\n * @property {boolean} [percentage=false] Whether to return the boxes coordinates in percentage (true) or in pixels (false).\n * \n * @callback ZeroShotObjectDetectionPipelineCallback Detect objects (bounding boxes & classes) in the image(s) passed as inputs.\n * @param {ImagePipelineInputs} images The input images.\n * @param {string[]} candidate_labels What the model should recognize in the image.\n * @param {ZeroShotObjectDetectionPipelineOptions} [options] The options to use for zero-shot object detection.\n * @returns {Promise<ZeroShotObjectDetectionOutput[]|ZeroShotObjectDetectionOutput[][]>} An array of objects containing the predicted labels\x2C scores\x2C and bounding boxes.\n * \n * @typedef {TextImagePipelineConstructorArgs & ZeroShotObjectDetectionPipelineCallback & Disposable} ZeroShotObjectDetectionPipelineType\n */\n\n/**\n * Zero-shot object detection pipeline. This pipeline predicts bounding boxes of\n * objects when you provide an image and a set of `candidate_labels`.\n * \n * **Example:** Zero-shot object detection w/ `Xenova/owlvit-base-patch32`.\n * ```javascript\n * const detector = await pipeline('zero-shot-object-detection'\x2C 'Xenova/owlvit-base-patch32');\n * const url = 'https://huggingface.co/datasets/Xenova/transformers.js-docs/resolve/main/astronaut.png';\n * const candidate_labels = ['human face'\x2C 'rocket'\x2C 'helmet'\x2C 'american flag'];\n * const output = await detector(url\x2C candidate_labels);\n * // [\n * //   {\n * //     score: 0.24392342567443848\x2C\n * //     label: 'human face'\x2C\n * //     box: { xmin: 180\x2C ymin: 67\x2C xmax: 274\x2C ymax: 175 }\n * //   }\x2C\n * //   {\n * //     score: 0.15129457414150238\x2C\n * //     label: 'american flag'\x2C\n * //     box: { xmin: 0\x2C ymin: 4\x2C xmax: 106\x2C ymax: 513 }\n * //   }\x2C\n * //   {\n * //     score: 0.13649864494800568\x2C\n * //     label: 'helmet'\x2C\n * //     box: { xmin: 277\x2C ymin: 337\x2C xmax: 511\x2C ymax: 511 }\n * //   }\x2C\n * //   {\n * //     score: 0.10262022167444229\x2C\n * //     label: 'rocket'\x2C\n * //     box: { xmin: 352\x2C ymin: -1\x2C xmax: 463\x2C ymax: 287 }\n * //   }\n * // ]\n * ```\n * \n * **Example:** Zero-shot object detection w/ `Xenova/owlvit-base-patch32` (returning top 4 matches and setting a threshold).\n * ```javascript\n * const detector = await pipeline('zero-shot-object-detection'\x2C 'Xenova/owlvit-base-patch32');\n * const url = 'https://huggingface.co/datasets/Xenova/transformers.js-docs/resolve/main/beach.png';\n * const candidate_labels = ['hat'\x2C 'book'\x2C 'sunglasses'\x2C 'camera'];\n * const output = await detector(url\x2C candidate_labels\x2C { topk: 4\x2C threshold: 0.05 });\n * // [\n * //   {\n * //     score: 0.1606510728597641\x2C\n * //     label: 'sunglasses'\x2C\n * //     box: { xmin: 347\x2C ymin: 229\x2C xmax: 429\x2C ymax: 264 }\n * //   }\x2C\n * //   {\n * //     score: 0.08935828506946564\x2C\n * //     label: 'hat'\x2C\n * //     box: { xmin: 38\x2C ymin: 174\x2C xmax: 258\x2C ymax: 364 }\n * //   }\x2C\n * //   {\n * //     score: 0.08530698716640472\x2C\n * //     label: 'camera'\x2C\n * //     box: { xmin: 187\x2C ymin: 350\x2C xmax: 260\x2C ymax: 411 }\n * //   }\x2C\n * //   {\n * //     score: 0.08349756896495819\x2C\n * //     label: 'book'\x2C\n * //     box: { xmin: 261\x2C ymin: 280\x2C xmax: 494\x2C ymax: 425 }\n * //   }\n * // ]\n * ```\n */\nexport class ZeroShotObjectDetectionPipeline extends (/** @type {new (options: TextImagePipelineConstructorArgs) => ZeroShotObjectDetectionPipelineType} */ (Pipeline)) {\n\n    /**\n     * Create a new ZeroShotObjectDetectionPipeline.\n     * @param {TextImagePipelineConstructorArgs} options An object used to instantiate the pipeline.\n     */\n    constructor(options) {\n        super(options);\n    }\n\n    /** @type {ZeroShotObjectDetectionPipelineCallback} */\n    async _call(images\x2C candidate_labels\x2C {\n        threshold = 0.1\x2C\n        topk = null\x2C\n        percentage = false\x2C\n    } = {}) {\n\n        const isBatched = Array.isArray(images);\n        const preparedImages = await prepareImages(images);\n\n        // Run tokenization\n        const text_inputs = this.tokenizer(candidate_labels\x2C {\n            padding: true\x2C\n            truncation: true\x2C\n        });\n\n        // Run processor\n        const model_inputs = await this.processor(preparedImages);\n\n        // Since non-maximum suppression is performed for exporting\x2C we need to\n        // process each image separately. For more information\x2C see:\n        // https://github.com/huggingface/optimum/blob/e3b7efb1257c011db907ef40ab340e795cc5684c/optimum/exporters/onnx/model_configs.py#L1028-L1032\n        const toReturn = [];\n        for (let i = 0; i < preparedImages.length; ++i) {\n            const image = preparedImages[i];\n            const imageSize = percentage ? null : [[image.height\x2C image.width]];\n            const pixel_values = model_inputs.pixel_values[i].unsqueeze_(0);\n\n            // Run model with both text and pixel inputs\n            const output = await this.model({ ...text_inputs\x2C pixel_values });\n\n            // @ts-ignore\n            const processed = this.processor.feature_extractor.post_process_object_detection(output\x2C threshold\x2C imageSize\x2C true)[0];\n            let result = processed.boxes.map((box\x2C i) => ({\n                score: processed.scores[i]\x2C\n                label: candidate_labels[processed.classes[i]]\x2C\n                box: get_bounding_box(box\x2C !percentage)\x2C\n            })).sort((a\x2C b) => b.score - a.score);\n            if (topk !== null) {\n                result = result.slice(0\x2C topk);\n            }\n            toReturn.push(result)\n        }\n\n        return isBatched ? toReturn : toReturn[0];\n    }\n}\n\n/**\n * @typedef {Object} DocumentQuestionAnsweringSingle\n * @property {string} answer The generated text.\n * @typedef {DocumentQuestionAnsweringSingle[]} DocumentQuestionAnsweringOutput\n * \n * @callback DocumentQuestionAnsweringPipelineCallback Answer the question given as input by using the document.\n * @param {ImageInput} image The image of the document to use.\n * @param {string} question A question to ask of the document.\n * @param {import('./utils/generation.js').GenerationConfigType} [options] Additional keyword arguments to pass along to the generate method of the model.\n * @returns {Promise<DocumentQuestionAnsweringOutput|DocumentQuestionAnsweringOutput[]>} An object (or array of objects) containing the answer(s).\n * \n * @typedef {TextImagePipelineConstructorArgs & DocumentQuestionAnsweringPipelineCallback & Disposable} DocumentQuestionAnsweringPipelineType\n */\n\n/**\n * Document Question Answering pipeline using any `AutoModelForDocumentQuestionAnswering`.\n * The inputs/outputs are similar to the (extractive) question answering pipeline; however\x2C\n * the pipeline takes an image (and optional OCR'd words/boxes) as input instead of text context.\n * \n * **Example:** Answer questions about a document with `Xenova/donut-base-finetuned-docvqa`.\n * ```javascript\n * const qa_pipeline = await pipeline('document-question-answering'\x2C 'Xenova/donut-base-finetuned-docvqa');\n * const image = 'https://huggingface.co/datasets/Xenova/transformers.js-docs/resolve/main/invoice.png';\n * const question = 'What is the invoice number?';\n * const output = await qa_pipeline(image\x2C question);\n * // [{ answer: 'us-001' }]\n * ```\n */\nexport class DocumentQuestionAnsweringPipeline extends (/** @type {new (options: TextImagePipelineConstructorArgs) => DocumentQuestionAnsweringPipelineType} */ (Pipeline)) {\n\n    /**\n     * Create a new DocumentQuestionAnsweringPipeline.\n     * @param {TextImagePipelineConstructorArgs} options An object used to instantiate the pipeline.\n     */\n    constructor(options) {\n        super(options);\n    }\n\n    /** @type {DocumentQuestionAnsweringPipelineCallback} */\n    async _call(image\x2C question\x2C generate_kwargs = {}) {\n\n        // NOTE: For now\x2C we only support a batch size of 1\n\n        // Preprocess image\n        const preparedImage = (await prepareImages(image))[0];\n        const { pixel_values } = await this.processor(preparedImage);\n\n        // Run tokenization\n        const task_prompt = `<s_docvqa><s_question>${question}</s_question><s_answer>`;\n        const decoder_input_ids = this.tokenizer(task_prompt\x2C {\n            add_special_tokens: false\x2C\n            padding: true\x2C\n            truncation: true\x2C\n        }).input_ids;\n\n        // Run model\n        const output = await this.model.generate(\n            pixel_values\x2C\n            {\n                ...generate_kwargs\x2C\n                decoder_input_ids\x2C\n                max_length: this.model.config.decoder.max_position_embeddings\x2C\n            }\n        );\n\n        // Decode output\n        const decoded = this.tokenizer.batch_decode(output)[0];\n\n        // Parse answer\n        const match = decoded.match(/<s_answer>(.*?)<\\/s_answer>/);\n        let answer = null;\n        if (match && match.length >= 2) {\n            answer = match[1].trim();\n        }\n        return [{ answer }];\n    }\n}\n\n\n/**\n * @typedef {Object} VocoderOptions\n * @property {PreTrainedModel} [vocoder] The vocoder used by the pipeline (if the model uses one). If not provided\x2C use the default HifiGan vocoder.\n * @typedef {TextAudioPipelineConstructorArgs & VocoderOptions} TextToAudioPipelineConstructorArgs\n */\n\n/**\n * @typedef {Object} TextToAudioOutput\n * @property {Float32Array} audio The generated audio waveform.\n * @property {number} sampling_rate The sampling rate of the generated audio waveform.\n * \n * @typedef {Object} TextToAudioPipelineOptions Parameters specific to text-to-audio pipelines.\n * @property {Tensor|Float32Array|string|URL} [speaker_embeddings=null] The speaker embeddings (if the model requires it).\n * \n * @callback TextToAudioPipelineCallback Generates speech/audio from the inputs.\n * @param {string|string[]} texts The text(s) to generate.\n * @param {TextToAudioPipelineOptions} options Parameters passed to the model generation/forward method.\n * @returns {Promise<TextToAudioOutput>} An object containing the generated audio and sampling rate.\n * \n * @typedef {TextToAudioPipelineConstructorArgs & TextToAudioPipelineCallback & Disposable} TextToAudioPipelineType\n */\n\n/**\n * Text-to-audio generation pipeline using any `AutoModelForTextToWaveform` or `AutoModelForTextToSpectrogram`.\n * This pipeline generates an audio file from an input text and optional other conditional inputs.\n * \n * **Example:** Generate audio from text with `Xenova/speecht5_tts`.\n * ```javascript\n * const synthesizer = await pipeline('text-to-speech'\x2C 'Xenova/speecht5_tts'\x2C { quantized: false });\n * const speaker_embeddings = 'https://huggingface.co/datasets/Xenova/transformers.js-docs/resolve/main/speaker_embeddings.bin';\n * const out = await synthesizer('Hello\x2C my dog is cute'\x2C { speaker_embeddings });\n * // {\n * //   audio: Float32Array(26112) [-0.00005657337896991521\x2C 0.00020583874720614403\x2C ...]\x2C\n * //   sampling_rate: 16000\n * // }\n * ```\n * \n * You can then save the audio to a .wav file with the `wavefile` package:\n * ```javascript\n * import wavefile from 'wavefile';\n * import fs from 'fs';\n * \n * const wav = new wavefile.WaveFile();\n * wav.fromScratch(1\x2C out.sampling_rate\x2C '32f'\x2C out.audio);\n * fs.writeFileSync('out.wav'\x2C wav.toBuffer());\n * ```\n * \n * **Example:** Multilingual speech generation with `Xenova/mms-tts-fra`. See [here](https://huggingface.co/models?pipeline_tag=text-to-speech&other=vits&sort=trending) for the full list of available languages (1107).\n * ```javascript\n * const synthesizer = await pipeline('text-to-speech'\x2C 'Xenova/mms-tts-fra');\n * const out = await synthesizer('Bonjour');\n * // {\n * //   audio: Float32Array(23808) [-0.00037693005288019776\x2C 0.0003325853613205254\x2C ...]\x2C\n * //   sampling_rate: 16000\n * // }\n * ```\n */\nexport class TextToAudioPipeline extends (/** @type {new (options: TextToAudioPipelineConstructorArgs) => TextToAudioPipelineType} */ (Pipeline)) {\n    DEFAULT_VOCODER_ID = "Xenova/speecht5_hifigan"\n\n    /**\n     * Create a new TextToAudioPipeline.\n     * @param {TextToAudioPipelineConstructorArgs} options An object used to instantiate the pipeline.\n     */\n    constructor(options) {\n        super(options);\n\n        // TODO: Find a better way for `pipeline` to set the default vocoder\n        this.vocoder = options.vocoder ?? null;\n    }\n\n\n    /** @type {TextToAudioPipelineCallback} */\n    async _call(text_inputs\x2C {\n        speaker_embeddings = null\x2C\n    } = {}) {\n\n        // If this.processor is not set\x2C we are using a `AutoModelForTextToWaveform` model\n        if (this.processor) {\n            return this._call_text_to_spectrogram(text_inputs\x2C { speaker_embeddings });\n        } else {\n            return this._call_text_to_waveform(text_inputs);\n        }\n    }\n\n    async _call_text_to_waveform(text_inputs) {\n\n        // Run tokenization\n        const inputs = this.tokenizer(text_inputs\x2C {\n            padding: true\x2C\n            truncation: true\x2C\n        });\n\n        // Generate waveform\n        const { waveform } = await this.model(inputs);\n\n        const sampling_rate = this.model.config.sampling_rate;\n        return {\n            audio: waveform.data\x2C\n            sampling_rate\x2C\n        }\n    }\n\n    async _call_text_to_spectrogram(text_inputs\x2C { speaker_embeddings }) {\n\n        // Load vocoder\x2C if not provided\n        if (!this.vocoder) {\n            console.log('No vocoder specified\x2C using default HifiGan vocoder.');\n            this.vocoder = await AutoModel.from_pretrained(this.DEFAULT_VOCODER_ID\x2C { quantized: false });\n        }\n\n        // Load speaker embeddings as Float32Array from path/URL\n        if (typeof speaker_embeddings === 'string' || speaker_embeddings instanceof URL) {\n            // Load from URL with fetch\n            speaker_embeddings = new Float32Array(\n                await (await fetch(speaker_embeddings)).arrayBuffer()\n            );\n        }\n\n        if (speaker_embeddings instanceof Float32Array) {\n            speaker_embeddings = new Tensor(\n                'float32'\x2C\n                speaker_embeddings\x2C\n                [1\x2C speaker_embeddings.length]\n            )\n        } else if (!(speaker_embeddings instanceof Tensor)) {\n            throw new Error("Speaker embeddings must be a `Tensor`\x2C `Float32Array`\x2C `string`\x2C or `URL`.")\n        }\n\n        // Run tokenization\n        const { input_ids } = this.tokenizer(text_inputs\x2C {\n            padding: true\x2C\n            truncation: true\x2C\n        });\n\n        // NOTE: At this point\x2C we are guaranteed that `speaker_embeddings` is a `Tensor`\n        // @ts-ignore\n        const { waveform } = await this.model.generate_speech(input_ids\x2C speaker_embeddings\x2C { vocoder: this.vocoder });\n\n        const sampling_rate = this.processor.feature_extractor.config.sampling_rate;\n        return {\n            audio: waveform.data\x2C\n            sampling_rate\x2C\n        }\n    }\n}\n\n/**\n * @callback ImageToImagePipelineCallback Transform the image(s) passed as inputs.\n * @param {ImagePipelineInputs} images The images to transform.\n * @returns {Promise<RawImage|RawImage[]>} The transformed image or list of images.\n * \n * @typedef {ImagePipelineConstructorArgs & ImageToImagePipelineCallback & Disposable} ImageToImagePipelineType\n */\n\n/**\n * Image to Image pipeline using any `AutoModelForImageToImage`. This pipeline generates an image based on a previous image input.\n * \n * **Example:** Super-resolution w/ `Xenova/swin2SR-classical-sr-x2-64`\n * ```javascript\n * const upscaler = await pipeline('image-to-image'\x2C 'Xenova/swin2SR-classical-sr-x2-64');\n * const url = 'https://huggingface.co/datasets/Xenova/transformers.js-docs/resolve/main/butterfly.jpg';\n * const output = await upscaler(url);\n * // RawImage {\n * //   data: Uint8Array(786432) [ 41\x2C 31\x2C 24\x2C  43\x2C ... ]\x2C\n * //   width: 512\x2C\n * //   height: 512\x2C\n * //   channels: 3\n * // }\n * ```\n */\nexport class ImageToImagePipeline extends (/** @type {new (options: ImagePipelineConstructorArgs) => ImageToImagePipelineType} */ (Pipeline)) {\n    /**\n     * Create a new ImageToImagePipeline.\n     * @param {ImagePipelineConstructorArgs} options An object used to instantiate the pipeline.\n     */\n    constructor(options) {\n        super(options);\n    }\n\n    /** @type {ImageToImagePipelineCallback} */\n    async _call(images) {\n\n        const preparedImages = await prepareImages(images);\n        const inputs = await this.processor(preparedImages);\n        const outputs = await this.model(inputs);\n\n        /** @type {RawImage[]} */\n        const toReturn = [];\n        for (const batch of outputs.reconstruction) {\n            const output = batch.squeeze().clamp_(0\x2C 1).mul_(255).round_().to('uint8');\n            toReturn.push(RawImage.fromTensor(output));\n        }\n\n        return toReturn.length > 1 ? toReturn : toReturn[0];\n    }\n}\n\n/**\n * @typedef {Object} DepthEstimationPipelineOutput\n * @property {Tensor} predicted_depth The raw depth map predicted by the model.\n * @property {RawImage} depth The processed depth map as an image (with the same size as the input image).\n * \n * @callback DepthEstimationPipelineCallback Predicts the depth for the image(s) passed as inputs.\n * @param {ImagePipelineInputs} images The images to compute depth for.\n * @returns {Promise<DepthEstimationPipelineOutput|DepthEstimationPipelineOutput[]>} An image or a list of images containing result(s).\n * \n * @typedef {ImagePipelineConstructorArgs & DepthEstimationPipelineCallback & Disposable} DepthEstimationPipelineType\n */\n\n/**\n * Depth estimation pipeline using any `AutoModelForDepthEstimation`. This pipeline predicts the depth of an image.\n * \n * **Example:** Depth estimation w/ `Xenova/dpt-hybrid-midas`\n * ```javascript\n * const depth_estimator = await pipeline('depth-estimation'\x2C 'Xenova/dpt-hybrid-midas');\n * const url = 'https://huggingface.co/datasets/Xenova/transformers.js-docs/resolve/main/cats.jpg';\n * const out = await depth_estimator(url);\n * // {\n * //   predicted_depth: Tensor {\n * //     dims: [ 384\x2C 384 ]\x2C\n * //     type: 'float32'\x2C\n * //     data: Float32Array(147456) [ 542.859130859375\x2C 545.2833862304688\x2C 546.1649169921875\x2C ... ]\x2C\n * //     size: 147456\n * //   }\x2C\n * //   depth: RawImage {\n * //     data: Uint8Array(307200) [ 86\x2C 86\x2C 86\x2C ... ]\x2C\n * //     width: 640\x2C\n * //     height: 480\x2C\n * //     channels: 1\n * //   }\n * // }\n * ```\n */\nexport class DepthEstimationPipeline extends (/** @type {new (options: ImagePipelineConstructorArgs) => DepthEstimationPipelineType} */ (Pipeline)) {\n    /**\n     * Create a new DepthEstimationPipeline.\n     * @param {ImagePipelineConstructorArgs} options An object used to instantiate the pipeline.\n     */\n    constructor(options) {\n        super(options);\n    }\n\n    /** @type {DepthEstimationPipelineCallback} */\n    async _call(images) {\n\n        const preparedImages = await prepareImages(images);\n\n        const inputs = await this.processor(preparedImages);\n        const { predicted_depth } = await this.model(inputs);\n\n        const toReturn = [];\n        for (let i = 0; i < preparedImages.length; ++i) {\n            const prediction = interpolate(predicted_depth[i]\x2C preparedImages[i].size.reverse()\x2C 'bilinear'\x2C false);\n            const formatted = prediction.mul_(255 / max(prediction.data)[0]).to('uint8');\n            toReturn.push({\n                predicted_depth: predicted_depth[i]\x2C\n                depth: RawImage.fromTensor(formatted)\x2C\n            });\n        }\n\n        return toReturn.length > 1 ? toReturn : toReturn[0];\n    }\n}\n\nconst SUPPORTED_TASKS = Object.freeze({\n    "text-classification": {\n        "tokenizer": AutoTokenizer\x2C\n        "pipeline": TextClassificationPipeline\x2C\n        "model": AutoModelForSequenceClassification\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "distilbert-base-uncased-finetuned-sst-2-english"\x2C\n            "model": "Xenova/distilbert-base-uncased-finetuned-sst-2-english"\x2C\n        }\x2C\n        "type": "text"\x2C\n    }\x2C\n    "token-classification": {\n        "tokenizer": AutoTokenizer\x2C\n        "pipeline": TokenClassificationPipeline\x2C\n        "model": AutoModelForTokenClassification\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "Davlan/bert-base-multilingual-cased-ner-hrl"\x2C\n            "model": "Xenova/bert-base-multilingual-cased-ner-hrl"\x2C\n        }\x2C\n        "type": "text"\x2C\n    }\x2C\n    "question-answering": {\n        "tokenizer": AutoTokenizer\x2C\n        "pipeline": QuestionAnsweringPipeline\x2C\n        "model": AutoModelForQuestionAnswering\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "distilbert-base-cased-distilled-squad"\x2C\n            "model": "Xenova/distilbert-base-cased-distilled-squad"\x2C\n        }\x2C\n        "type": "text"\x2C\n    }\x2C\n\n    "fill-mask": {\n        "tokenizer": AutoTokenizer\x2C\n        "pipeline": FillMaskPipeline\x2C\n        "model": AutoModelForMaskedLM\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "bert-base-uncased"\x2C\n            "model": "Xenova/bert-base-uncased"\x2C\n        }\x2C\n        "type": "text"\x2C\n    }\x2C\n    "summarization": {\n        "tokenizer": AutoTokenizer\x2C\n        "pipeline": SummarizationPipeline\x2C\n        "model": AutoModelForSeq2SeqLM\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "sshleifer/distilbart-cnn-6-6"\x2C\n            "model": "Xenova/distilbart-cnn-6-6"\x2C\n        }\x2C\n        "type": "text"\x2C\n    }\x2C\n    "translation": {\n        "tokenizer": AutoTokenizer\x2C\n        "pipeline": TranslationPipeline\x2C\n        "model": AutoModelForSeq2SeqLM\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "t5-small"\x2C\n            "model": "Xenova/t5-small"\x2C\n        }\x2C\n        "type": "text"\x2C\n    }\x2C\n    "text2text-generation": {\n        "tokenizer": AutoTokenizer\x2C\n        "pipeline": Text2TextGenerationPipeline\x2C\n        "model": AutoModelForSeq2SeqLM\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "google/flan-t5-small"\x2C\n            "model": "Xenova/flan-t5-small"\x2C\n        }\x2C\n        "type": "text"\x2C\n    }\x2C\n    "text-generation": {\n        "tokenizer": AutoTokenizer\x2C\n        "pipeline": TextGenerationPipeline\x2C\n        "model": AutoModelForCausalLM\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "gpt2"\x2C\n            "model": "Xenova/gpt2"\x2C\n        }\x2C\n        "type": "text"\x2C\n    }\x2C\n    "zero-shot-classification": {\n        "tokenizer": AutoTokenizer\x2C\n        "pipeline": ZeroShotClassificationPipeline\x2C\n        "model": AutoModelForSequenceClassification\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "typeform/distilbert-base-uncased-mnli"\x2C\n            "model": "Xenova/distilbert-base-uncased-mnli"\x2C\n        }\x2C\n        "type": "text"\x2C\n    }\x2C\n    "audio-classification": {\n        "pipeline": AudioClassificationPipeline\x2C\n        "model": AutoModelForAudioClassification\x2C\n        "processor": AutoProcessor\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "superb/wav2vec2-base-superb-ks"\x2C\n            "model": "Xenova/wav2vec2-base-superb-ks"\x2C\n        }\x2C\n        "type": "audio"\x2C\n    }\x2C\n    "zero-shot-audio-classification": {\n        "tokenizer": AutoTokenizer\x2C\n        "pipeline": ZeroShotAudioClassificationPipeline\x2C\n        "model": AutoModel\x2C\n        "processor": AutoProcessor\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "laion/clap-htsat-fused"\x2C\n            "model": "Xenova/clap-htsat-unfused"\x2C\n        }\x2C\n        "type": "multimodal"\x2C\n    }\x2C\n    "automatic-speech-recognition": {\n        "tokenizer": AutoTokenizer\x2C\n        "pipeline": AutomaticSpeechRecognitionPipeline\x2C\n        "model": [AutoModelForSpeechSeq2Seq\x2C AutoModelForCTC]\x2C\n        "processor": AutoProcessor\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "openai/whisper-tiny.en"\x2C\n            "model": "Xenova/whisper-tiny.en"\x2C\n        }\x2C\n        "type": "multimodal"\x2C\n    }\x2C\n    "text-to-audio": {\n        "tokenizer": AutoTokenizer\x2C\n        "pipeline": TextToAudioPipeline\x2C\n        "model": [AutoModelForTextToWaveform\x2C AutoModelForTextToSpectrogram]\x2C\n        "processor": [AutoProcessor\x2C /* Some don't use a processor */ null]\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "microsoft/speecht5_tts"\x2C\n            "model": "Xenova/speecht5_tts"\x2C\n        }\x2C\n        "type": "text"\x2C\n    }\x2C\n    "image-to-text": {\n        "tokenizer": AutoTokenizer\x2C\n        "pipeline": ImageToTextPipeline\x2C\n        "model": AutoModelForVision2Seq\x2C\n        "processor": AutoProcessor\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "nlpconnect/vit-gpt2-image-captioning"\x2C\n            "model": "Xenova/vit-gpt2-image-captioning"\x2C\n        }\x2C\n        "type": "multimodal"\x2C\n    }\x2C\n\n    "image-classification": {\n        // no tokenizer\n        "pipeline": ImageClassificationPipeline\x2C\n        "model": AutoModelForImageClassification\x2C\n        "processor": AutoProcessor\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "google/vit-base-patch16-224"\x2C\n            "model": "Xenova/vit-base-patch16-224"\x2C\n        }\x2C\n        "type": "multimodal"\x2C\n    }\x2C\n\n    "image-segmentation": {\n        // no tokenizer\n        "pipeline": ImageSegmentationPipeline\x2C\n        "model": [AutoModelForImageSegmentation\x2C AutoModelForSemanticSegmentation]\x2C\n        "processor": AutoProcessor\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "facebook/detr-resnet-50-panoptic"\x2C\n            "model": "Xenova/detr-resnet-50-panoptic"\x2C\n        }\x2C\n        "type": "multimodal"\x2C\n    }\x2C\n\n    "zero-shot-image-classification": {\n        "tokenizer": AutoTokenizer\x2C\n        "pipeline": ZeroShotImageClassificationPipeline\x2C\n        "model": AutoModel\x2C\n        "processor": AutoProcessor\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "openai/clip-vit-base-patch32"\x2C\n            "model": "Xenova/clip-vit-base-patch32"\x2C\n        }\x2C\n        "type": "multimodal"\x2C\n    }\x2C\n\n    "object-detection": {\n        // no tokenizer\n        "pipeline": ObjectDetectionPipeline\x2C\n        "model": AutoModelForObjectDetection\x2C\n        "processor": AutoProcessor\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "facebook/detr-resnet-50"\x2C\n            "model": "Xenova/detr-resnet-50"\x2C\n        }\x2C\n        "type": "multimodal"\x2C\n    }\x2C\n    "zero-shot-object-detection": {\n        "tokenizer": AutoTokenizer\x2C\n        "pipeline": ZeroShotObjectDetectionPipeline\x2C\n        "model": AutoModelForZeroShotObjectDetection\x2C\n        "processor": AutoProcessor\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "google/owlvit-base-patch32"\x2C\n            "model": "Xenova/owlvit-base-patch32"\x2C\n        }\x2C\n        "type": "multimodal"\x2C\n    }\x2C\n    "document-question-answering": {\n        "tokenizer": AutoTokenizer\x2C\n        "pipeline": DocumentQuestionAnsweringPipeline\x2C\n        "model": AutoModelForDocumentQuestionAnswering\x2C\n        "processor": AutoProcessor\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "naver-clova-ix/donut-base-finetuned-docvqa"\x2C\n            "model": "Xenova/donut-base-finetuned-docvqa"\x2C\n        }\x2C\n        "type": "multimodal"\x2C\n    }\x2C\n    "image-to-image": {\n        // no tokenizer\n        "pipeline": ImageToImagePipeline\x2C\n        "model": AutoModelForImageToImage\x2C\n        "processor": AutoProcessor\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "caidas/swin2SR-classical-sr-x2-64"\x2C\n            "model": "Xenova/swin2SR-classical-sr-x2-64"\x2C\n        }\x2C\n        "type": "image"\x2C\n    }\x2C\n    "depth-estimation": {\n        // no tokenizer\n        "pipeline": DepthEstimationPipeline\x2C\n        "model": AutoModelForDepthEstimation\x2C\n        "processor": AutoProcessor\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "Intel/dpt-large"\x2C\n            "model": "Xenova/dpt-large"\x2C\n        }\x2C\n        "type": "image"\x2C\n    }\x2C\n\n    // This task serves as a useful interface for dealing with sentence-transformers (https://huggingface.co/sentence-transformers).\n    "feature-extraction": {\n        "tokenizer": AutoTokenizer\x2C\n        "pipeline": FeatureExtractionPipeline\x2C\n        "model": AutoModel\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "sentence-transformers/all-MiniLM-L6-v2"\x2C\n            "model": "Xenova/all-MiniLM-L6-v2"\x2C\n        }\x2C\n        "type": "text"\x2C\n    }\x2C\n    "image-feature-extraction": {\n        "processor": AutoProcessor\x2C\n        "pipeline": ImageFeatureExtractionPipeline\x2C\n        "model": [AutoModelForImageFeatureExtraction\x2C AutoModel]\x2C\n        "default": {\n            // TODO: replace with original\n            // "model": "google/vit-base-patch16-224"\x2C\n            "model": "Xenova/vit-base-patch16-224-in21k"\x2C\n        }\x2C\n        "type": "image"\x2C\n    }\x2C\n})\n\n\n// TODO: Add types for TASK_ALIASES\nconst TASK_ALIASES = Object.freeze({\n    "sentiment-analysis": "text-classification"\x2C\n    "ner": "token-classification"\x2C\n    // "vqa": "visual-question-answering"\x2C // TODO: Add\n    "asr": "automatic-speech-recognition"\x2C\n    "text-to-speech": "text-to-audio"\x2C\n\n    // Add for backwards compatibility\n    "embeddings": "feature-extraction"\x2C\n});\n\n/**\n * @typedef {keyof typeof SUPPORTED_TASKS} TaskType\n * @typedef {keyof typeof TASK_ALIASES} AliasType\n * @typedef {TaskType | AliasType} PipelineType All possible pipeline types.\n * @typedef {{[K in TaskType]: InstanceType<typeof SUPPORTED_TASKS[K]["pipeline"]>}} SupportedTasks A mapping of pipeline names to their corresponding pipeline classes.\n * @typedef {{[K in AliasType]: InstanceType<typeof SUPPORTED_TASKS[TASK_ALIASES[K]]["pipeline"]>}} AliasTasks A mapping from pipeline aliases to their corresponding pipeline classes.\n * @typedef {SupportedTasks & AliasTasks} AllTasks A mapping from all pipeline names and aliases to their corresponding pipeline classes.\n */\n\n/**\n * Utility factory method to build a `Pipeline` object.\n * \n * @template {PipelineType} T The type of pipeline to return.\n * @param {T} task The task defining which pipeline will be returned. Currently accepted tasks are:\n *  - `"audio-classification"`: will return a `AudioClassificationPipeline`.\n *  - `"automatic-speech-recognition"`: will return a `AutomaticSpeechRecognitionPipeline`.\n *  - `"depth-estimation"`: will return a `DepthEstimationPipeline`.\n *  - `"document-question-answering"`: will return a `DocumentQuestionAnsweringPipeline`.\n *  - `"feature-extraction"`: will return a `FeatureExtractionPipeline`.\n *  - `"fill-mask"`: will return a `FillMaskPipeline`.\n *  - `"image-classification"`: will return a `ImageClassificationPipeline`.\n *  - `"image-segmentation"`: will return a `ImageSegmentationPipeline`.\n *  - `"image-to-text"`: will return a `ImageToTextPipeline`.\n *  - `"object-detection"`: will return a `ObjectDetectionPipeline`.\n *  - `"question-answering"`: will return a `QuestionAnsweringPipeline`.\n *  - `"summarization"`: will return a `SummarizationPipeline`.\n *  - `"text2text-generation"`: will return a `Text2TextGenerationPipeline`.\n *  - `"text-classification"` (alias "sentiment-analysis" available): will return a `TextClassificationPipeline`.\n *  - `"text-generation"`: will return a `TextGenerationPipeline`.\n *  - `"token-classification"` (alias "ner" available): will return a `TokenClassificationPipeline`.\n *  - `"translation"`: will return a `TranslationPipeline`.\n *  - `"translation_xx_to_yy"`: will return a `TranslationPipeline`.\n *  - `"zero-shot-classification"`: will return a `ZeroShotClassificationPipeline`.\n *  - `"zero-shot-audio-classification"`: will return a `ZeroShotAudioClassificationPipeline`.\n *  - `"zero-shot-image-classification"`: will return a `ZeroShotImageClassificationPipeline`.\n *  - `"zero-shot-object-detection"`: will return a `ZeroShotObjectDetectionPipeline`.\n * @param {string} [model=null] The name of the pre-trained model to use. If not specified\x2C the default model for the task will be used.\n * @param {import('./utils/hub.js').PretrainedOptions} [options] Optional parameters for the pipeline.\n * @returns {Promise<AllTasks[T]>} A Pipeline object for the specified task.\n * @throws {Error} If an unsupported pipeline is requested.\n */\nexport async function pipeline(\n    task\x2C\n    model = null\x2C\n    {\n        quantized = true\x2C\n        progress_callback = null\x2C\n        config = null\x2C\n        cache_dir = null\x2C\n        local_files_only = false\x2C\n        revision = 'main'\x2C\n        model_file_name = null\x2C\n    } = {}\n) {\n    // Helper method to construct pipeline\n\n    // Apply aliases\n    // @ts-ignore\n    task = TASK_ALIASES[task] ?? task;\n\n    // Get pipeline info\n    const pipelineInfo = SUPPORTED_TASKS[task.split('_'\x2C 1)[0]];\n    if (!pipelineInfo) {\n        throw Error(`Unsupported pipeline: ${task}. Must be one of [${Object.keys(SUPPORTED_TASKS)}]`)\n    }\n\n    // Use model if specified\x2C otherwise\x2C use default\n    if (!model) {\n        model = pipelineInfo.default.model\n        console.log(`No model specified. Using default model: "${model}".`);\n    }\n\n    const pretrainedOptions = {\n        quantized\x2C\n        progress_callback\x2C\n        config\x2C\n        cache_dir\x2C\n        local_files_only\x2C\n        revision\x2C\n        model_file_name\x2C\n    }\n\n    const classes = new Map([\n        ['tokenizer'\x2C pipelineInfo.tokenizer]\x2C\n        ['model'\x2C pipelineInfo.model]\x2C\n        ['processor'\x2C pipelineInfo.processor]\x2C\n    ]);\n\n    // Load model\x2C tokenizer\x2C and processor (if they exist)\n    const results = await loadItems(classes\x2C model\x2C pretrainedOptions);\n    results.task = task;\n\n    dispatchCallback(progress_callback\x2C {\n        'status': 'ready'\x2C\n        'task': task\x2C\n        'model': model\x2C\n    });\n\n    const pipelineClass = pipelineInfo.pipeline;\n    return new pipelineClass(results);\n}\n\n\n/**\n * Helper function to get applicable model\x2C tokenizer\x2C or processor classes for a given model.\n * @param {Map<string\x2C any>} mapping The mapping of names to classes\x2C arrays of classes\x2C or null.\n * @param {string} model The name of the model to load.\n * @param {import('./utils/hub.js').PretrainedOptions} pretrainedOptions The options to pass to the `from_pretrained` method.\n * @private\n */\nasync function loadItems(mapping\x2C model\x2C pretrainedOptions) {\n\n    const result = Object.create(null);\n\n    /**@type {Promise[]} */\n    const promises = [];\n    for (let [name\x2C cls] of mapping.entries()) {\n        if (!cls) continue;\n\n        /**@type {Promise} */\n        let promise;\n        if (Array.isArray(cls)) {\n            promise = new Promise(async (resolve\x2C reject) => {\n                let e;\n                for (let c of cls) {\n                    if (c === null) {\n                        // If null\x2C we resolve it immediately\x2C meaning the relevant\n                        // class was not found\x2C but it is optional.\n                        resolve(null);\n                        return;\n                    }\n                    try {\n                        resolve(await c.from_pretrained(model\x2C pretrainedOptions));\n                        return;\n                    } catch (err) {\n                        e = err;\n                    }\n                }\n                reject(e);\n            })\n        } else {\n            promise = cls.from_pretrained(model\x2C pretrainedOptions);\n        }\n\n        result[name] = promise;\n        promises.push(promise);\n    }\n\n    // Wait for all promises to resolve (in parallel)\n    await Promise.all(promises);\n\n    // Then assign to result\n    for (let [name\x2C promise] of Object.entries(result)) {\n        result[name] = await promise;\n    }\n\n    return result;\n}

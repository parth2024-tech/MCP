script-source,418,/home/thor/skiils/tools/server/src/tools/get_project_prompt.js,const { logAccess } = require('../utils/logger');\nconst { generateProjectPrompt } = require('../services/project-prompt-generator');\n\nmodule.exports = (deps) => ({\n  name: 'get_project_prompt'\x2C\n  description: 'Reads the .ase-project.json config from the active project directory and returns a structured system prompt to inject before skill loading.'\x2C\n  inputSchema: {\n    type: 'object'\x2C\n    properties: {\n      project_dir: {\n        type: 'string'\x2C\n        description: 'Optional. Absolute path to project root. Defaults to current working directory.'\n      }\n    }\n  }\x2C\n  handler: async (args) => {\n    const promptData = await generateProjectPrompt(args.project_dir || process.cwd());\n    logAccess('mcp-client'\x2C 'get_project_prompt'\x2C 'authorized'\x2C 0\x2C { success: !promptData.error });\n    return promptData;\n  }\n});\n

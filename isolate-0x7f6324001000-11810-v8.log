\n           hexTable[0x80 | ((c >> 6) & 0x3F)] +\n           hexTable[0x80 | (c & 0x3F)];\n  }\n  if (lastPos === 0)\n    return str;\n  if (lastPos < len)\n    return out + StringPrototypeSlice(str\x2C lastPos);\n  return out;\n}\n\nmodule.exports = {\n  encodeStr\x2C\n  hexTable\x2C\n  isHexTable\x2C\n};\n

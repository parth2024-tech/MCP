script-source,424,/home/thor/skiils/tools/server/src/tools/update_project_rules.js,const { logAccess } = require('../utils/logger');\nconst { updateProjectRules } = require('../services/rule-updater');\n\nmodule.exports = (deps) => ({\n  name: 'update_project_rules'\x2C\n  description: 'Dynamically update the project rules (.ase-project.json) in real-time based on user feedback or instruction. Call this immediately when a user provides new coding advice\x2C corrections\x2C or architectural constraints.'\x2C\n  inputSchema: {\n    type: 'object'\x2C\n    properties: {\n      rule_type: {\n        type: 'string'\x2C\n        enum: ['conventions'\x2C 'never_do'\x2C 'preferred_patterns'\x2C 'sprint_focus']\x2C\n        description: 'The category of the rule to update.'\n      }\x2C\n      action: {\n        type: 'string'\x2C\n        enum: ['add'\x2C 'remove']\x2C\n        description: 'Whether to add or remove the rule.'\n      }\x2C\n      content: {\n        type: 'string'\x2C\n        description: 'The precise rule text (e.g. "Never use inline styles").'\n      }\x2C\n      project_dir: {\n        type: 'string'\x2C\n        description: 'Optional. Absolute path to project root. Defaults to current working directory.'\n      }\x2C\n      draft_mode: {\n        type: 'boolean'\x2C\n        description: 'Optional. If true\x2C writes the rule to a rule_proposals.jsonl file for human review instead of applying it immediately. Defaults to true to prevent AI from polluting config.'\x2C\n        default: true\n      }\n    }\x2C\n    required: ['rule_type'\x2C 'action'\x2C 'content']\n  }\x2C\n  handler: async (args) => {\n    const { rule_type\x2C action\x2C content\x2C project_dir\x2C draft_mode } = args;\n    const isDraft = draft_mode !== undefined ? draft_mode : true;\n    const result = await updateProjectRules(rule_type\x2C action\x2C content\x2C project_dir || process.cwd()\x2C isDraft);\n    logAccess('mcp-client'\x2C 'update_project_rules'\x2C 'authorized'\x2C 0\x2C { success: !result.error\x2C draft_mode: isDraft });\n    return result;\n  }\n});\n

script-source,425,/home/thor/skiils/tools/server/src/services/rule-updater.js,const fs = require('fs').promises;\nconst path = require('path');\nconst { logAccess } = require('../utils/logger');\nconst { validateConfig\x2C findProjectConfig } = require('./project-prompt-generator');\n\n/**\n * Dynamically updates the .ase-project.json configuration based on user feedback.\n * \n * @param {string} ruleType - 'conventions'\x2C 'never_do'\x2C 'preferred_patterns'\x2C or 'sprint_focus'\n * @param {string} action - 'add' or 'remove'\n * @param {string} content - The rule text to add/remove\n * @param {string} [projectDir] - Optional project directory path\n * @param {boolean} [draftMode] - If true\x2C writes to rule_proposals.jsonl\n * @returns {object} - Success result or error\n */\nasync function updateProjectRules(ruleType\x2C action\x2C content\x2C projectDir = null\x2C draftMode = true) {\n  const configPath = await findProjectConfig(projectDir || process.cwd());\n\n  if (!configPath) {\n    return { error: 'No .ase-project.json found in the directory tree.' };\n  }\n\n  if (draftMode) {\n    const logPath = path.join(path.dirname(configPath)\x2C 'rule_proposals.jsonl');\n    const proposal = {\n      timestamp: new Date().toISOString()\x2C\n      ruleType\x2C\n      action\x2C\n      content\x2C\n      status: 'pending'\n    };\n    try {\n      await fs.appendFile(logPath\x2C JSON.stringify(proposal) + '\\n'\x2C 'utf8');\n      return { \n        success: true\x2C \n        message: `Successfully wrote proposed rule to ${logPath} for human review.`\x2C \n        path: logPath \n      };\n    } catch (err) {\n      return { error: `Failed to write proposal to ${logPath}: ${err.message}` };\n    }\n  }\n\n  let raw;\n  try {\n    raw = await fs.readFile(configPath\x2C 'utf8');\n  } catch (err) {\n    return { error: `Cannot read ${configPath}: ${err.message}` };\n  }\n\n  let config;\n  try {\n    config = JSON.parse(raw);\n  } catch (err) {\n    return { error: `Invalid JSON in ${configPath}: ${err.message}` };\n  }\n\n  // Ensure arrays exist if not present\n  if (['conventions'\x2C 'never_do'\x2C 'preferred_patterns'].includes(ruleType)) {\n    if (!config[ruleType] || !Array.isArray(config[ruleType])) {\n      config[ruleType] = [];\n    }\n  }\n\n  // Perform the update\n  if (action === 'add') {\n    if (['conventions'\x2C 'never_do'\x2C 'preferred_patterns'].includes(ruleType)) {\n      if (!config[ruleType].includes(content)) {\n        config[ruleType].push(content);\n      } else {\n        return { message: `Rule already exists in ${ruleType}`\x2C path: configPath };\n      }\n    } else if (ruleType === 'sprint_focus') {\n      config[ruleType] = content;\n    } else {\n      return { error: `Unsupported ruleType for 'add': ${ruleType}` };\n    }\n  } else if (action === 'remove') {\n    if (['conventions'\x2C 'never_do'\x2C 'preferred_patterns'].includes(ruleType)) {\n      config[ruleType] = config[ruleType].filter(r => r !== content);\n    } else if (ruleType === 'sprint_focus') {\n      delete config[ruleType];\n    } else {\n      return { error: `Unsupported ruleType for 'remove': ${ruleType}` };\n    }\n  } else {\n    return { error: `Unsupported action: ${action}` };\n  }\n\n  // Validate the new config before saving\n  const validation = validateConfig(config);\n  if (!validation.valid) {\n    return { \n      error: 'Failed schema validation. Change aborted to prevent config corruption.'\x2C \n      details: validation.errors \n    };\n  }\n\n  // Write the changes back\n  try {\n    await fs.writeFile(configPath\x2C JSON.stringify(config\x2C null\x2C 2) + '\\n'\x2C 'utf8');\n    return { \n      success: true\x2C \n      message: `Successfully updated ${ruleType} in .ase-project.json`\x2C \n      path: configPath \n    };\n  } catch (err) {\n    return { error: `Failed to write to ${configPath}: ${err.message}` };\n  }\n}\n\nmodule.exports = { updateProjectRules };\n

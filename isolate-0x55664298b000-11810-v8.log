script-source,349,/home/thor/skiils/tools/server/src/utils/logger.js,/**\n * ASE Structured Logger\n *\n * Leveled\x2C structured JSONL logger with:\n *   - Log levels: DEBUG < INFO < WARN < ERROR\n *   - Request ID propagation via logger.child(reqId)\n *   - Console mirroring at each level\n *   - Backward-compatible logAccess() and warn() exports\n *\n * Every log entry written to disk is a single-line JSON object:\n * {\n *   "timestamp": "2026-05-29T06:00:00.000Z"\x2C\n *   "level": "INFO"\x2C\n *   "tag": "EmbeddingService"\x2C\n *   "message": "Sync complete."\x2C\n *   "req_id": "b1a2c3d4-..."\x2C   // only on child loggers\n *   "duration_ms": 142\x2C          // when provided\n *   "details": {}\n * }\n */\n\nconst fs = require('fs');\nconst path = require('path');\n\nconst LOG_DIR = '/home/thor/.agents/logs';\nconst LOG_FILE = path.join(LOG_DIR\x2C 'skills_audit.log');\n\n// \u2500\u2500 Log levels \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst LEVELS = { DEBUG: 0\x2C INFO: 1\x2C WARN: 2\x2C ERROR: 3 };\nconst MIN_LEVEL = process.env.ASE_LOG_LEVEL\n  ? (LEVELS[process.env.ASE_LOG_LEVEL.toUpperCase()] ?? LEVELS.INFO)\n  : LEVELS.INFO;\n\n// Ensure log directory exists at module load time\ntry {\n  if (!fs.existsSync(LOG_DIR)) {\n    fs.mkdirSync(LOG_DIR\x2C { recursive: true });\n  }\n} catch (err) {\n  process.stderr.write(`ASE Logger: Failed to create log directory: ${err.message}\\n`);\n}\n\n// \u2500\u2500 Core emit function \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction emit(level\x2C tag\x2C message\x2C details = {}\x2C reqId = null\x2C durationMs = null) {\n  const levelNum = LEVELS[level] ?? LEVELS.INFO;\n  if (levelNum < MIN_LEVEL) return;\n\n  const entry = {\n    timestamp: new Date().toISOString()\x2C\n    level\x2C\n    tag: tag || 'ase'\x2C\n    message: String(message)\n  };\n\n  if (reqId) entry.req_id = reqId;\n  if (durationMs !== null) entry.duration_ms = durationMs;\n  if (details && Object.keys(details).length > 0) entry.details = details;\n\n  // Mirror to console with clean prefix\n  const prefix = `[${level}][${tag}]`;\n  const suffix = reqId ? ` (req:${reqId.slice(0\x2C 8)})` : '';\n  const consoleMsg = `${prefix}${suffix} ${message}`;\n\n  switch (level) {\n    case 'DEBUG': process.stderr.write(consoleMsg + '\\n'); break;\n    case 'INFO':  process.stderr.write(consoleMsg + '\\n'); break;\n    case 'WARN':  process.stderr.write(consoleMsg + '\\n'); break;\n    case 'ERROR': process.stderr.write(consoleMsg + '\\n'); break;\n  }\n\n  // Write structured JSONL to disk\n  try {\n    fs.appendFileSync(LOG_FILE\x2C JSON.stringify(entry) + '\\n'\x2C 'utf8');\n  } catch (_) {\n    // Logger must never crash the server\n  }\n}\n\n// \u2500\u2500 Logger factory \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Creates a base logger with optional request ID binding.\n * @param {string|null} reqId - Optional request correlation ID\n */\nfunction createLogger(reqId = null) {\n  return {\n    debug: (tag\x2C msg\x2C details) => emit('DEBUG'\x2C tag\x2C msg\x2C details\x2C reqId)\x2C\n    info:  (tag\x2C msg\x2C details) => emit('INFO'\x2C  tag\x2C msg\x2C details\x2C reqId)\x2C\n    warn:  (tag\x2C msg\x2C details) => emit('WARN'\x2C  tag\x2C msg\x2C details\x2C reqId)\x2C\n    error: (tag\x2C msg\x2C details) => emit('ERROR'\x2C tag\x2C msg\x2C details\x2C reqId)\x2C\n\n    /** Log a tool call result with accurate timing */\n    toolResult: (toolName\x2C durationMs\x2C success\x2C details) =>\n      emit(success ? 'INFO' : 'ERROR'\x2C 'ToolDispatch'\x2C\n        `${toolName} ${success ? 'succeeded' : 'failed'} in ${durationMs}ms`\x2C\n        details\x2C reqId\x2C durationMs)\x2C\n\n    /** Returns a new logger bound to a specific request ID */\n    child: (childReqId) => createLogger(childReqId)\x2C\n\n    /** Returns the current req_id (for passing to nested calls) */\n    reqId\n  };\n}\n\n// \u2500\u2500 Module-level default logger (no req_id) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst logger = createLogger(null);\n\n// \u2500\u2500 Backward-compatible exports \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Legacy logAccess() \u2014 kept for backward compatibility.\n * Delegates to structured logger with INFO level.\n */\nfunction logAccess(agent\x2C skill\x2C status\x2C durationMs\x2C details = {}) {\n  emit('INFO'\x2C 'Access'\x2C `${skill} [${status}]`\x2C { agent\x2C ...details }\x2C null\x2C durationMs || null);\n}\n\n/**\n * Legacy warn() \u2014 kept for backward compatibility.\n * Delegates to structured logger with WARN level.\n */\nfunction warn(tag\x2C message\x2C details = {}) {\n  emit('WARN'\x2C tag\x2C message\x2C details);\n}\n\nmodule.exports = {\n  logger\x2C\n  createLogger\x2C\n  logAccess\x2C\n  warn\n};\n

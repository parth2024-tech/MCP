script-source,410,/home/thor/skiils/tools/server/src/services/context-budget.js,/**\n * ASE Context Budget Manager v2\n *\n * Three distinct stages:\n *   1. EXTRACT  \u2014 Pull intent signals from the user's prompt\n *   2. SCORE    \u2014 Rank every skill by relevance using TF-IDF-inspired weighting\n *   3. ENFORCE  \u2014 Return only the top N skills within the token budget\n *\n * Design constraints:\n *   - 1\x2C449 skills in the registry \u2014 must be fast (< 200ms)\n *   - Skills have YAML frontmatter with `name`\x2C `description`\x2C optional `category`\n *   - The frontmatter description is the primary matching surface\n *   - Skill file content is secondary (heavier but more precise)\n *   - Hard cap of 3 skills per session\x2C configurable via model-params.json\n */\n\nconst fs = require('fs');\nconst path = require('path');\nconst { logAccess\x2C warn } = require('../utils/logger');\nconst { findMainMdSync } = require('../utils/fs-utils');\n\nconst SKILLS_DIR = path.join(__dirname\x2C '../../');\nconst CONFIG_PATH = path.join(__dirname\x2C '../config/model-params.json');\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Load global constraints from config\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nlet MAX_SKILLS = 3;\nlet TOKEN_WARN = 6000;\nlet TOKEN_HARD_LIMIT = 12000;\n\ntry {\n  const cfg = JSON.parse(fs.readFileSync(CONFIG_PATH\x2C 'utf8'));\n  const gc = cfg.global_constraints || {};\n  MAX_SKILLS = gc.context_budget_max_skills || 3;\n  TOKEN_WARN = gc.context_budget_warn_tokens || 6000;\n  TOKEN_HARD_LIMIT = gc.context_budget_hard_limit_tokens || 12000;\n} catch (err) {\n  warn('ContextBudget'\x2C `Failed to load model-params.json\x2C using defaults: ${err.message}`);\n}\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// STOPWORDS \u2014 high-frequency words that carry zero intent signal.\n// Filtering these dramatically improves scoring precision.\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst STOPWORDS = new Set([\n  'the'\x2C 'a'\x2C 'an'\x2C 'and'\x2C 'or'\x2C 'but'\x2C 'in'\x2C 'on'\x2C 'at'\x2C 'to'\x2C 'for'\x2C\n  'of'\x2C 'with'\x2C 'by'\x2C 'from'\x2C 'as'\x2C 'is'\x2C 'was'\x2C 'are'\x2C 'were'\x2C 'be'\x2C\n  'been'\x2C 'being'\x2C 'have'\x2C 'has'\x2C 'had'\x2C 'do'\x2C 'does'\x2C 'did'\x2C 'will'\x2C\n  'would'\x2C 'could'\x2C 'should'\x2C 'may'\x2C 'might'\x2C 'can'\x2C 'shall'\x2C 'not'\x2C\n  'no'\x2C 'nor'\x2C 'so'\x2C 'yet'\x2C 'both'\x2C 'each'\x2C 'few'\x2C 'more'\x2C 'most'\x2C\n  'other'\x2C 'some'\x2C 'such'\x2C 'than'\x2C 'too'\x2C 'very'\x2C 'just'\x2C 'about'\x2C\n  'also'\x2C 'how'\x2C 'what'\x2C 'when'\x2C 'where'\x2C 'which'\x2C 'who'\x2C 'why'\x2C\n  'this'\x2C 'that'\x2C 'these'\x2C 'those'\x2C 'then'\x2C 'there'\x2C 'here'\x2C\n  'all'\x2C 'any'\x2C 'every'\x2C 'into'\x2C 'through'\x2C 'during'\x2C 'before'\x2C\n  'after'\x2C 'above'\x2C 'below'\x2C 'between'\x2C 'out'\x2C 'off'\x2C 'over'\x2C 'under'\x2C\n  'up'\x2C 'down'\x2C 'again'\x2C 'further'\x2C 'once'\x2C 'only'\x2C 'own'\x2C 'same'\x2C\n  'it'\x2C 'its'\x2C 'my'\x2C 'your'\x2C 'our'\x2C 'his'\x2C 'her'\x2C 'their'\x2C 'we'\x2C\n  'they'\x2C 'me'\x2C 'him'\x2C 'us'\x2C 'them'\x2C 'i'\x2C 'you'\x2C 'he'\x2C 'she'\x2C\n  'want'\x2C 'need'\x2C 'help'\x2C 'please'\x2C 'using'\x2C 'use'\x2C 'make'\x2C 'like'\x2C\n  'get'\x2C 'set'\x2C 'put'\x2C 'let'\x2C 'new'\x2C 'old'\n]);\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// STAGE 1: EXTRACT \u2014 Keyword extraction from user prompt\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Extracts meaningful intent tokens from the user's prompt.\n * Filters stopwords\x2C deduplicates\x2C and returns a weighted token map.\n *\n * @param {string} prompt - Raw user request\n * @returns {Map<string\x2C number>} token \u2192 frequency count\n */\nfunction extractIntentTokens(prompt) {\n  const tokens = prompt\n    .toLowerCase()\n    .replace(/[^a-z0-9\\s\\-_.]/g\x2C ' ')   // keep hyphens\x2C dots\x2C underscores (common in tech terms)\n    .split(/\\s+/)\n    .filter(t => t.length > 1 && !STOPWORDS.has(t));\n\n  // Count frequency \u2014 repeated tokens signal stronger intent\n  const freq = new Map();\n  for (const token of tokens) {\n    freq.set(token\x2C (freq.get(token) || 0) + 1);\n  }\n\n  return freq;\n}\n\n/**\n * Extracts bigrams (2-word phrases) from the prompt.\n * Bigrams like "firebase auth" or "react native" carry much stronger signal\n * than individual words.\n *\n * @param {string} prompt\n * @returns {Set<string>} set of bigram strings\n */\nfunction extractBigrams(prompt) {\n  const words = prompt\n    .toLowerCase()\n    .replace(/[^a-z0-9\\s\\-]/g\x2C ' ')\n    .split(/\\s+/)\n    .filter(t => t.length > 1);\n\n  const bigrams = new Set();\n  for (let i = 0; i < words.length - 1; i++) {\n    if (!STOPWORDS.has(words[i]) || !STOPWORDS.has(words[i + 1])) {\n      bigrams.add(`${words[i]} ${words[i + 1]}`);\n    }\n  }\n  return bigrams;\n}\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// STAGE 2: SCORE \u2014 Relevance scoring per skill\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Parses YAML frontmatter from a skill markdown file.\n * Returns { name\x2C description\x2C category\x2C risk } or null.\n */\nfunction parseFrontmatter(content) {\n  if (!content.startsWith('---')) return null;\n  const endIdx = content.indexOf('---'\x2C 3);\n  if (endIdx === -1) return null;\n\n  const fm = content.substring(3\x2C endIdx);\n  const result = {};\n\n  const nameMatch = fm.match(/^name:\\s*["']?(.+?)["']?\\s*$/m);\n  if (nameMatch) result.name = nameMatch[1].trim();\n\n  const descMatch = fm.match(/^description:\\s*["']?(.+?)["']?\\s*$/m);\n  if (!descMatch) {\n    // Multi-line description\n    const multiMatch = fm.match(/^description:\\s*["']?([\\s\\S]*?)["']?\\s*(?:^[a-z]|\\n---)/m);\n    if (multiMatch) result.description = multiMatch[1].trim().replace(/\\n\\s*/g\x2C ' ');\n  } else {\n    result.description = descMatch[1].trim();\n  }\n\n  const catMatch = fm.match(/^category:\\s*["']?(.+?)["']?\\s*$/m);\n  if (catMatch) result.category = catMatch[1].trim();\n\n  const riskMatch = fm.match(/^risk:\\s*["']?(.+?)["']?\\s*$/m);\n  if (riskMatch) result.risk = riskMatch[1].trim();\n\n  return result;\n}\n\n/**\n * Scores a single skill against the extracted intent signals.\n *\n * Scoring layers (additive):\n *   Layer 1: Folder name match       \u2014 10 pts per token hit (strongest signal)\n *   Layer 2: Frontmatter name match  \u2014 8 pts per token hit\n *   Layer 3: Description match       \u2014 5 pts per token hit (medium signal)\n *   Layer 4: Bigram match in desc    \u2014 12 pts per bigram (multi-word = high precision)\n *   Layer 5: Content body match      \u2014 1 pt per token\x2C capped at 3 per token (weakest\x2C noisiest)\n *   Layer 6: Risk bonus              \u2014 safe/none skills get +2 tiebreaker\n *\n * @param {string} folderName - The skill folder name (e.g. "react-ui-patterns")\n * @param {object} frontmatter - Parsed YAML frontmatter { name\x2C description }\n * @param {string} content - Full file content (for body matching)\n * @param {Map<string\x2C number>} intentTokens - Extracted intent token frequency map\n * @param {Set<string>} bigrams - Extracted bigrams from the prompt\n * @returns {number} relevance score\n */\nfunction scoreSkill(folderName\x2C frontmatter\x2C content\x2C intentTokens\x2C bigrams) {\n  let score = 0;\n\n  // Normalize the folder name: "react-ui-patterns" \u2192 "react ui patterns"\n  const normalizedFolder = folderName.toLowerCase().replace(/[-_]/g\x2C ' ');\n\n  // Layer 1: Folder name token match (10 pts each)\n  for (const [token] of intentTokens) {\n    if (normalizedFolder.includes(token)) {\n      score += 10;\n    }\n  }\n\n  // Layer 2: Frontmatter name match (8 pts each)\n  if (frontmatter && frontmatter.name) {\n    const fmName = frontmatter.name.toLowerCase();\n    for (const [token] of intentTokens) {\n      if (fmName.includes(token)) score += 8;\n    }\n  }\n\n  // Layer 3: Description keyword match (5 pts each)\n  const desc = (frontmatter && frontmatter.description) ? frontmatter.description.toLowerCase() : '';\n  if (desc) {\n    for (const [token] of intentTokens) {\n      if (desc.includes(token)) score += 5;\n    }\n  }\n\n  // Layer 4: Bigram match in description + folder name (12 pts \u2014 highest precision)\n  const descAndName = `${normalizedFolder} ${desc}`;\n  for (const bigram of bigrams) {\n    if (descAndName.includes(bigram)) {\n      score += 12;\n    }\n  }\n\n  // Layer 5: Content body match (1 pt per token\x2C capped at 3 per token)\n  // Only check the first 2000 chars of content body (after frontmatter) to stay fast\n  if (content) {\n    const bodyStart = content.indexOf('---'\x2C 3);\n    const body = bodyStart !== -1\n      ? content.substring(bodyStart + 3\x2C bodyStart + 2003).toLowerCase()\n      : content.substring(0\x2C 2000).toLowerCase();\n\n    for (const [token] of intentTokens) {\n      const re = new RegExp(`\\\\b${escapeRegex(token)}\\\\b`\x2C 'g');\n      const matches = (body.match(re) || []).length;\n      score += Math.min(matches\x2C 3);\n    }\n  }\n\n  // Layer 6: Risk tiebreaker \u2014 safe skills get slight preference\n  if (frontmatter && frontmatter.risk) {\n    if (frontmatter.risk === 'none') score += 2;\n    else if (frontmatter.risk === 'safe') score += 1;\n  }\n\n  return score;\n}\n\nfunction escapeRegex(s) {\n  return s.replace(/[-\\/\\\\^$*+?.()|[\\]{}]/g\x2C '\\\\$&');\n}\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// STAGE 3: ENFORCE \u2014 Budget cap and token accounting\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * selectTopSkills \u2014 The main entry point.\n *\n * Orchestrates the three stages: EXTRACT \u2192 SCORE \u2192 ENFORCE.\n *\n * @param {string[]} candidates - Array of skill folder names to evaluate\n * @param {string} request - The user's prompt text\n * @param {number} maxSkills - Hard cap (defaults to global config value)\n * @returns {{\n *   selected: Array<{name\x2C score\x2C tokenEstimate\x2C description}>\x2C\n *   totalBudgetTokens: number\x2C\n *   budget_status: 'ok' | 'warning' | 'over_limit'\x2C\n *   dropped_count: number\x2C\n *   hard_cap: number\x2C\n *   extraction: { token_count\x2C bigram_count }\n * }}\n */\nfunction selectTopSkills(candidates\x2C request\x2C maxSkills) {\n  const cap = maxSkills || MAX_SKILLS;\n\n  // Stage 1: Extract intent signals\n  const intentTokens = extractIntentTokens(request);\n  const bigrams = extractBigrams(request);\n\n  // Stage 2: Score every candidate\n  const scored = [];\n\n  for (const name of candidates) {\n    const skillPath = path.join(SKILLS_DIR\x2C name);\n\n    // Quick existence check\n    let stat;\n    try { stat = fs.statSync(skillPath); } catch (err) { warn('ContextBudget'\x2C `stat failed for "${name}": ${err.message}`); continue; }\n    if (!stat.isDirectory()) continue;\n\n    const mdFile = findMainMdSync(skillPath);\n    if (!mdFile) continue;\n\n    let content = '';\n    try { content = fs.readFileSync(mdFile\x2C 'utf8'); } catch (err) { warn('ContextBudget'\x2C `readFile failed for "${mdFile}": ${err.message}`); continue; }\n\n    const frontmatter = parseFrontmatter(content);\n    const score = scoreSkill(name\x2C frontmatter\x2C content\x2C intentTokens\x2C bigrams);\n\n    // Only include skills with score > 0 (at least one signal hit)\n    if (score > 0) {\n      const tokenEstimate = Math.ceil(content.length / 4);\n      scored.push({\n        name\x2C\n        score\x2C\n        tokenEstimate\x2C\n        description: (frontmatter && frontmatter.description) || ''\n      });\n    }\n  }\n\n  // Sort descending by relevance score\n  scored.sort((a\x2C b) => b.score - a.score);\n\n  // Stage 3: Enforce budget cap\n  const selected = scored.slice(0\x2C cap);\n  const totalBudgetTokens = selected.reduce((sum\x2C s) => sum + s.tokenEstimate\x2C 0);\n\n  // Determine budget health\n  let budgetStatus = 'ok';\n  if (totalBudgetTokens > TOKEN_HARD_LIMIT) budgetStatus = 'over_limit';\n  else if (totalBudgetTokens > TOKEN_WARN) budgetStatus = 'warning';\n\n  return {\n    selected: selected.map(s => ({\n      name: s.name\x2C\n      score: s.score\x2C\n      tokenEstimate: s.tokenEstimate\x2C\n      description: s.description.slice(0\x2C 120)\n    }))\x2C\n    totalBudgetTokens\x2C\n    budget_status: budgetStatus\x2C\n    dropped_count: Math.max(0\x2C scored.length - cap)\x2C\n    hard_cap: cap\x2C\n    extraction: {\n      token_count: intentTokens.size\x2C\n      bigram_count: bigrams.size\x2C\n      top_tokens: [...intentTokens.entries()]\n        .sort((a\x2C b) => b[1] - a[1])\n        .slice(0\x2C 8)\n        .map(([t\x2C c]) => `${t}(${c})`)\n    }\n  };\n}\n\nmodule.exports = {\n  selectTopSkills\x2C\n  extractIntentTokens\x2C\n  extractBigrams\x2C\n  scoreSkill\x2C\n  parseFrontmatter\n};\n

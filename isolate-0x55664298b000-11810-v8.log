script-source,419,/home/thor/skiils/tools/server/src/tools/get_skill_session_report.js,module.exports = (deps) => ({\n  name: 'get_skill_session_report'\x2C\n  description: 'Returns the current session\\'s skill progression state\x2C showing which skills are active\x2C step status\x2C and time spent.'\x2C\n  inputSchema: {\n    type: 'object'\x2C\n    properties: {}\x2C\n    required: []\n  }\x2C\n  handler: async (args) => {\n    if (!deps.sessionState) {\n      return { error: 'Session state manager is not initialized.' };\n    }\n\n    try {\n      const report = deps.sessionState.getReport();\n      return report;\n    } catch (err) {\n      return { error: `Failed to generate skill session report: ${err.message}` };\n    }\n  }\n});\n

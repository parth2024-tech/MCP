script-source,426,/home/thor/skiils/tools/server/src/tools/validate_output.js,const { logAccess } = require('../utils/logger');\n\nmodule.exports = (deps) => ({\n  name: 'validate_output'\x2C\n  description: 'Runs the automated linter\x2C type checker\x2C and fast test suite for the active project. Streams per-step progress notifications so the AI host can parse results incrementally.'\x2C\n  inputSchema: {\n    type: 'object'\x2C\n    properties: {\n      project_dir: {\n        type: 'string'\x2C\n        description: 'Optional. Absolute path to project root. Defaults to current working directory.'\n      }\x2C\n      timeout_ms: {\n        type: 'number'\x2C\n        description: 'Optional. Timeout in milliseconds per validation step. Defaults to 30000.'\n      }\n    }\n  }\x2C\n\n  /**\n   * Streaming handler: iterates through the async generator and emits\n   * MCP progress notifications for each validation step.\n   *\n   * The `extra` parameter is injected by the server's CallToolRequest handler\n   * and carries `sendNotification` for progress streaming\x2C plus `_meta` for\n   * the progressToken that the client may have supplied.\n   */\n  handler: async (args\x2C extra) => {\n    const { validateStream } = require('../services/streaming-validator');\n    const projectDir = args.project_dir || process.cwd();\n    const timeoutMs = args.timeout_ms || 30000;\n    \n    const chunks = [];\n    let finalSummary = null;\n    let stepIndex = 0;\n\n    try {\n      for await (const chunk of validateStream(projectDir\x2C timeoutMs)) {\n        chunks.push(chunk);\n\n        if (chunk.type === 'summary') {\n          finalSummary = chunk;\n        } else {\n          stepIndex++;\n\n          // Emit MCP progress notification if extra.sendNotification is available\n          if (extra && typeof extra.sendNotification === 'function') {\n            try {\n              const progressToken = extra._meta && extra._meta.progressToken;\n              if (progressToken !== undefined) {\n                await extra.sendNotification({\n                  method: 'notifications/progress'\x2C\n                  params: {\n                    progressToken\x2C\n                    progress: stepIndex\x2C\n                    total: chunk.totalSteps\x2C\n                    message: `[${chunk.status || 'skipped'}] ${chunk.step}`\n                  }\n                });\n              }\n            } catch (notifErr) {\n              // Non-fatal: progress notifications are best-effort\n            }\n          }\n        }\n      }\n\n      const result = {\n        project_type: finalSummary ? finalSummary.project_type : 'unknown'\x2C\n        project_dir: projectDir\x2C\n        passed: finalSummary ? finalSummary.passed : false\x2C\n        critical_failure: finalSummary ? finalSummary.critical_failure : false\x2C\n        results: chunks.filter(c => c.type === 'step_result')\x2C\n        skipped: finalSummary ? finalSummary.skipped : []\x2C\n        summary: finalSummary ? finalSummary.summary : 'Validation did not complete.'\n      };\n\n      logAccess('mcp-client'\x2C 'validate_output'\x2C 'authorized'\x2C 0\x2C { passed: result.passed\x2C project_type: result.project_type });\n      return result;\n\n    } catch (err) {\n      return { error: `Streaming validation failed: ${err.message}` };\n    }\n  }\n});\n

ions\x2C 'options');\n\n  if (callback !== undefined)\n    validateFunction(callback\x2C 'callback');\n\n  const { privateKey\x2C publicKey } = options;\n\n  // TODO(@panva): remove these non-semver-major error code preserving measures\n  // in a semver-major followup\x2C the final state is just preparePublicOrPrivateKey\n  // and preparePrivateKey\n  if (privateKey == null)\n    throw new ERR_INVALID_ARG_VALUE('options.privateKey'\x2C privateKey);\n\n  if (publicKey == null)\n    throw new ERR_INVALID_ARG_VALUE('options.publicKey'\x2C publicKey);\n\n  if (isKeyObject(privateKey)) {\n    const type = getKeyObjectType(privateKey);\n    if (type !== 'private')\n      throw new ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE(type\x2C 'private');\n  }\n\n  if (isKeyObject(publicKey)) {\n    const type = getKeyObjectType(publicKey);\n    if (type !== 'public' && type !== 'private') {\n      throw new ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE(type\x2C\n                                                   'private or public');\n    }\n  }\n\n  if (isKeyObject(privateKey) && isKeyObject(publicKey)) {\n    const privateType = getKeyObjectAsymmetricKeyType(privateKey);\n    const publicType = getKeyObjectAsymmetricKeyType(publicKey);\n    if (privateType !== publicType || !dhEnabledKeyTypes.has(privateType)) {\n      throw new ERR_CRYPTO_INCOMPATIBLE_KEY('key types for Diffie-Hellman'\x2C\n                                            `${privateType} and ${publicType}`);\n    }\n  }\n\n  const {\n    data: pubData\x2C\n    format: pubFormat\x2C\n    type: pubType\x2C\n    passphrase: pubPassphrase\x2C\n    namedCurve: pubNamedCurve\x2C\n  } = preparePublicOrPrivateKey(publicKey\x2C 'options.publicKey');\n\n  const {\n    data: privData\x2C\n    format: privFormat\x2C\n    type: privType\x2C\n    passphrase: privPassphrase\x2C\n    namedCurve: privNamedCurve\x2C\n  } = preparePrivateKey(privateKey\x2C 'options.privateKey');\n\n  const job = new DHBitsJob(\n    callback ? kCryptoJobAsync : kCryptoJobS
#!/usr/bin/env node
/**
 * ase-init — Global CLI Tool for the Antigravity Skills Engine
 * 
 * Usage:
 *   ase-init          → Initialize ASE in the current project directory
 *   ase-init --check  → Check if ASE is already configured
 *   ase-init --update → Regenerate/update the .ase-project.json config
 *   ase-init --validate → Run the output validator on the current project
 *   ase-init --route "your request text" → Get the recommended model+temperature
 *   ase-init --budget "your request text" → Get the top-3 relevant skills
 *   ase-init --compact <transcript.json> → Compact a transcript with fast-jev-compaction
 *   ase-init --worktree <list|create|remove|prune> → Manage isolated Git worktrees
 *   ase-init --transcript [path|latest] [--compact] → Inspect native agent transcript with zero PTY
 */

const fs = require('fs');
const path = require('path');
const readline = require('readline');

// Register tsx loader so TypeScript services can be loaded directly
try {
  require('tsx/cjs');
} catch (_) {}

// Path to the ASE tools directory
const ASE_ROOT = '/home/thor/skiils/tools';

function safeExit(code = 0) {
  setTimeout(() => process.exit(code), 60);
}

const { generateProjectPrompt, getConfigTemplate } = require(`${ASE_ROOT}/server/src/services/project-prompt-generator`);
const { validate, detectProjectType } = require(`${ASE_ROOT}/server/src/services/output-validator`);
const { routeModel } = require(`${ASE_ROOT}/server/src/services/model-router`);
const { selectTopSkills } = require(`${ASE_ROOT}/server/src/services/context-budget`);

const CONFIG_FILE = '.ase-project.json';
const cwd = process.cwd();
const args = process.argv.slice(2);

// ──────────────────────────────────────────────────────────
// ANSI Colors
// ──────────────────────────────────────────────────────────
const c = {
  reset: '\x1b[0m',
  bold: '\x1b[1m',
  green: '\x1b[32m',
  yellow: '\x1b[33m',
  cyan: '\x1b[36m',
  red: '\x1b[31m',
  gray: '\x1b[90m',
  blue: '\x1b[34m',
};

function log(color, symbol, msg) {
  console.log(`${color}${symbol}${c.reset} ${msg}`);
}

// ──────────────────────────────────────────────────────────
// --check
// ──────────────────────────────────────────────────────────
if (args.includes('--check')) {
  const configPath = path.join(cwd, CONFIG_FILE);
  if (fs.existsSync(configPath)) {
    log(c.green, '✅', `ASE is configured for this project.`);
    const cfg = JSON.parse(fs.readFileSync(configPath, 'utf8'));
    log(c.cyan, '📦', `Project: ${c.bold}${cfg.name}${c.reset}`);
    log(c.gray, '🛠 ', `Tech stack: ${(cfg.tech_stack || []).join(', ')}`);
  } else {
    log(c.yellow, '⚠️ ', `No ${CONFIG_FILE} found. Run ${c.bold}ase-init${c.reset} to initialize.`);
  }
  safeExit(0);
}

// ──────────────────────────────────────────────────────────
// --validate
// ──────────────────────────────────────────────────────────
if (args.includes('--validate')) {
  log(c.cyan, '🔍', `Running output validation for: ${c.bold}${cwd}${c.reset}\n`);
  validate(cwd).then(result => {
    console.log(`Project type: ${c.bold}${result.project_type}${c.reset}\n`);
    for (const step of result.results) {
      const isPassed = step.passed !== undefined ? step.passed : step.status === 'passed';
      const icon = isPassed ? `${c.green}✅${c.reset}` : `${c.red}❌${c.reset}`;
      console.log(`${icon} ${step.step} (exit: ${step.exit_code})`);
      if (!isPassed && step.output) {
        console.log(`${c.gray}${step.output.slice(0, 500)}${c.reset}`);
      }
    }
    console.log(`\n${result.summary}`);
    process.exit(result.passed ? 0 : 1);
  }).catch(err => {
    console.error('Validation failed:', err.message);
    process.exit(1);
  });
}

// ──────────────────────────────────────────────────────────
// --route "request text"
// ──────────────────────────────────────────────────────────
// ──────────────────────────────────────────────────────────
// --route "request text"
// ──────────────────────────────────────────────────────────
const routeIdx = args.indexOf('--route');
if (routeIdx !== -1) {
  const request = args[routeIdx + 1] || '';
  if (!request) { console.error('Usage: ase-init --route "your request text"'); process.exit(1); }
  routeModel(request).then(config => {
    console.log(`\n${c.bold}Model Recommendation:${c.reset}`);
    log(c.blue,  '🤖', `Model:       ${c.bold}${config.model}${c.reset}`);
    log(c.cyan,  '🌡 ', `Temperature: ${c.bold}${config.temperature}${c.reset}`);
    log(c.green, '📏', `Max tokens:  ${c.bold}${config.max_tokens}${c.reset}`);
    log(c.gray,  '🏷 ', `Task type:   ${config.task_type}`);
    log(c.gray,  '💬', `Rationale:   ${config.rationale}`);
    safeExit(0);
  }).catch(err => {
    console.error('Routing failed:', err.message);
    safeExit(1);
  });
}

// ──────────────────────────────────────────────────────────
// --budget "request text"
// ──────────────────────────────────────────────────────────
const budgetIdx = args.indexOf('--budget');
if (budgetIdx !== -1) {
  const request = args[budgetIdx + 1] || '';
  if (!request) { console.error('Usage: ase-init --budget "your request text"'); process.exit(1); }
  const SKILLS_DIR = '/home/thor/skiils';
  const allSkills = fs.readdirSync(SKILLS_DIR).filter(e => {
    try { return fs.statSync(path.join(SKILLS_DIR, e)).isDirectory() && !e.startsWith('.') && e !== 'tools' && e !== 'docs'; }
    catch(_) { return false; }
  });
  const budget = selectTopSkills(allSkills, request, 3);
  console.log(`\n${c.bold}Context Budget (top 3 skills):${c.reset}`);
  budget.selected.forEach((s, i) => {
    log(c.green, `${i+1}.`, `${c.bold}${s.name}${c.reset} — score: ${s.score} (~${s.tokenEstimate} tokens)`);
  });
  log(c.gray, '📊', `Total estimated: ${budget.totalBudgetTokens} tokens | Dropped: ${budget.dropped_count || 0} skills`);
  safeExit(0);
}

// ──────────────────────────────────────────────────────────
// --compact <transcript.json>
// ──────────────────────────────────────────────────────────
const compactIdx = args.indexOf('--compact');
if (compactIdx !== -1 && !args.includes('--transcript')) {
  const targetFile = args[compactIdx + 1] && !args[compactIdx + 1].startsWith('-') ? args[compactIdx + 1] : null;
  if (!targetFile) {
    console.error('Usage: ase-init --compact <transcript.json>');
    safeExit(1);
    return;
  }
  const fullPath = path.resolve(cwd, targetFile);
  if (!fs.existsSync(fullPath)) {
    console.error(`File not found: ${fullPath}`);
    safeExit(1);
  }
  try {
    const raw = fs.readFileSync(fullPath, 'utf8');
    const messages = JSON.parse(raw);
    const { compactTranscript } = require(`${ASE_ROOT}/server/src/utils/context-optimizer`);
    log(c.cyan, '⚡', `Compacting conversation transcript with fast-jev-compaction: ${c.bold}${targetFile}${c.reset}`);
    compactTranscript(messages).then(result => {
      log(c.green, '✅', `Compaction completed! Reduction: ${c.bold}${Math.round(result.reductionRatio * 100)}%${c.reset}`);
      log(c.gray, '📊', `Messages: ${result.stats.messagesBefore} → ${result.stats.messagesAfter} | Chars: ${result.stats.charsBefore} → ${result.stats.charsAfter} | Dropped calls: ${result.stats.callsDropped}`);
      const outPath = fullPath.replace(/\.json$/, '.compacted.json');
      fs.writeFileSync(outPath, JSON.stringify(result.messages, null, 2), 'utf8');
      log(c.blue, '💾', `Saved compacted transcript to: ${c.bold}${outPath}${c.reset}`);
      safeExit(0);
    }).catch(err => {
      console.error('Compaction failed:', err.message);
      safeExit(1);
    });
  } catch (err) {
    console.error('Failed to read or parse transcript JSON:', err.message);
    safeExit(1);
  }
}

// ──────────────────────────────────────────────────────────
// --export-vault [dir]
// ──────────────────────────────────────────────────────────
if (args.includes('--export-vault')) {
  const { VaultExporter } = require(`${ASE_ROOT}/server/src/services/vault-exporter`);
  const vIdx = args.indexOf('--export-vault');
  const targetDir = args[vIdx + 1] && !args[vIdx + 1].startsWith('-') ? args[vIdx + 1] : path.join(cwd, 'vault');
  log(c.cyan, '🧠', `Exporting Second Brain knowledge vault to: ${c.bold}${targetDir}${c.reset}`);
  try {
    const exporter = new VaultExporter({ vaultDir: targetDir, projectDir: cwd });
    const result = exporter.exportVault();
    log(c.green, '✅', `Exported ${result.filesGenerated} connected notes with bidirectional [[wiki-links]]!`);
    log(c.gray, '📁', `Index MoC: ${result.indexFile}`);
  } catch (err) {
    console.error('Vault export failed:', err.message);
    safeExit(1);
  }
  safeExit(0);
}

// ──────────────────────────────────────────────────────────
// --lessons [query]
// ──────────────────────────────────────────────────────────
if (args.includes('--lessons')) {
  const { EpisodicLearningService } = require(`${ASE_ROOT}/server/src/services/episodic-learning`);
  const service = new EpisodicLearningService();
  const lIdx = args.indexOf('--lessons');
  const query = args[lIdx + 1] && !args[lIdx + 1].startsWith('-') ? args[lIdx + 1] : '';
  const lessons = query ? service.searchLessons(query, 10) : service.getAllLessons();

  console.log(`\n${c.bold}🧠 Second Brain Learned Lessons (${lessons.length}):${c.reset}\n`);
  if (lessons.length === 0) {
    log(c.gray, 'ℹ️', 'No lessons recorded yet. Run tasks or use record_learned_lesson tool.');
  } else {
    lessons.forEach((l, i) => {
      log(c.green, `${i+1}.`, `${c.bold}${l.problem}${c.reset} (${l.reinforcementCount}x verified)`);
      console.log(`   ${c.cyan}Fix:${c.reset} ${l.solution.slice(0, 120)}...`);
    });
  }
  safeExit(0);
}

// ──────────────────────────────────────────────────────────
// --worktree <list|create|remove|prune> [args]
// ──────────────────────────────────────────────────────────
const wtIdx = args.indexOf('--worktree');
if (wtIdx !== -1) {
  const subAction = args[wtIdx + 1] || 'list';
  const { WorktreeManager } = require(`${ASE_ROOT}/server/src/services/worktree-manager`);
  (async () => {
    try {
      if (subAction === 'list') {
        const list = await WorktreeManager.listWorktrees(cwd);
        console.log(`\n${c.bold}🌳 Active Git Worktrees (${list.length}):${c.reset}\n`);
        list.forEach((wt, i) => {
          const tag = wt.isMain ? `${c.green}(main repo)${c.reset}` : `${c.cyan}(worktree)${c.reset}`;
          console.log(`  ${c.bold}${i + 1}.${c.reset} [${c.yellow}${wt.branch || 'detached'}${c.reset}] ${tag}`);
          console.log(`     ${c.gray}Path: ${wt.path}${c.reset}`);
          console.log(`     ${c.gray}HEAD: ${wt.head}${c.reset}`);
        });
      } else if (subAction === 'create') {
        const branchName = args[wtIdx + 2];
        if (!branchName) {
          console.error('Usage: ase-init --worktree create <branch-name>');
          safeExit(1);
          return;
        }
        log(c.cyan, '🌿', `Creating isolated git worktree for branch: ${c.bold}${branchName}${c.reset}`);
        const res = await WorktreeManager.createWorktree({ repoPath: cwd, branch: branchName });
        log(c.green, '✅', `Worktree ready at: ${c.bold}${res.worktreePath}${c.reset}`);
        log(c.gray, '📌', `HEAD: ${res.head}`);
      } else if (subAction === 'remove') {
        const targetPath = args[wtIdx + 2];
        if (!targetPath) {
          console.error('Usage: ase-init --worktree remove <worktree-path> [--force] [--delete-branch]');
          safeExit(1);
          return;
        }
        const force = args.includes('--force');
        const deleteBranch = args.includes('--delete-branch');
        log(c.yellow, '🧹', `Removing worktree: ${c.bold}${targetPath}${c.reset}`);
        const res = await WorktreeManager.removeWorktree({ repoPath: cwd, worktreePath: targetPath, force, deleteBranch });
        log(c.green, '✅', `Removed worktree at: ${c.bold}${res.removedPath}${c.reset}${res.branchDeleted ? ' (branch deleted)' : ''}`);
      } else if (subAction === 'prune') {
        await WorktreeManager.pruneWorktrees(cwd);
        log(c.green, '✅', 'Pruned stale worktrees cleanly.');
      } else {
        console.error(`Unknown worktree subaction: ${subAction}. Use list, create, remove, or prune.`);
        safeExit(1);
        return;
      }
      safeExit(0);
    } catch (err) {
      console.error('Worktree operation failed:', err.message);
      safeExit(1);
    }
  })();
}

// ──────────────────────────────────────────────────────────
// --transcript [path|latest] [--compact]
// ──────────────────────────────────────────────────────────
const transcriptIdx = args.indexOf('--transcript');
if (transcriptIdx !== -1) {
  const target = args[transcriptIdx + 1] && !args[transcriptIdx + 1].startsWith('-') ? args[transcriptIdx + 1] : 'latest';
  const shouldCompact = args.includes('--compact');
  const { TranscriptReader } = require(`${ASE_ROOT}/server/src/services/transcript-reader`);
  const { compactTranscript } = require(`${ASE_ROOT}/server/src/utils/context-optimizer`);
  (async () => {
    try {
      let resolved = target;
      if (target === 'latest') {
        const found = await TranscriptReader.discoverRecentTranscripts(cwd, 1);
        if (found.length === 0) {
          console.error('No recent transcripts discovered.');
          safeExit(1);
          return;
        }
        resolved = found[0];
      }
      log(c.cyan, '📜', `Reading native transcript: ${c.bold}${resolved}${c.reset}`);
      const parsed = await TranscriptReader.readTranscript(resolved, { tail: 50 });
      console.log(`\n${c.bold}Execution Metrics:${c.reset}`);
      log(c.green, '📊', `Total Steps: ${parsed.metrics.totalSteps} (User: ${parsed.metrics.userTurns}, Assistant: ${parsed.metrics.assistantTurns})`);
      log(c.blue, '🛠 ', `Total Tool Calls: ${parsed.metrics.totalToolCalls} (Failed: ${parsed.metrics.failedToolCalls})`);
      if (Object.keys(parsed.metrics.toolInvocations).length > 0) {
        console.log(`   ${c.gray}Tools used: ${Object.entries(parsed.metrics.toolInvocations).map(([k, v]) => `${k}(${v})`).join(', ')}${c.reset}`);
      }
      if (parsed.metrics.modifiedFiles.length > 0) {
        log(c.yellow, '📝', `Modified Files: ${parsed.metrics.modifiedFiles.join(', ')}`);
      }
      if (shouldCompact) {
        log(c.cyan, '⚡', 'Applying fast-jev compaction on native transcript...');
        const comp = await compactTranscript(parsed.messages);
        log(c.green, '✅', `Compaction completed! Reduction: ${c.bold}${Math.round(comp.reductionRatio * 100)}%${c.reset}`);
        log(c.gray, '📊', `Messages: ${comp.stats.messagesBefore} → ${comp.stats.messagesAfter} | Chars: ${comp.stats.charsBefore} → ${comp.stats.charsAfter} | Dropped calls: ${comp.stats.callsDropped}`);
      }
      safeExit(0);
    } catch (err) {
      console.error('Transcript inspection failed:', err.message);
      safeExit(1);
    }
  })();
}

// ──────────────────────────────────────────────────────────
// DEFAULT — Initialize project (ase-init or ase-init --update)
// ──────────────────────────────────────────────────────────
const hasCommand = args.includes('--validate') || args.includes('--route') || args.includes('--budget') || args.includes('--check') || args.includes('--export-vault') || args.includes('--lessons') || args.includes('--compact') || args.includes('--worktree') || args.includes('--transcript');

if (!hasCommand) {
  (async () => {
    const configPath = path.join(cwd, CONFIG_FILE);
    const isUpdate = args.includes('--update');
    const detection = await detectProjectType(cwd);
    const projectType = typeof detection === 'object' ? (detection.type || 'generic') : detection;

    if (fs.existsSync(configPath) && !isUpdate) {
      log(c.green, '✅', `${CONFIG_FILE} already exists. Use ${c.bold}ase-init --update${c.reset} to regenerate.`);
      const existing = generateProjectPrompt(cwd);
      if (existing.prompt) {
        console.log(`\n${c.gray}${existing.prompt.slice(0, 300)}...${c.reset}`);
      }
      safeExit(0);
      return;
    }

    console.log(`\n${c.bold}${c.cyan}🚀 ASE Project Initializer${c.reset}\n`);
    log(c.gray, '📁', `Directory: ${cwd}`);
    log(c.gray, '🔍', `Detected project type: ${c.bold}${projectType}${c.reset}`);


// Auto-detect project name from package.json or directory name
let autoName = path.basename(cwd);
let autoVersion = '1.0.0';
let autoDescription = '';
let autoStack = [];

try {
  const pkg = JSON.parse(fs.readFileSync(path.join(cwd, 'package.json'), 'utf8'));
  autoName = pkg.name || autoName;
  autoVersion = pkg.version || autoVersion;
  autoDescription = pkg.description || '';
  // Infer stack from deps
  const deps = { ...pkg.dependencies, ...pkg.devDependencies };
  if (deps['next']) autoStack.push(`Next.js ${deps['next']?.replace(/[\^~]/,'')} (App Router)`);
  if (deps['react']) autoStack.push(`React ${deps['react']?.replace(/[\^~]/,'')}`);
  if (deps['typescript']) autoStack.push(`TypeScript ${deps['typescript']?.replace(/[\^~]/,'')}`);
  if (deps['tailwindcss']) autoStack.push(`Tailwind CSS ${deps['tailwindcss']?.replace(/[\^~]/,'')}`);
  if (deps['drizzle-orm']) autoStack.push('Drizzle ORM (PostgreSQL)');
  if (deps['prisma'] || deps['@prisma/client']) autoStack.push('Prisma ORM');
  if (deps['express']) autoStack.push(`Express.js ${deps['express']?.replace(/[\^~]/,'')}`);
  if (deps['fastapi'] || deps['uvicorn']) autoStack.push('FastAPI (Python)');
  if (deps['firebase']) autoStack.push('Firebase');
  if (deps['@supabase/supabase-js']) autoStack.push('Supabase');
} catch (_) {}

// Build the config from the template and auto-detected values
const template = getConfigTemplate();
const config = {
  ...template,
  name: autoName,
  version: autoVersion,
  description: autoDescription || template.description,
  tech_stack: autoStack.length > 0 ? autoStack : template.tech_stack,
};

fs.writeFileSync(configPath, JSON.stringify(config, null, 2));

log(c.green, '✅', `Created ${c.bold}${CONFIG_FILE}${c.reset} — edit it to add your project's conventions.`);
console.log(`\n${c.gray}Next steps:${c.reset}`);
console.log(`  ${c.bold}1.${c.reset} Open ${c.cyan}${configPath}${c.reset} and fill in your tech stack, conventions, and never-do rules.`);
console.log(`  ${c.bold}2.${c.reset} Run ${c.bold}ase-init --validate${c.reset} after generating code to check for issues.`);
console.log(`  ${c.bold}3.${c.reset} Run ${c.bold}ase-init --route "your task"${c.reset} to get the optimal model config.\n`);
  safeExit(0);
  })().catch(err => {
    console.error('Initialization failed:', err.message);
    safeExit(1);
  });
}



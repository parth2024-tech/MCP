script-source,420,/home/thor/skiils/tools/server/src/tools/get_task_taxonomy.js,const { logAccess } = require('../utils/logger');\nconst { getTaskTaxonomy } = require('../services/model-router');\n\nmodule.exports = (deps) => ({\n  name: 'get_task_taxonomy'\x2C\n  description: 'Returns the complete task type taxonomy with model assignments\x2C temperatures\x2C and descriptions. Use for introspection and debugging.'\x2C\n  inputSchema: {\n    type: 'object'\x2C\n    properties: {\n      verbose: {\n        type: 'boolean'\x2C\n        description: 'Optional. If true\x2C returns more verbose metadata.'\n      }\n    }\n  }\x2C\n  handler: async (args) => {\n    const taxonomy = await getTaskTaxonomy();\n    logAccess('mcp-client'\x2C 'get_task_taxonomy'\x2C 'authorized'\x2C 0\x2C { type_count: taxonomy.length });\n    return taxonomy;\n  }\n});\n

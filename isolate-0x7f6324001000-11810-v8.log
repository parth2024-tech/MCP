tGrant(name\x2C mode);\n\n            return callback(createLock(lock));\n          });\n        };\n\n        try {\n          const released = locks.request(\n            name\x2C\n            clientId\x2C\n            mode\x2C\n            steal\x2C\n            ifAvailable\x2C\n            wrappedCallback\x2C\n          );\n\n          // When released promise settles\x2C clean up listener and resolve main promise\n          SafePromisePrototypeFinally(\n            PromisePrototypeThen(\n              released\x2C\n              (result) => {\n                publishLockRequestEnd(name\x2C mode\x2C ifAvailable\x2C steal\x2C undefined);\n                resolve(result);\n              }\x2C\n              (error) => {\n                const convertedError = convertLockError(error);\n                publishLockRequestEnd(name\x2C mode\x2C ifAvailable\x2C steal\x2C convertedError);\n                reject(convertedError);\n              }\x2C\n            )\x2C\n            () => signal.removeEventListener('abort'\x2C abortListener)\x2C\n          );\n        } catch (error) {\n          signal.removeEventListener('abort'\x2C abortListener);\n          const convertedError = convertLockError(error);\n          publishLockRequestEnd(name\x2C mode\x2C ifAvailable\x2C steal\x2C convertedError);\n          reject(convertedError);\n        }\n      });\n    }\n\n    // When ifAvailable: true and lock is not available\x2C C++ passes null to indicate no lock granted\n    const wrapCallback = (internalLock) => {\n      if (internalLock === null) {\n        publishLockRequestMiss(name\x2C mode\x2C ifAvailable);\n      } else {\n        publishLockRequestGrant(name\x2C mode);\n      }\n      const lock = createLock(internalLock);\n      return callback(lock);\n    };\n\n    // Standard request without signal\n    try {\n      const result = await locks.request(name\x2C clientId\x2C mode\x2C steal\x2C ifAvailable\x2C wrapCallback);\n      publishLockRequestEnd(name\x2C mode\x2C ifAvailable\x2C steal\x2C undefined);\n\n      return result;\n    } catch (error) {\n      const convertedError = convertLockError(error);\n      publishLockRequestEnd(name\x2C mode\x2C ifAvailable\x2C steal\x2C convertedError);\n      throw convertedError;\n    }\n  }\n\n  /**\n   * Query the current state of locks for this environment.\n   * @returns {Promise<{held: Array<object>\x2C pending: Array<object>}>} Promise resolving to lock manager snapshot\n   */\n  // https://w3c.github.io/web-locks/#api-lock-manager-query\n  async query() {\n    if (this instanceof LockManager) {\n      return locks.query();\n    }\n    throw new ERR_INVALID_THIS('LockManager');\n  }\n}\n\nObjectDefineProperties(LockManager.prototype\x2C {\n  request: kEnumerableProperty\x2C\n  query: kEnumerableProperty\x2C\n  [SymbolToStringTag]: {\n    __proto__: null\x2C\n    value: 'LockManager'\x2C\n    writable: false\x2C\n    enumerable: false\x2C\n    configurable: true\x2C\n  }\x2C\n});\n\nmodule.exports = {\n  Lock\x2C\n  LockManager\x2C\n  locks: new LockManager(kConstructLockManager)\x2C\n};\n

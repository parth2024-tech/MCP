{
  "servers": {
    "ase": {
      "type": "stdio",
      "command": "/home/thor/.local/bin/mcp-compressor",
      "args": [
        "--compression-level",
        "medium",
        "npx",
        "tsx",
        "/home/thor/skiils/tools/server/ase-mcp-server.ts"
      ],
      "env": {
        "NEO4J_URI": "neo4j://127.0.0.1:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "12345678",
        "NODE_ENV": "production",
        "ASE_ALLOWED_DIRS": "/home/thor",
        "MCP_VIRTUAL_KEY": "master-key"
      }
    },
    "toonify": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "toonify-mcp"
      ]
    }
  }
}

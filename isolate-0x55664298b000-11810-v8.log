script-source,99,node:internal/crypto/keys,'use strict';\n\nconst {\n  ArrayPrototypeSlice\x2C\n  ObjectDefineProperties\x2C\n  ObjectPrototypeHasOwnProperty\x2C\n  ObjectSetPrototypeOf\x2C\n  SafeSet\x2C\n  SymbolToStringTag\x2C\n  Uint8Array\x2C\n} = primordials;\n\nconst {\n  KeyObjectHandle\x2C\n  createNativeKeyObjectClass\x2C\n  // eslint-disable-next-line no-restricted-syntax -- intended here\n  getKeyObjectSlots: nativeGetKeyObjectSlots\x2C\n  createCryptoKeyClass\x2C\n  // eslint-disable-next-line no-restricted-syntax -- intended here\n  getCryptoKeySlots: nativeGetCryptoKeySlots\x2C\n  kKeyTypeSecret\x2C\n  kKeyTypePublic\x2C\n  kKeyTypePrivate\x2C\n  kKeyFormatPEM\x2C\n  kKeyFormatDER\x2C\n  kKeyFormatJWK\x2C\n  kKeyFormatRawPublic\x2C\n  kKeyFormatRawPrivate\x2C\n  kKeyFormatRawSeed\x2C\n  kKeyEncodingPKCS1\x2C\n  kKeyEncodingPKCS8\x2C\n  kKeyEncodingSPKI\x2C\n  kKeyEncodingSEC1\x2C\n} = internalBinding('crypto');\n\nconst {\n  crypto: {\n    POINT_CONVERSION_COMPRESSED\x2C\n    POINT_CONVERSION_UNCOMPRESSED\x2C\n  }\x2C\n} = internalBinding('constants');\n\nconst {\n  validateObject\x2C\n  validateOneOf\x2C\n  validateString\x2C\n} = require('internal/validators');\n\nconst {\n  codes: {\n    ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS\x2C\n    ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE\x2C\n    ERR_ILLEGAL_CONSTRUCTOR\x2C\n    ERR_INVALID_ARG_TYPE\x2C\n    ERR_INVALID_ARG_VALUE\x2C\n    ERR_INVALID_THIS\x2C\n  }\x2C\n} = require('internal/errors');\n\nconst {\n  getArrayBufferOrView\x2C\n  bigIntArrayToUnsignedBigInt\x2C\n  normalizeAlgorithm\x2C\n  hasAnyNotIn\x2C\n  getUsagesMask\x2C\n  getUsagesFromMask\x2C\n  hasUsage\x2C\n} = require('internal/crypto/util');\n\nconst {\n  isAnyArrayBuffer\x2C\n  isArrayBufferView\x2C\n} = require('internal/util/types');\n\nconst {\n  customInspectSymbol: kInspect\x2C\n  getDeprecationWarningEmitter\x2C\n  kEnumerableProperty\x2C\n  kEmptyObject\x2C\n  lazyDOMException\x2C\n} = require('internal/util');\n\nconst { inspect } = require('internal/util/inspect');\n\nconst emitDEP0203 = getDeprecationWarningEmitter(\n  'DEP0203'\x2C\n  'Passing a CryptoKey to node:crypto functions is deprecated.'\x2C\n);\n\nconst maybeEmitDEP0204 = getDeprecationWarningEmitter(\n  'DEP0204'\x2C\n  'Passing a non-extractable CryptoKey to KeyObject.from() is deprecated.'\x2C\n  undefined\x2C\n  false\x2C\n  (key) => !getCryptoKeyExtractable(key)\x2C\n);\n\n// Key input contexts.\nconst kConsumePublic = 0;\nconst kConsumePrivate = 1;\nconst kCreatePublic = 2;\nconst kCreatePrivate = 3;\n\nconst encodingNames = [];\nfor (const m of [[kKeyEncodingPKCS1\x2C 'pkcs1']\x2C [kKeyEncodingPKCS8\x2C 'pkcs8']\x2C\n                 [kKeyEncodingSPKI\x2C 'spki']\x2C [kKeyEncodingSEC1\x2C 'sec1']])\n  encodingNames[m[0]] = m[1];\n\n// KeyObject state lives on the native NativeKeyObject base class. JS reads\n// the native type enum and a KeyObjectHandle in one call and caches that\n// slot tuple in a private field so no forgeable own Symbols are exposed on\n// public KeyObject instances.\nlet getKeyObjectSlots; // Populated by the createNativeKeyObjectClass callback.\n\nconst kKeyObjectSlotType = 0;\nconst kKeyObjectSlotHandle = 1;\n// The native slot tuple stops at kKeyObjectSlotHandle. The remaining entries\n// are JS-side lazy cache slots derived from the KeyObjectHandle on first use.\nconst kKeyObjectSlotSymmetricKeySize = 2;\nconst kKeyObjectSlotAsymmetricKeyType = 3;\nconst kKeyObjectSlotAsymmetricKeyDetails = 4;\n\nfunction normalizeKeyDetails(details = kEmptyObject) {\n  if (details.publicExponent !== undefined) {\n    return {\n      __proto__: null\x2C\n      ...details\x2C\n      publicExponent:\n        bigIntArrayToUnsignedBigInt(new Uint8Array(details.publicExponent))\x2C\n    };\n  }\n  return details;\n}\n\n// Creating the KeyObject class is a little complicated due to inheritance\n// and the fact that KeyObjects should be transferable between threads\x2C\n// which requires the KeyObject base class to be implemented in C++.\n// The creation requires a callback to make sure that the NativeKeyObject\n// base class cannot exist without the other KeyObject implementations.\nconst {\n  0: KeyObject\x2C\n  1: SecretKeyObject\x2C\n  2: PublicKeyObject\x2C\n  3: PrivateKeyObject\x2C\n} = createNativeKeyObjectClass((NativeKeyObject) => {\n  // Publicly visible KeyObject class.\n  class KeyObject extends NativeKeyObject {\n    #slots;\n\n    constructor(type\x2C handle) {\n      if (type !== 'secret' && type !== 'public' && type !== 'private')\n        throw new ERR_INVALID_ARG_VALUE('type'\x2C type);\n      if (typeof handle !== 'object' || !(handle instanceof KeyObjectHandle))\n        throw new ERR_INVALID_ARG_TYPE('handle'\x2C 'object'\x2C handle);\n\n      super(handle);\n    }\n\n    get type() {\n      return getKeyObjectType(this);\n    }\n\n    static from(key) {\n      if (!isCryptoKey(key))\n        throw new ERR_INVALID_ARG_TYPE('key'\x2C 'CryptoKey'\x2C key);\n      maybeEmitDEP0204(key);\n      const handle = getCryptoKeyHandle(key);\n      switch (getCryptoKeyType(key)) {\n        /* eslint-disable no-use-before-define */\n        case 'secret': return new SecretKeyObject(handle);\n        case 'public': return new PublicKeyObject(handle);\n        case 'private': return new PrivateKeyObject(handle);\n        /* eslint-enable no-use-before-define */\n      }\n    }\n\n    equals(otherKeyObject) {\n      if (!isKeyObject(otherKeyObject)) {\n        throw new ERR_INVALID_ARG_TYPE(\n          'otherKeyObject'\x2C 'KeyObject'\x2C otherKeyObject);\n      }\n\n      const slots = getKeyObjectSlots(this);\n      const otherSlots = getKeyObjectSlots(otherKeyObject);\n      return slots[kKeyObjectSlotType] === otherSlots[kKeyObjectSlotType] &&\n        slots[kKeyObjectSlotHandle].equals(\n          otherSlots[kKeyObjectSlotHandle]);\n    }\n\n    static {\n      getKeyObjectSlots = (key) => {\n        if (!key || typeof key !== 'object')\n          throw new ERR_INVALID_THIS('KeyObject');\n        if (#slots in key) {\n          const cached = key.#slots;\n          if (cached !== undefined) return cached;\n        }\n        const slots = nativeGetKeyObjectSlots(key);\n        key.#slots = slots;\n        return slots;\n      };\n    }\n  }\n\n  ObjectDefineProperties(KeyObject.prototype\x2C {\n    [SymbolToStringTag]: {\n      __proto__: null\x2C\n      configurable: true\x2C\n      value: 'KeyObject'\x2C\n    }\x2C\n  });\n\n  let webidl;\n\n  class SecretKeyObject extends KeyObject {\n    constructor(handle) {\n      super('secret'\x2C handle);\n    }\n\n    get symmetricKeySize() {\n      return getKeyObjectSymmetricKeySize(this);\n    }\n\n    export(options) {\n      const handle = getKeyObjectHandle(this);\n      if (options !== undefined) {\n        validateObject(options\x2C 'options');\n        validateOneOf(\n          options.format\x2C 'options.format'\x2C [undefined\x2C 'buffer'\x2C 'jwk']);\n        if (options.format === 'jwk') {\n          return handle.exportJwk({}\x2C false);\n        }\n      }\n      return handle.export();\n    }\n\n    toCryptoKey(algorithm\x2C extractable\x2C keyUsages) {\n      webidl ??= require('internal/crypto/webidl');\n      algorithm = normalizeAlgorithm(webidl.converters.AlgorithmIdentifier(algorithm)\x2C 'importKey');\n      extractable = webidl.converters.boolean(extractable);\n      keyUsages = webidl.converters['sequence<KeyUsage>'](keyUsages);\n\n      let result;\n      switch (algorithm.name) {\n        case 'HMAC':\n          // Fall through\n        case 'KMAC128':\n          // Fall through\n        case 'KMAC256':\n          result = require('internal/crypto/mac')\n            .macImportKey('KeyObject'\x2C this\x2C algorithm\x2C extractable\x2C keyUsages);\n          break;\n        case 'AES-CTR':\n          // Fall through\n        case 'AES-CBC':\n          // Fall through\n        case 'AES-GCM':\n          // Fall through\n        case 'AES-KW':\n          // Fall through\n        case 'AES-OCB':\n          result = require('internal/crypto/aes')\n            .aesImportKey(algorithm\x2C 'KeyObject'\x2C this\x2C extractable\x2C keyUsages);\n          break;\n        case 'ChaCha20-Poly1305':\n          result = require('internal/crypto/chacha20_poly1305')\n            .c20pImportKey(algorithm\x2C 'KeyObject'\x2C this\x2C extractable\x2C keyUsages);\n          break;\n        case 'HKDF':\n          // Fall through\n        case 'PBKDF2':\n          // Fall through\n        case 'Argon2d':\n          // Fall through\n        case 'Argon2i':\n          // Fall through\n        case 'Argon2id':\n          result = importGenericSecretKey(\n            algorithm\x2C\n            'KeyObject'\x2C\n            this\x2C\n            extractable\x2C\n            keyUsages);\n          break;\n        default:\n          throw lazyDOMException('Unrecognized algorithm name'\x2C 'NotSupportedError');\n      }\n\n      if (getCryptoKeyUsagesMask(result) === 0) {\n        throw lazyDOMException(\n          `Usages cannot be empty when importing a ${getCryptoKeyType(result)} key.`\x2C\n          'SyntaxError');\n      }\n\n      return result;\n    }\n  }\n\n  class AsymmetricKeyObject extends KeyObject {\n    get asymmetricKeyType() {\n      return getKeyObjectAsymmetricKeyType(this);\n    }\n\n    get asymmetricKeyDetails() {\n      return { ...getKeyObjectAsymmetricKeyDetails(this) };\n    }\n\n    toCryptoKey(algorithm\x2C extractable\x2C keyUsages) {\n      webidl ??= require('internal/crypto/webidl');\n      algorithm = normalizeAlgorithm(webidl.converters.AlgorithmIdentifier(algorithm)\x2C 'importKey');\n      extractable = webidl.converters.boolean(extractable);\n      keyUsages = webidl.converters['sequence<KeyUsage>'](keyUsages);\n\n      let result;\n      switch (algorithm.name) {\n        case 'RSASSA-PKCS1-v1_5':\n          // Fall through\n        case 'RSA-PSS':\n          // Fall through\n        case 'RSA-OAEP':\n          result = require('internal/crypto/rsa')\n            .rsaImportKey('KeyObject'\x2C this\x2C algorithm\x2C extractable\x2C keyUsages);\n          break;\n        case 'ECDSA':\n          // Fall through\n        case 'ECDH':\n          result = require('internal/crypto/ec')\n            .ecImportKey('KeyObject'\x2C this\x2C algorithm\x2C extractable\x2C keyUsages);\n          break;\n        case 'Ed25519':\n          // Fall through\n        case 'Ed448':\n          // Fall through\n        case 'X25519':\n          // Fall through\n        case 'X448':\n          result = require('internal/crypto/cfrg')\n            .cfrgImportKey('KeyObject'\x2C this\x2C algorithm\x2C extractable\x2C keyUsages);\n          break;\n        case 'ML-DSA-44':\n          // Fall through\n        case 'ML-DSA-65':\n          // Fall through\n        case 'ML-DSA-87':\n          result = require('internal/crypto/ml_dsa')\n            .mlDsaImportKey('KeyObject'\x2C this\x2C algorithm\x2C extractable\x2C keyUsages);\n          break;\n        case 'ML-KEM-512':\n          // Fall through\n        case 'ML-KEM-768':\n          // Fall through\n        case 'ML-KEM-1024':\n          result = require('internal/crypto/ml_kem')\n            .mlKemImportKey('KeyObject'\x2C this\x2C algorithm\x2C extractable\x2C keyUsages);\n          break;\n        default:\n          throw lazyDOMException('Unrecognized algorithm name'\x2C 'NotSupportedError');\n      }\n\n      const resultType = getCryptoKeyType(result);\n      if (resultType === 'private' && getCryptoKeyUsagesMask(result) === 0) {\n        throw lazyDOMException(\n          `Usages cannot be empty when importing a ${resultType} key.`\x2C\n          'SyntaxError');\n      }\n\n      return result;\n    }\n  }\n\n  class PublicKeyObject extends AsymmetricKeyObject {\n    constructor(handle) {\n      super('public'\x2C handle);\n    }\n\n    export(options) {\n      switch (options?.format) {\n        case 'jwk':\n          return getKeyObjectHandle(this).exportJwk({}\x2C false);\n        case 'raw-public': {\n          const handle = getKeyObjectHandle(this);\n          const asymmetricKeyType = getKeyObjectAsymmetricKeyType(this);\n          if (asymmetricKeyType === 'ec') {\n            const { type = 'uncompressed' } = options;\n            validateOneOf(type\x2C 'options.type'\x2C ['compressed'\x2C 'uncompressed']);\n            const form = type === 'compressed' ?\n              POINT_CONVERSION_COMPRESSED : POINT_CONVERSION_UNCOMPRESSED;\n            return handle.exportECPublicRaw(form);\n          }\n          return handle.rawPublicKey();\n        }\n        default: {\n          const asymmetricKeyType = getKeyObjectAsymmetricKeyType(this);\n          const handle = getKeyObjectHandle(this);\n          const {\n            format\x2C\n            type\x2C\n          } = parsePublicKeyEncoding(options\x2C asymmetricKeyType);\n          return handle.export(format\x2C type);\n        }\n      }\n    }\n  }\n\n  class PrivateKeyObject extends AsymmetricKeyObject {\n    constructor(handle) {\n      super('private'\x2C handle);\n    }\n\n    export(options) {\n      if (options?.passphrase !== undefined &&\n          options.format !== 'pem' && options.format !== 'der') {\n        throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\n          options.format\x2C 'does not support encryption');\n      }\n      switch (options?.format) {\n        case 'jwk':\n          return getKeyObjectHandle(this).exportJwk({}\x2C false);\n        case 'raw-private': {\n          const handle = getKeyObjectHandle(this);\n          const asymmetricKeyType = getKeyObjectAsymmetricKeyType(this);\n          if (asymmetricKeyType === 'ec') {\n            return handle.exportECPrivateRaw();\n          }\n          return handle.rawPrivateKey();\n        }\n        case 'raw-seed':\n          return getKeyObjectHandle(this).rawSeed();\n        default: {\n          const asymmetricKeyType = getKeyObjectAsymmetricKeyType(this);\n          const handle = getKeyObjectHandle(this);\n          const {\n            format\x2C\n            type\x2C\n            cipher\x2C\n            passphrase\x2C\n          } = parsePrivateKeyEncoding(options\x2C asymmetricKeyType);\n          return handle.export(format\x2C type\x2C cipher\x2C passphrase);\n        }\n      }\n    }\n  }\n\n  return [KeyObject\x2C SecretKeyObject\x2C PublicKeyObject\x2C PrivateKeyObject];\n});\n\nfunction parseKeyFormat(formatStr\x2C defaultFormat\x2C optionName) {\n  if (formatStr === undefined && defaultFormat !== undefined)\n    return defaultFormat;\n  else if (formatStr === 'pem')\n    return kKeyFormatPEM;\n  else if (formatStr === 'der')\n    return kKeyFormatDER;\n  else if (formatStr === 'jwk')\n    return kKeyFormatJWK;\n  else if (formatStr === 'raw-public')\n    return kKeyFormatRawPublic;\n  else if (formatStr === 'raw-private')\n    return kKeyFormatRawPrivate;\n  else if (formatStr === 'raw-seed')\n    return kKeyFormatRawSeed;\n  throw new ERR_INVALID_ARG_VALUE(optionName\x2C formatStr);\n}\n\nfunction parseKeyType(typeStr\x2C required\x2C keyType\x2C isPublic\x2C optionName) {\n  if (typeStr === undefined && !required) {\n    return undefined;\n  } else if (typeStr === 'pkcs1') {\n    if (keyType !== undefined && keyType !== 'rsa') {\n      throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\n        typeStr\x2C 'can only be used for RSA keys');\n    }\n    return kKeyEncodingPKCS1;\n  } else if (typeStr === 'spki' && isPublic !== false) {\n    return kKeyEncodingSPKI;\n  } else if (typeStr === 'pkcs8' && isPublic !== true) {\n    return kKeyEncodingPKCS8;\n  } else if (typeStr === 'sec1' && isPublic !== true) {\n    if (keyType !== undefined && keyType !== 'ec') {\n      throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\n        typeStr\x2C 'can only be used for EC keys');\n    }\n    return kKeyEncodingSEC1;\n  }\n\n  throw new ERR_INVALID_ARG_VALUE(optionName\x2C typeStr);\n}\n\nfunction option(name\x2C prefix) {\n  return prefix === undefined ?\n    `options.${name}` : `${prefix}.${name}`;\n}\n\nfunction parseKeyFormatAndType(enc\x2C keyType\x2C isPublic\x2C objName) {\n  const { format: formatStr\x2C type: typeStr } = enc;\n\n  const isInput = keyType === undefined;\n  const format = parseKeyFormat(formatStr\x2C\n                                isInput ? kKeyFormatPEM : undefined\x2C\n                                option('format'\x2C objName));\n\n  if (format === kKeyFormatRawPublic) {\n    if (isPublic === false) {\n      throw new ERR_INVALID_ARG_VALUE(option('format'\x2C objName)\x2C 'raw-public');\n    }\n    let type;\n    if (typeStr === undefined || typeStr === 'uncompressed') {\n      type = POINT_CONVERSION_UNCOMPRESSED;\n    } else if (typeStr === 'compressed') {\n      type = POINT_CONVERSION_COMPRESSED;\n    } else {\n      throw new ERR_INVALID_ARG_VALUE(option('type'\x2C objName)\x2C typeStr);\n    }\n    return { format\x2C type };\n  }\n\n  if (format === kKeyFormatRawPrivate || format === kKeyFormatRawSeed) {\n    if (isPublic === true) {\n      throw new ERR_INVALID_ARG_VALUE(\n        option('format'\x2C objName)\x2C\n        format === kKeyFormatRawPrivate ? 'raw-private' : 'raw-seed');\n    }\n    if (typeStr !== undefined) {\n      throw new ERR_INVALID_ARG_VALUE(option('type'\x2C objName)\x2C typeStr);\n    }\n    return { format };\n  }\n\n  const isRequired = (!isInput ||\n                      format === kKeyFormatDER) &&\n                      format !== kKeyFormatJWK;\n  const type = parseKeyType(typeStr\x2C\n                            isRequired\x2C\n                            keyType\x2C\n                            isPublic\x2C\n                            option('type'\x2C objName));\n  return { format\x2C type };\n}\n\nfunction isStringOrBuffer(val) {\n  return typeof val === 'string' ||\n         isArrayBufferView(val) ||\n         isAnyArrayBuffer(val);\n}\n\nfunction parseKeyEncoding(enc\x2C keyType\x2C isPublic\x2C objName) {\n  validateObject(enc\x2C 'options');\n\n  const isInput = keyType === undefined;\n\n  const {\n    format\x2C\n    type\x2C\n  } = parseKeyFormatAndType(enc\x2C keyType\x2C isPublic\x2C objName);\n\n  let cipher\x2C passphrase\x2C encoding;\n  if (isPublic !== true) {\n    ({ cipher\x2C passphrase\x2C encoding } = enc);\n\n    if (format === kKeyFormatRawPrivate || format === kKeyFormatRawSeed) {\n      if (cipher != null || passphrase !== undefined) {\n        throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\n          'raw format'\x2C 'does not support encryption');\n      }\n      return { format\x2C type };\n    }\n\n    if (!isInput) {\n      if (cipher != null) {\n        if (typeof cipher !== 'string')\n          throw new ERR_INVALID_ARG_VALUE(option('cipher'\x2C objName)\x2C cipher);\n        if (format === kKeyFormatDER &&\n            (type === kKeyEncodingPKCS1 ||\n             type === kKeyEncodingSEC1)) {\n          throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\n            encodingNames[type]\x2C 'does not support encryption');\n        }\n      } else if (passphrase !== undefined) {\n        throw new ERR_INVALID_ARG_VALUE(option('cipher'\x2C objName)\x2C cipher);\n      }\n    }\n\n    if ((isInput && passphrase !== undefined &&\n         !isStringOrBuffer(passphrase)) ||\n        (!isInput && cipher != null && !isStringOrBuffer(passphrase))) {\n      throw new ERR_INVALID_ARG_VALUE(option('passphrase'\x2C objName)\x2C\n                                      passphrase);\n    }\n  }\n\n  if (passphrase !== undefined)\n    passphrase = getArrayBufferOrView(passphrase\x2C 'key.passphrase'\x2C encoding);\n\n  return { format\x2C type\x2C cipher\x2C passphrase };\n}\n\n// Parses the public key encoding based on an object. keyType must be undefined\n// when this is used to parse an input encoding and must be a valid key type if\n// used to parse an output encoding.\nfunction parsePublicKeyEncoding(enc\x2C keyType\x2C objName) {\n  return parseKeyEncoding(enc\x2C keyType\x2C keyType ? true : undefined\x2C objName);\n}\n\n// Parses the private key encoding based on an object. keyType must be undefined\n// when this is used to parse an input encoding and must be a valid key type if\n// used to parse an output encoding.\nfunction parsePrivateKeyEncoding(enc\x2C keyType\x2C objName) {\n  return parseKeyEncoding(enc\x2C keyType\x2C false\x2C objName);\n}\n\nfunction validateAsymmetricKeyType(type\x2C ctx\x2C key) {\n  if (ctx === kCreatePrivate) {\n    throw new ERR_INVALID_ARG_TYPE(\n      'key'\x2C\n      ['string'\x2C 'ArrayBuffer'\x2C 'Buffer'\x2C 'TypedArray'\x2C 'DataView']\x2C\n      key\x2C\n    );\n  }\n\n  if (type !== 'private') {\n    if (ctx === kConsumePrivate || ctx === kCreatePublic)\n      throw new ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE(type\x2C 'private');\n    if (type !== 'public') {\n      throw new ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE(type\x2C\n                                                   'private or public');\n    }\n  }\n}\n\nfunction getKeyTypes(allowKeyObject\x2C bufferOnly = false) {\n  const types = [\n    'ArrayBuffer'\x2C\n    'Buffer'\x2C\n    'TypedArray'\x2C\n    'DataView'\x2C\n    'string'\x2C // Only if bufferOnly == false\n    'KeyObject'\x2C // Only if allowKeyObject == true && bufferOnly == false\n    'CryptoKey'\x2C // Only if allowKeyObject == true && bufferOnly == false\n  ];\n  if (bufferOnly) {\n    return ArrayPrototypeSlice(types\x2C 0\x2C 4);\n  } else if (!allowKeyObject) {\n    return ArrayPrototypeSlice(types\x2C 0\x2C 5);\n  }\n  return types;\n}\n\n\nfunction prepareAsymmetricKey(key\x2C ctx\x2C name = 'key') {\n  if (isKeyObject(key)) {\n    // Best case: A key object\x2C as simple as that.\n    const type = getKeyObjectType(key);\n    validateAsymmetricKeyType(type\x2C ctx\x2C key);\n    return { data: getKeyObjectHandle(key) };\n  }\n  if (isCryptoKey(key)) {\n    emitDEP0203();\n    validateAsymmetricKeyType(getCryptoKeyType(key)\x2C ctx\x2C key);\n    return { data: getCryptoKeyHandle(key) };\n  }\n  if (isStringOrBuffer(key)) {\n    // Expect PEM by default\x2C mostly for backward compatibility.\n    return { format: kKeyFormatPEM\x2C data: getArrayBufferOrView(key\x2C name) };\n  }\n  if (typeof key === 'object') {\n    const { key: data\x2C encoding\x2C format } = key;\n\n    // The 'key' property can be a KeyObject as well to allow specifying\n    // additional options such as padding along with the key.\n    if (isKeyObject(data)) {\n      const type = getKeyObjectType(data);\n      validateAsymmetricKeyType(type\x2C ctx\x2C data);\n      return { data: getKeyObjectHandle(data) };\n    }\n    if (isCryptoKey(data)) {\n      emitDEP0203();\n      validateAsymmetricKeyType(getCryptoKeyType(data)\x2C ctx\x2C data);\n      return { data: getCryptoKeyHandle(data) };\n    }\n    if (format === 'jwk') {\n      validateObject(data\x2C `${name}.key`);\n      return { data\x2C format: kKeyFormatJWK };\n    } else if (format === 'raw-public' || format === 'raw-private' ||\n               format === 'raw-seed') {\n      if ((ctx === kConsumePrivate || ctx === kCreatePrivate) &&\n          format === 'raw-public') {\n        throw new ERR_INVALID_ARG_VALUE(`${name}.format`\x2C format);\n      }\n      if (!isArrayBufferView(data) && !isAnyArrayBuffer(data)) {\n        throw new ERR_INVALID_ARG_TYPE(\n          `${name}.key`\x2C\n          ['ArrayBuffer'\x2C 'Buffer'\x2C 'TypedArray'\x2C 'DataView']\x2C\n          data);\n      }\n      validateString(key.asymmetricKeyType\x2C `${name}.asymmetricKeyType`);\n      if (key.asymmetricKeyType === 'ec') {\n        validateString(key.namedCurve\x2C `${name}.namedCurve`);\n      }\n      const rawFormat = parseKeyFormat(format\x2C undefined\x2C `${name}.format`);\n      return {\n        data: getArrayBufferOrView(data\x2C `${name}.key`)\x2C\n        format: rawFormat\x2C\n        type: key.asymmetricKeyType\x2C\n        namedCurve: key.namedCurve ?? null\x2C\n      };\n    }\n\n    // Either PEM or DER using PKCS#1 or SPKI.\n    if (!isStringOrBuffer(data)) {\n      throw new ERR_INVALID_ARG_TYPE(\n        `${name}.key`\x2C\n        getKeyTypes(ctx !== kCreatePrivate)\x2C\n        data);\n    }\n\n    const isPublic =\n      (ctx === kConsumePrivate || ctx === kCreatePrivate) ? false : undefined;\n    return {\n      data: getArrayBufferOrView(data\x2C `${name}.key`\x2C encoding)\x2C\n      ...parseKeyEncoding(key\x2C undefined\x2C isPublic\x2C name)\x2C\n    };\n  }\n\n  throw new ERR_INVALID_ARG_TYPE(\n    name\x2C\n    getKeyTypes(ctx !== kCreatePrivate)\x2C\n    key);\n}\n\nfunction preparePrivateKey(key\x2C name) {\n  return prepareAsymmetricKey(key\x2C kConsumePrivate\x2C name);\n}\n\nfunction preparePublicOrPrivateKey(key\x2C name) {\n  return prepareAsymmetricKey(key\x2C kConsumePublic\x2C name);\n}\n\nfunction prepareSecretKey(key\x2C encoding\x2C bufferOnly = false) {\n  if (!bufferOnly) {\n    if (isKeyObject(key)) {\n      const type = getKeyObjectType(key);\n      if (type !== 'secret')\n        throw new ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE(type\x2C 'secret');\n      return getKeyObjectHandle(key);\n    }\n    if (isCryptoKey(key)) {\n      emitDEP0203();\n      const type = getCryptoKeyType(key);\n      if (type !== 'secret')\n        throw new ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE(type\x2C 'secret');\n      return getCryptoKeyHandle(key);\n    }\n  }\n  if (typeof key !== 'string' &&\n      !isArrayBufferView(key) &&\n      !isAnyArrayBuffer(key)) {\n    throw new ERR_INVALID_ARG_TYPE(\n      'key'\x2C\n      getKeyTypes(!bufferOnly\x2C bufferOnly)\x2C\n      key);\n  }\n  return getArrayBufferOrView(key\x2C 'key'\x2C encoding);\n}\n\nfunction createSecretKey(key\x2C encoding) {\n  key = prepareSecretKey(key\x2C encoding\x2C true);\n  const handle = new KeyObjectHandle();\n  handle.init(kKeyTypeSecret\x2C key);\n  return new SecretKeyObject(handle);\n}\n\nfunction createPublicKey(key) {\n  const { format\x2C type\x2C data\x2C passphrase\x2C namedCurve } =\n    prepareAsymmetricKey(key\x2C kCreatePublic);\n  const handle = new KeyObjectHandle();\n  handle.init(kKeyTypePublic\x2C data\x2C format ?? null\x2C\n              type ?? null\x2C passphrase ?? null\x2C namedCurve ?? null);\n  return new PublicKeyObject(handle);\n}\n\nfunction createPrivateKey(key) {\n  const { format\x2C type\x2C data\x2C passphrase\x2C namedCurve } =\n    prepareAsymmetricKey(key\x2C kCreatePrivate);\n  const handle = new KeyObjectHandle();\n  handle.init(kKeyTypePrivate\x2C data\x2C format ?? null\x2C\n              type ?? null\x2C passphrase ?? null\x2C namedCurve ?? null);\n  return new PrivateKeyObject(handle);\n}\n\nfunction keyObjectTypeToString(type) {\n  switch (type) {\n    case kKeyTypeSecret: return 'secret';\n    case kKeyTypePublic: return 'public';\n    case kKeyTypePrivate: return 'private';\n    default: {\n      const assert = require('internal/assert');\n      assert.fail('Unreachable code');\n    }\n  }\n}\n\n// The helpers below return a KeyObject's native-backed slot values\x2C\n// populating the per-instance cache on first access via a single native\n// call. The public getters delegate to these helpers\x2C and internal\n// consumers use them directly to avoid user-replaceable public accessors.\n// Derived metadata such as key size and asymmetric key details is expanded\n// lazily from the cached KeyObjectHandle. The public asymmetric key details\n// getter returns a clone so the cached details object stays internal.\n\n/**\n * Returns the KeyObject's native type slot as a string.\n * @param {KeyObject} key\n * @returns {'secret' | 'public' | 'private'}\n */\nfunction getKeyObjectType(key) {\n  return keyObjectTypeToString(getKeyObjectSlots(key)[kKeyObjectSlotType]);\n}\n\n/**\n * Returns the KeyObjectHandle wrapping the KeyObject's underlying key\n * material.\n * @param {KeyObject} key\n * @returns {KeyObjectHandle}\n */\nfunction getKeyObjectHandle(key) {\n  return getKeyObjectSlots(key)[kKeyObjectSlotHandle];\n}\n\n/**\n * Returns the KeyObject's symmetric key size\x2C bypassing the public\n * `symmetricKeySize` getter. The value is derived lazily from the cached\n * KeyObjectHandle.\n * @param {SecretKeyObject} key\n * @returns {number}\n */\nfunction getKeyObjectSymmetricKeySize(key) {\n  const slots = getKeyObjectSlots(key);\n  if (slots[kKeyObjectSlotType] !== kKeyTypeSecret)\n    throw new ERR_INVALID_THIS('SecretKeyObject');\n\n  let cached = slots[kKeyObjectSlotSymmetricKeySize];\n  if (cached === undefined) {\n    cached = slots[kKeyObjectSlotHandle].getSymmetricKeySize();\n    slots[kKeyObjectSlotSymmetricKeySize] = cached;\n  }\n  return cached;\n}\n\n/**\n * Returns the KeyObject's asymmetric key type\x2C bypassing the public\n * `asymmetricKeyType` getter. The value is derived lazily from the cached\n * KeyObjectHandle.\n * @param {PublicKeyObject|PrivateKeyObject} key\n * @returns {string}\n */\nfunction getKeyObjectAsymmetricKeyType(key) {\n  const slots = getKeyObjectSlots(key);\n  if (slots[kKeyObjectSlotType] === kKeyTypeSecret)\n    throw new ERR_INVALID_THIS('AsymmetricKeyObject');\n\n  let cached = slots[kKeyObjectSlotAsymmetricKeyType];\n  if (cached === undefined) {\n    cached = slots[kKeyObjectSlotHandle].getAsymmetricKeyType();\n    slots[kKeyObjectSlotAsymmetricKeyType] = cached;\n  }\n  return cached;\n}\n\n/**\n * Returns the KeyObject's cached asymmetric key details\x2C bypassing the\n * public `asymmetricKeyDetails` getter (which returns a cloned copy).\n * The value is derived lazily from the cached KeyObjectHandle.\n * @param {PublicKeyObject|PrivateKeyObject} key\n * @returns {object}\n */\nfunction getKeyObjectAsymmetricKeyDetails(key) {\n  const slots = getKeyObjectSlots(key);\n  if (slots[kKeyObjectSlotType] === kKeyTypeSecret)\n    throw new ERR_INVALID_THIS('AsymmetricKeyObject');\n\n  let cached = slots[kKeyObjectSlotAsymmetricKeyDetails];\n  if (cached === undefined) {\n    let asymmetricKeyType = slots[kKeyObjectSlotAsymmetricKeyType];\n    if (asymmetricKeyType === undefined) {\n      asymmetricKeyType = slots[kKeyObjectSlotHandle].getAsymmetricKeyType();\n      slots[kKeyObjectSlotAsymmetricKeyType] = asymmetricKeyType;\n    }\n    switch (asymmetricKeyType) {\n      case 'rsa':\n      case 'rsa-pss':\n      case 'dsa':\n      case 'ec':\n        cached = normalizeKeyDetails(\n          slots[kKeyObjectSlotHandle].keyDetail({ __proto__: null })\x2C\n        );\n        break;\n      default:\n        cached = kEmptyObject;\n        break;\n    }\n    slots[kKeyObjectSlotAsymmetricKeyDetails] = cached;\n  }\n  return cached;\n}\n\nfunction isKeyObject(obj) {\n  if (obj == null || typeof obj !== 'object')\n    return false;\n\n  try {\n    getKeyObjectSlots(obj);\n    return true;\n  } catch {\n    return false;\n  }\n}\n\n// CryptoKey is a plain JS class whose prototype's [[Prototype]] is\n// Object.prototype\x2C as Web Crypto requires. Instance storage (type enum\x2C\n// extractable\x2C algorithm\x2C usages mask\x2C and the KeyObject handle) lives\n// on a C++ class\x2C NativeCryptoKey\x2C created by createCryptoKeyClass.\n// InternalCryptoKey is the only constructor we expose to internal\n// code; it extends NativeCryptoKey to get that storage and then has\n// its prototype spliced so the chain visible to user code is:\n//   instance -> InternalCryptoKey.prototype\n//            -> CryptoKey.prototype\n//            -> Object.prototype\n//\n// All five internal slots are read from C++ in a single call via\n// `getCryptoKeySlots`. The resulting array is cached in a private\n// class field on `InternalCryptoKey` so that it is invisible to\n// reflection (`Object.getOwnPropertySymbols` etc.) and leaves each\n// CryptoKey's hidden class pristine. The `getCryptoKey{Type\x2C\n// Extractable\x2CAlgorithm\x2CUsages\x2CHandle}` helpers index into that\n// array and convert native enums/masks back to Web Crypto strings.\n// The internal algorithm object is stored as a null-prototype clone\n// so it cannot observe polluted Object.prototype properties.\n// The public `algorithm` getter caches a cloned dictionary and the\n// public `usages` getter caches a synthesized array (as Web Crypto\n// requires repeat reads to return the same object so a consumer's\n// mutation is visible next time).\nlet getSlots; // Populated by the createCryptoKeyClass callback below.\n\nconst kSlotType = 0;\nconst kSlotExtractable = 1;\nconst kSlotAlgorithm = 2;\nconst kSlotUsagesMask = 3;\nconst kSlotHandle = 4;\nconst kSlotClonedAlgorithm = 5;\nconst kSlotClonedUsages = 6;\nconst kSlotUsages = 7;\n\nfunction cloneAlgorithm(raw) {\n  const cloned = { ...raw };\n  if (ObjectPrototypeHasOwnProperty(cloned\x2C 'hash') &&\n      cloned.hash !== undefined) {\n    cloned.hash = { ...cloned.hash };\n  }\n  if (ObjectPrototypeHasOwnProperty(cloned\x2C 'publicExponent') &&\n      cloned.publicExponent !== undefined) {\n    cloned.publicExponent = new Uint8Array(cloned.publicExponent);\n  }\n  return cloned;\n}\n\nfunction cloneInternalAlgorithm(raw) {\n  const cloned = { __proto__: null\x2C ...raw };\n  if (ObjectPrototypeHasOwnProperty(cloned\x2C 'hash') &&\n      cloned.hash !== undefined) {\n    cloned.hash = { __proto__: null\x2C ...cloned.hash };\n  }\n  if (ObjectPrototypeHasOwnProperty(cloned\x2C 'publicExponent') &&\n      cloned.publicExponent !== undefined) {\n    cloned.publicExponent = new Uint8Array(cloned.publicExponent);\n  }\n  return cloned;\n}\n\nconst {\n  0: CryptoKey\x2C\n  1: InternalCryptoKey\x2C\n} = createCryptoKeyClass((NativeCryptoKey) => {\n  class CryptoKey {\n    constructor() {\n      throw new ERR_ILLEGAL_CONSTRUCTOR();\n    }\n\n    [kInspect](depth\x2C options) {\n      if (depth < 0)\n        return this;\n\n      const opts = {\n        ...options\x2C\n        depth: options.depth == null ? null : options.depth - 1\x2C\n      };\n\n      return `CryptoKey ${inspect({\n        type: getCryptoKeyType(this)\x2C\n        extractable: getCryptoKeyExtractable(this)\x2C\n        algorithm: cloneAlgorithm(getCryptoKeyAlgorithm(this))\x2C\n        usages: ArrayPrototypeSlice(getCryptoKeyUsages(this)\x2C 0)\x2C\n      }\x2C opts)}`;\n    }\n\n    get type() {\n      return getCryptoKeyType(this);\n    }\n\n    get extractable() {\n      return getCryptoKeyExtractable(this);\n    }\n\n    get algorithm() {\n      const slots = getSlots(this);\n      let cached = slots[kSlotClonedAlgorithm];\n      if (cached === undefined) {\n        cached = cloneAlgorithm(slots[kSlotAlgorithm]);\n        slots[kSlotClonedAlgorithm] = cached;\n      }\n      return cached;\n    }\n\n    get usages() {\n      const slots = getSlots(this);\n      let cached = slots[kSlotClonedUsages];\n      if (cached === undefined) {\n        cached = ArrayPrototypeSlice(getCryptoKeyUsagesFromSlots(slots)\x2C 0);\n        slots[kSlotClonedUsages] = cached;\n      }\n      return cached;\n    }\n  }\n\n  class InternalCryptoKey extends NativeCryptoKey {\n    #slots;\n\n    constructor(handle\x2C algorithm\x2C usagesMask\x2C extractable) {\n      if (algorithm !== undefined)\n        algorithm = cloneInternalAlgorithm(algorithm);\n      super(handle\x2C algorithm\x2C usagesMask\x2C extractable);\n    }\n\n    static {\n      getSlots = (key) => {\n        if (!key || typeof key !== 'object')\n          throw new ERR_INVALID_THIS('CryptoKey');\n        if (#slots in key) {\n          const cached = key.#slots;\n          if (cached !== undefined) return cached;\n        }\n        const slots = nativeGetCryptoKeySlots(key);\n        slots[kSlotAlgorithm] = cloneInternalAlgorithm(slots[kSlotAlgorithm]);\n        key.#slots = slots;\n        return slots;\n      };\n    }\n  }\n  // Hide NativeCryptoKey from user code.\n  InternalCryptoKey.prototype.constructor = CryptoKey;\n  ObjectSetPrototypeOf(InternalCryptoKey.prototype\x2C CryptoKey.prototype);\n\n  ObjectDefineProperties(CryptoKey.prototype\x2C {\n    type: kEnumerableProperty\x2C\n    extractable: kEnumerableProperty\x2C\n    algorithm: kEnumerableProperty\x2C\n    usages: kEnumerableProperty\x2C\n    [SymbolToStringTag]: {\n      __proto__: null\x2C\n      configurable: true\x2C\n      value: 'CryptoKey'\x2C\n    }\x2C\n  });\n\n  return [CryptoKey\x2C InternalCryptoKey];\n});\n\n// The helpers below return a CryptoKey's internal slot value\x2C\n// populating the per-instance cache on first access via a single\n// native call. The public `type` getter converts the native enum to\n// the Web Crypto string. The `usages` helper converts the native usage\n// mask to Web Crypto strings. The public `algorithm` / `usages` getters\n// on `CryptoKey.prototype` cache their returned objects.\n\n/**\n * Returns the value of a CryptoKey's `[[type]]` internal slot.\n * @param {CryptoKey} key\n * @returns {'secret' | 'public' | 'private'}\n */\nfunction getCryptoKeyType(key) {\n  switch (getSlots(key)[kSlotType]) {\n    case kKeyTypeSecret: return 'secret';\n    case kKeyTypePublic: return 'public';\n    case kKeyTypePrivate: return 'private';\n    default: {\n      const assert = require('internal/assert');\n      assert.fail('Unreachable code');\n    }\n  }\n}\n\n/**\n * Returns the value of a CryptoKey's `[[extractable]]` internal slot.\n * @param {CryptoKey} key\n * @returns {boolean}\n */\nfunction getCryptoKeyExtractable(key) {\n  return getSlots(key)[kSlotExtractable];\n}\n\n/**\n * Returns the CryptoKey's `[[algorithm]]` internal slot\x2C bypassing the\n * public `algorithm` getter (which returns a cloned copy).\n * @param {CryptoKey} key\n * @returns {object}\n */\nfunction getCryptoKeyAlgorithm(key) {\n  return getSlots(key)[kSlotAlgorithm];\n}\n\n/**\n * Returns the CryptoKey's native `[[usages]]` mask.\n * @param {CryptoKey} key\n * @returns {number}\n */\nfunction getCryptoKeyUsagesMask(key) {\n  return getSlots(key)[kSlotUsagesMask];\n}\n\n/**\n * Returns whether a CryptoKey's `[[usages]]` contains `usage`.\n * @param {CryptoKey} key\n * @param {string} usage\n * @returns {boolean}\n */\nfunction hasCryptoKeyUsage(key\x2C usage) {\n  return hasUsage(getCryptoKeyUsagesMask(key)\x2C usage);\n}\n\n/**\n * Returns the CryptoKey's cached canonical usages array for internal\n * consumers\x2C expanding it from the native usage mask on first access.\n * @param {Array} slots\n * @returns {string[]}\n */\nfunction getCryptoKeyUsagesFromSlots(slots) {\n  let usages = slots[kSlotUsages];\n  if (usages === undefined) {\n    usages = getUsagesFromMask(slots[kSlotUsagesMask]);\n    slots[kSlotUsages] = usages;\n  }\n  return usages;\n}\n\n/**\n * Returns the CryptoKey's `[[usages]]` internal slot\x2C bypassing the\n * public `usages` getter (which returns a cloned array). The internal\n * array is expanded lazily from the native usage mask.\n * @param {CryptoKey} key\n * @returns {string[]}\n */\nfunction getCryptoKeyUsages(key) {\n  return getCryptoKeyUsagesFromSlots(getSlots(key));\n}\n\n/**\n * Returns the KeyObjectHandle wrapping the CryptoKey's underlying\n * key material.\n * @param {CryptoKey} key\n * @returns {KeyObjectHandle}\n */\nfunction getCryptoKeyHandle(key) {\n  return getSlots(key)[kSlotHandle];\n}\n\nfunction isCryptoKey(obj) {\n  if (obj == null || typeof obj !== 'object')\n    return false;\n\n  try {\n    getSlots(obj);\n    return true;\n  } catch {\n    return false;\n  }\n}\n\nfunction importGenericSecretKey(\n  algorithm\x2C\n  format\x2C\n  keyData\x2C\n  extractable\x2C\n  keyUsages\x2C\n) {\n  const usagesSet = new SafeSet(keyUsages);\n  const { name } = algorithm;\n  if (extractable)\n    throw lazyDOMException(`${name} keys are not extractable`\x2C 'SyntaxError');\n\n  if (hasAnyNotIn(usagesSet\x2C ['deriveKey'\x2C 'deriveBits'])) {\n    throw lazyDOMException(\n      `Unsupported key usage for a ${name} key`\x2C\n      'SyntaxError');\n  }\n\n  let handle;\n  switch (format) {\n    case 'KeyObject': {\n      handle = getKeyObjectHandle(keyData);\n      break;\n    }\n    case 'raw-secret':\n    case 'raw': {\n      handle = new KeyObjectHandle();\n      handle.init(kKeyTypeSecret\x2C keyData);\n      break;\n    }\n    default:\n      return undefined;\n  }\n\n  return new InternalCryptoKey(\n    handle\x2C\n    { name }\x2C\n    getUsagesMask(usagesSet)\x2C\n    false);\n}\n\nmodule.exports = {\n  // Public API.\n  createSecretKey\x2C\n  createPublicKey\x2C\n  createPrivateKey\x2C\n  KeyObject\x2C\n  CryptoKey\x2C\n  InternalCryptoKey\x2C\n\n  // These are designed for internal use only and should not be exposed.\n  parsePublicKeyEncoding\x2C\n  parsePrivateKeyEncoding\x2C\n  parseKeyEncoding\x2C\n  preparePrivateKey\x2C\n  preparePublicOrPrivateKey\x2C\n  prepareSecretKey\x2C\n  SecretKeyObject\x2C\n  PublicKeyObject\x2C\n  PrivateKeyObject\x2C\n  isKeyObject\x2C\n  getKeyObjectType\x2C\n  getKeyObjectHandle\x2C\n  getKeyObjectSymmetricKeySize\x2C\n  getKeyObjectAsymmetricKeyType\x2C\n  getKeyObjectAsymmetricKeyDetails\x2C\n  isCryptoKey\x2C\n  getCryptoKeyType\x2C\n  getCryptoKeyExtractable\x2C\n  getCryptoKeyAlgorithm\x2C\n  getCryptoKeyUsages\x2C\n  getCryptoKeyUsagesMask\x2C\n  hasCryptoKeyUsage\x2C\n  getCryptoKeyHandle\x2C\n  importGenericSecretKey\x2C\n};\n

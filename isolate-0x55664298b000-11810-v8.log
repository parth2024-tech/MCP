script-source,409,/home/thor/skiils/tools/server/node_modules/piscina/dist/worker_pool/balancer/index.js,"use strict";\nObject.defineProperty(exports\x2C "__esModule"\x2C { value: true });\nexports.LeastBusyBalancer = LeastBusyBalancer;\nfunction LeastBusyBalancer(opts) {\n    const { maximumUsage } = opts;\n    return (task\x2C workers) => {\n        let candidate = null;\n        let checkpoint = maximumUsage;\n        for (const worker of workers) {\n            if (worker.currentUsage === 0) {\n                candidate = worker;\n                break;\n            }\n            if (worker.isRunningAbortableTask)\n                continue;\n            if (task.isAbortable === false &&\n                (worker.currentUsage < checkpoint)) {\n                candidate = worker;\n                checkpoint = worker.currentUsage;\n            }\n        }\n        return candidate;\n    };\n}\n//# sourceMappingURL=index.js.map

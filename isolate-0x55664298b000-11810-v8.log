script-source,411,/home/thor/skiils/tools/server/src/utils/retry.js,/**\n * ASE Retry Utility\n *\n * Wraps an async function with exponential backoff retry logic.\n * Used to harden embedding generation and file I/O operations.\n */\nconst { logger } = require('./logger');\n\n/**\n * Retries an async function with exponential backoff.\n *\n * @param {Function} fn           - Async function to retry\n * @param {object}   opts\n * @param {number}   opts.attempts  - Max number of attempts (default 3)\n * @param {number}   opts.baseMs    - Base delay in ms (default 200)\n * @param {number}   opts.maxMs     - Max delay cap in ms (default 5000)\n * @param {string}   opts.tag       - Log tag for diagnostics\n * @returns {Promise<*>}           - Result of fn on success\n * @throws  {Error}               - Last error if all attempts fail\n */\nasync function withRetry(fn\x2C { attempts = 3\x2C baseMs = 200\x2C maxMs = 5000\x2C tag = 'retry' } = {}) {\n  let lastErr;\n  for (let attempt = 1; attempt <= attempts; attempt++) {\n    try {\n      return await fn();\n    } catch (err) {\n      lastErr = err;\n      if (attempt === attempts) break;\n\n      const delay = Math.min(baseMs * 2 ** (attempt - 1)\x2C maxMs);\n      logger.warn('Retry'\x2C `[${tag}] Attempt ${attempt}/${attempts} failed: ${err.message}. Retrying in ${delay}ms...`);\n      await new Promise(res => setTimeout(res\x2C delay));\n    }\n  }\n  throw lastErr;\n}\n\nmodule.exports = { withRetry };\n

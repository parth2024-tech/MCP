script-source,363,/home/thor/skiils/tools/server/src/utils/fs-utils.js,const fs = require('fs').promises;\nconst path = require('path');\nconst { warn } = require('./logger');\n\n/**\n * Shared utility to find the main markdown file for a skill directory.\n * @param {string} skillPath The absolute path to the skill directory.\n * @returns {Promise<string|null>} The absolute path to the main markdown file\x2C or null.\n */\nasync function findMainMd(skillPath) {\n  for (const name of ['SKILL.md'\x2C 'README.md']) {\n    const p = path.join(skillPath\x2C name);\n    try {\n      await fs.access(p);\n      return p;\n    } catch (_) {}\n  }\n  \n  try {\n    const files = await fs.readdir(skillPath);\n    for (const f of files) {\n      if (f.endsWith('.md')) return path.join(skillPath\x2C f);\n    }\n  } catch (err) {\n    warn('fs-utils'\x2C `readdir failed for "${skillPath}": ${err.message}`);\n  }\n  \n  return null;\n}\n\n/**\n * Synchronous version to find the main markdown file.\n * @param {string} skillPath The absolute path to the skill directory.\n * @returns {string|null} The absolute path to the main markdown file\x2C or null.\n */\nfunction findMainMdSync(skillPath) {\n  const fsSync = require('fs');\n  for (const name of ['SKILL.md'\x2C 'README.md']) {\n    const p = path.join(skillPath\x2C name);\n    if (fsSync.existsSync(p)) return p;\n  }\n  \n  try {\n    const files = fsSync.readdirSync(skillPath);\n    for (const f of files) {\n      if (f.endsWith('.md')) return path.join(skillPath\x2C f);\n    }\n  } catch (err) {\n    warn('fs-utils'\x2C `readdirSync failed for "${skillPath}": ${err.message}`);\n  }\n  \n  return null;\n}\n\nmodule.exports = {\n  findMainMd\x2C\n  findMainMdSync\n};\n

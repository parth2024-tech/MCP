script-source,350,/home/thor/skiils/tools/server/src/cache.js,const fs = require('fs').promises;\nconst path = require('path');\nconst { LRUCache } = require('lru-cache');\nconst { logAccess\x2C warn } = require('./utils/logger');\nconst { findMainMd } = require('./utils/fs-utils');\nconst metrics = require('./utils/metrics');\n\nconst SKILLS_DIR = path.resolve(__dirname\x2C '../../../');\n\nclass SkillCache {\n  constructor() {\n    this.cache = new LRUCache({\n      max: 50\x2C\n      ttl: 1000 * 60 * 60 * 24 // 24 hours\n    });\n  }\n\n  async getSkillContent(skillName) {\n    if (this.cache.has(skillName)) {\n      const cached = this.cache.get(skillName);\n      if (Date.now() - cached.timestamp > 5000) {\n        try {\n          const stat = await fs.stat(cached.path);\n          if (stat.mtimeMs === cached.mtimeMs) {\n            cached.timestamp = Date.now();\n            metrics.inc('cache_hits');\n            return cached;\n          }\n          // mtime changed \u2014 fall through to re-read\n          metrics.inc('cache_invalidations');\n          this.cache.delete(skillName);\n        } catch (err) {\n          warn('SkillCache'\x2C `mtime check failed for "${skillName}"\x2C evicting: ${err.message}`);\n          metrics.inc('cache_invalidations');\n          this.cache.delete(skillName);\n        }\n      } else {\n        metrics.inc('cache_hits');\n        return cached;\n      }\n    } else {\n      metrics.inc('cache_misses');\n    }\n\n    const skillPath = path.join(SKILLS_DIR\x2C skillName);\n    \n    // Quick existence check\n    try {\n      const stat = await fs.stat(skillPath);\n      if (!stat.isDirectory()) return null;\n    } catch (err) {\n      warn('SkillCache'\x2C `Skill directory not accessible for "${skillName}": ${err.message}`);\n      return null;\n    }\n\n    const mdFile = await findMainMd(skillPath);\n    if (!mdFile) return null;\n\n    try {\n      const stat = await fs.stat(mdFile);\n      const content = await fs.readFile(mdFile\x2C 'utf8');\n      const result = { path: mdFile\x2C content\x2C mtimeMs: stat.mtimeMs\x2C timestamp: Date.now() };\n      this.cache.set(skillName\x2C result);\n      return result;\n    } catch (err) {\n      console.error(`[Cache] Failed to read ${mdFile}: ${err.message}`);\n      return null;\n    }\n  }\n\n}\n\nmodule.exports = SkillCache;\n

# ─────────────────────────────────────────────────────────────────────────────
# ASE MCP Server — Environment Variable Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Neo4j / Knowledge Graph ───────────────────────────────────────────────────
# URI for the Neo4j Bolt/Cypher protocol
NEO4J_URI=neo4j://127.0.0.1:7687

# Neo4j authentication credentials
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_in_production

# ── ASE Paths (XDG-spec compliant) ───────────────────────────────────────────
# Root directory containing skill folders (e.g. /home/user/skiils)
# Defaults to four levels up from ase-mcp-server.js if not set.
# ASE_SKILLS_DIR=/home/user/skiils

# Directory for SQLite database files (skills.db, memory.db)
# Defaults to src/services/ relative to server root if not set.
# ASE_DB_DIR=/home/user/.local/share/ase

# ── Security ─────────────────────────────────────────────────────────────────
# Colon-separated list of directories agents are allowed to read.
# If set, any path outside these dirs will be blocked (fail-closed).
# ASE_ALLOWED_DIRS=/home/user/skiils:/home/user/projects

# Virtual key for MCP gateway authorization (optional)
# MCP_VIRTUAL_KEY=my-agent-key

# ── Runtime ──────────────────────────────────────────────────────────────────
# Set to 'development' to enable hot-reload and relax the Neo4j password guard.
# NODE_ENV=production

# HTTP port when running in --http mode
# ASE_HTTP_PORT=3100

# Observability metrics server port (binds to 127.0.0.1 only)
# ASE_METRICS_PORT=9090

gth === null)\n    throw lazyDOMException('length cannot be null'\x2C 'OperationError');\n\n  if (length % 8) {\n    throw lazyDOMException(\n      'length must be a multiple of 8'\x2C\n      'OperationError');\n  }\n\n  if (length < 32) {\n    throw lazyDOMException(\n      'length must be >= 32'\x2C\n      'OperationError');\n  }\n}\n\nasync function argon2DeriveBits(algorithm\x2C baseKey\x2C length) {\n  validateArgon2DeriveBitsLength(length);\n\n  let result;\n  try {\n    result = await argon2Promise(\n      StringPrototypeToLowerCase(algorithm.name)\x2C\n      {\n        // TODO(panva): call the job directly without needing to re-export the handle\n        message: getCryptoKeyHandle(baseKey).export()\x2C\n        nonce: algorithm.nonce\x2C\n        parallelism: algorithm.parallelism\x2C\n        tagLength: length / 8\x2C\n        memory: algorithm.memory\x2C\n        passes: algorithm.passes\x2C\n        secret: algorithm.secretValue\x2C\n        associatedData: algorithm.associatedData\x2C\n      }\x2C\n    );\n  } catch (err) {\n    throw lazyDOMException(\n      'The operation failed for an operation-specific reason'\x2C\n      { name: 'OperationError'\x2C cause: err });\n  }\n\n  return TypedArrayPrototypeGetBuffer(result);\n}\n\nmodule.exports = {\n  argon2\x2C\n  argon2Sync\x2C\n  argon2DeriveBits\x2C\n  validateArgon2DeriveBitsLength\x2C\n};\n

script-source,202,/home/thor/skiils/tools/server/src/worker.js,const { pipeline } = require('@xenova/transformers');\nconst { validate } = require('./services/output-validator'); // this will need to be refactored to be async if it does I/O\n\nlet embedder = null;\n\nasync function getEmbedder() {\n  if (!embedder) {\n    embedder = await pipeline('feature-extraction'\x2C 'Xenova/all-MiniLM-L6-v2');\n  }\n  return embedder;\n}\n\nmodule.exports = async (task) => {\n  const { type\x2C payload } = task;\n\n  if (type === 'generateEmbedding') {\n    const text = payload.text;\n    const model = await getEmbedder();\n    const result = await model(text\x2C { pooling: 'mean'\x2C normalize: true });\n    // result.data is a Float32Array\x2C convert to standard array to pass back via IPC\n    return Array.from(result.data);\n  }\n\n  if (type === 'validateOutput') {\n    // The validate function currently might do sync I/O.\n    // If it is refactored to async\x2C we'll await it. For now\x2C just call it.\n    // We will refactor output-validator.js next.\n    return await validate(payload.projectDir);\n  }\n\n  throw new Error(`Unknown worker task type: ${type}`);\n};\n

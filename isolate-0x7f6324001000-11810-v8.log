script-source,135,node:internal/process/permission,'use strict';\n\nconst {\n  ArrayPrototypePush\x2C\n  ObjectFreeze\x2C\n} = primordials;\n\nconst permission = internalBinding('permission');\nconst { validateString\x2C validateBuffer } = require('internal/validators');\nconst { Buffer } = require('buffer');\nconst { isBuffer } = Buffer;\n\nlet _permission;\nlet _audit;\nlet _ffi;\n\nmodule.exports = ObjectFreeze({\n  __proto__: null\x2C\n  isEnabled() {\n    if (_permission === undefined) {\n      const { getOptionValue } = require('internal/options');\n      _permission = getOptionValue('--permission') || getOptionValue('--permission-audit');\n    }\n    return _permission;\n  }\x2C\n  isAuditMode() {\n    if (_audit === undefined) {\n      const { getOptionValue } = require('internal/options');\n      _audit = getOptionValue('--permission-audit');\n    }\n    return _audit;\n  }\x2C\n  has(scope\x2C reference) {\n    validateString(scope\x2C 'scope');\n    if (reference != null) {\n      // TODO: add support for WHATWG URLs and Uint8Arrays.\n      if (isBuffer(reference)) {\n        validateBuffer(reference\x2C 'reference');\n      } else {\n        validateString(reference\x2C 'reference');\n      }\n    }\n\n    return permission.has(scope\x2C reference);\n  }\x2C\n  availableFlags() {\n    if (_ffi === undefined) {\n      const { getOptionValue } = require('internal/options');\n      _ffi = getOptionValue('--experimental-ffi');\n    }\n\n    const flags = [\n      '--allow-fs-read'\x2C\n      '--allow-fs-write'\x2C\n      '--allow-addons'\x2C\n      '--allow-child-process'\x2C\n      '--allow-net'\x2C\n      '--allow-inspector'\x2C\n      '--allow-wasi'\x2C\n      '--allow-worker'\x2C\n    ];\n\n    if (_ffi) {\n      ArrayPrototypePush(flags\x2C '--allow-ffi');\n    }\n\n    return flags;\n  }\x2C\n});\n

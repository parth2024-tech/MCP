script-source,348,/home/thor/skiils/tools/server/src/registry.js,const fs = require('fs');\nconst path = require('path');\nconst { logger } = require('./utils/logger');\n\nclass ToolRegistry {\n  constructor() {\n    this.tools = new Map();\n  }\n\n  /**\n   * Dynamically loads all tools from the specified directory.\n   */\n  loadToolsFromDirectory(dirPath\x2C deps = {}) {\n    if (!fs.existsSync(dirPath)) {\n      throw new Error(`Tool directory not found: ${dirPath}`);\n    }\n\n    const files = fs.readdirSync(dirPath);\n    for (const file of files) {\n      if (file.endsWith('.js')) {\n        const toolModule = require(path.join(dirPath\x2C file));\n        \n        let tool;\n        if (typeof toolModule === 'function') {\n          tool = toolModule(deps);\n        } else {\n          tool = toolModule;\n        }\n\n        if (tool && tool.name && tool.handler) {\n          this.register(tool);\n        } else {\n          logger.warn('Registry'\x2C `Skipping invalid tool file: ${file}`);\n        }\n      }\n    }\n  }\n\n  register(tool) {\n    this.tools.set(tool.name\x2C tool);\n  }\n\n  get(name) {\n    return this.tools.get(name);\n  }\n\n  getAll() {\n    return Array.from(this.tools.values());\n  }\n\n  getSchemas() {\n    return this.getAll().map(tool => ({\n      name: tool.name\x2C\n      description: tool.description\x2C\n      inputSchema: tool.inputSchema\n    }));\n  }\n}\n\nmodule.exports = ToolRegistry;\n

script-source,364,/home/thor/skiils/tools/server/src/utils/metrics.js,/**\n * ASE In-Process Metrics Collector\n *\n * Zero-dependency\x2C zero-config metrics store.\n * Exposes counters and histograms that are snapshotted by health://status.\n *\n * Design:\n *   - Counters: atomic increment\x2C keyed by name + optional label\n *   - Histograms: record duration samples\x2C compute p50/p95/p99 on snapshot\n *   - No external agent \u2014 all data lives in memory for the process lifetime\n */\n\n// \u2500\u2500 Counters \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst counters = new Map();\n\n/**\n * Increment a counter.\n * @param {string} name   - Metric name (e.g. 'tool_calls_total')\n * @param {string} [label] - Optional label (e.g. tool name)\n */\nfunction inc(name\x2C label = '') {\n  const key = label ? `${name}{${label}}` : name;\n  counters.set(key\x2C (counters.get(key) || 0) + 1);\n}\n\n/**\n * Read a counter value.\n */\nfunction getCount(name\x2C label = '') {\n  const key = label ? `${name}{${label}}` : name;\n  return counters.get(key) || 0;\n}\n\n// \u2500\u2500 Histograms \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst histograms = new Map();\nconst MAX_SAMPLES = 1000; // cap to avoid unbounded growth\n\n/**\n * Record a duration sample.\n * @param {string} name      - Metric name (e.g. 'tool_call_duration_ms')\n * @param {number} valueMs   - Duration in milliseconds\n * @param {string} [label]   - Optional label\n */\nfunction record(name\x2C valueMs\x2C label = '') {\n  const key = label ? `${name}{${label}}` : name;\n  if (!histograms.has(key)) histograms.set(key\x2C []);\n  const samples = histograms.get(key);\n  samples.push(valueMs);\n  // Evict oldest when over cap (sliding window)\n  if (samples.length > MAX_SAMPLES) samples.shift();\n}\n\n/**\n * Compute percentiles for a histogram.\n * @param {string} name\n * @param {string} [label]\n * @returns {{ count\x2C min\x2C max\x2C p50\x2C p95\x2C p99\x2C avg } | null}\n */\nfunction summarize(name\x2C label = '') {\n  const key = label ? `${name}{${label}}` : name;\n  const samples = histograms.get(key);\n  if (!samples || samples.length === 0) return null;\n\n  const sorted = [...samples].sort((a\x2C b) => a - b);\n  const n = sorted.length;\n  const p = (pct) => sorted[Math.min(Math.floor(n * pct / 100)\x2C n - 1)];\n  const avg = sorted.reduce((s\x2C v) => s + v\x2C 0) / n;\n\n  return {\n    count: n\x2C\n    min: sorted[0]\x2C\n    max: sorted[n - 1]\x2C\n    p50: p(50)\x2C\n    p95: p(95)\x2C\n    p99: p(99)\x2C\n    avg: Math.round(avg)\n  };\n}\n\n// \u2500\u2500 Snapshot \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Returns the full metrics snapshot suitable for health://status.\n */\nfunction snapshot() {\n  const counterSnapshot = {};\n  for (const [key\x2C val] of counters) counterSnapshot[key] = val;\n\n  const histogramSnapshot = {};\n  for (const [key] of histograms) {\n    const name = key.includes('{') ? key.split('{')[0] : key;\n    const label = key.includes('{') ? key.split('{')[1].replace('}'\x2C '') : '';\n    histogramSnapshot[key] = summarize(name\x2C label);\n  }\n\n  return { counters: counterSnapshot\x2C histograms: histogramSnapshot };\n}\n\nmodule.exports = { inc\x2C getCount\x2C record\x2C summarize\x2C snapshot };\n

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["src/**/*", "ase-mcp-server.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}

on the first line\n * @param {boolean} print If the result should be printed\n * @param {import('internal/modules/esm/loader').CJSModule} module The module\n * @param {string} baseUrl Path of the parent importing the module.\n * @param {object} compiledScript The compiled script.\n * @param {any} origModule The original module.\n * @returns {void}\n */\nfunction runScriptInContext(name\x2C body\x2C breakFirstLine\x2C print\x2C module\x2C baseUrl\x2C compiledScript\x2C origModule) {\n  // Create wrapper for cache entry\n  const script = `\n      globalThis.module = module;\n      globalThis.exports = exports;\n      globalThis.__dirname = __dirname;\n      globalThis.require = require;\n      return (main) => main();\n    `;\n  globalThis.__filename = name;\n  RegExpPrototypeExec(/^/\x2C ''); // Necessary to reset RegExp statics before user code runs.\n  const result = module._compile(script\x2C `${name}-wrapper`)(() => {\n    // If the script was already compiled\x2C use it.\n    return runScriptInThisContext(\n      compiledScript ?? compileScript(name\x2C body\x2C baseUrl)\x2C\n      true\x2C !!breakFirstLine);\n  });\n  if (print) {\n    const { log } = require('internal/console/global');\n\n    const printResult = () => log(result);\n\n    process.on('exit'\x2C printResult);\n    process.once('beforeExit'\x2C () => {\n      printResult();\n      process.off('exit'\x2C printResult);\n    });\n  }\n  if (origModule !== undefined)\n    globalThis.module = origModule;\n}\n\nmodule.exports = {\n  parseAndEvalCommonjsTypeScript\x2C\n  parseAndEvalModuleTypeScript\x2C\n  readStdin\x2C\n  tryGetCwd\x2C\n  evalModuleEntryPoint\x2C\n  evalTypeScript\x2C\n  evalScript\x2C\n  onGlobalUncaughtException: createOnGlobalUncaughtException()\x2C\n  setUncaughtExceptionCaptureCallback\x2C\n  addUncaughtExceptionCaptureCallback\x2C\n  hasUncaughtExceptionCaptureCallback\x2C\n};\n

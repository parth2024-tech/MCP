script-source,423,/home/thor/skiils/tools/server/src/tools/query_skills.js,const fs = require('fs');\nconst path = require('path');\nconst { logAccess\x2C warn } = require('../utils/logger');\nconst { selectTopSkills } = require('../services/context-budget');\n\nconst SKILLS_DIR = path.resolve(__dirname\x2C '../../../../');\n\nmodule.exports = (deps) => ({\n  name: 'query_skills'\x2C\n  description: 'Scores ALL skills by relevance to the user request and returns the top-3 most relevant using semantic ranking. Use this to auto-select optimal skills.'\x2C\n  inputSchema: {\n    type: 'object'\x2C\n    properties: {\n      request: {\n        type: 'string'\x2C\n        description: 'The full user request text used to score skill relevance.'\n      }\x2C\n      max_skills: {\n        type: 'number'\x2C\n        description: 'Optional. Hard cap on number of skills returned. Defaults to 3.'\n      }\n    }\x2C\n    required: ['request']\n  }\x2C\n  handler: async (args) => {\n    const maxSkills = args.max_skills || 3;\n\n    // --- Primary path: semantic cosine search ---\n    try {\n      const results = await deps.embeddingService.search(args.request\x2C maxSkills);\n      logAccess('mcp-client'\x2C 'query_skills'\x2C 'authorized'\x2C 0\x2C { selected: results.map(s => s.name)\x2C method: 'semantic' });\n      return {\n        selected: results\x2C\n        totalBudgetTokens: results.reduce((sum\x2C r) => sum + r.tokenEstimate\x2C 0)\x2C\n        budget_status: 'ok'\x2C\n        dropped_count: 0\x2C\n        hard_cap: maxSkills\x2C\n        extraction: { method: 'cosine-similarity' }\n      };\n    } catch (embErr) {\n      warn('query_skills'\x2C `Semantic search unavailable\x2C falling back to TF-IDF: ${embErr.message}`);\n    }\n\n    // --- Fallback path: TF-IDF context budget scorer ---\n    try {\n      let candidates = [];\n      try {\n        candidates = fs.readdirSync(SKILLS_DIR).filter(e =>\n          !e.startsWith('.') && e !== 'tools' && e !== 'docs'\n        );\n      } catch (readErr) {\n        warn('query_skills'\x2C `Cannot read SKILLS_DIR for fallback: ${readErr.message}`);\n        return { error: 'Skill search unavailable \u2014 both semantic and text-based search failed.' };\n      }\n\n      const budget = selectTopSkills(candidates\x2C args.request\x2C maxSkills);\n      logAccess('mcp-client'\x2C 'query_skills'\x2C 'authorized'\x2C 0\x2C { selected: budget.selected.map(s => s.name)\x2C method: 'tfidf-fallback' });\n      return { ...budget\x2C degraded: true\x2C degraded_reason: 'Embedding circuit open \u2014 used TF-IDF fallback' };\n    } catch (fallbackErr) {\n      return { error: `All skill search methods failed: ${fallbackErr.message}` };\n    }\n  }\n});\n

script-source,85,/home/thor/skiils/tools/server/ase-mcp-server.js,const path = require('path');\nconst fs = require('fs').promises;\nconst crypto = require('crypto');\nconst { Server } = require("@modelcontextprotocol/sdk/server/index.js");\nconst { \n  CallToolRequestSchema\x2C \n  ListToolsRequestSchema\x2C\n  ListResourcesRequestSchema\x2C\n  ReadResourceRequestSchema\x2C\n  ListPromptsRequestSchema\x2C\n  GetPromptRequestSchema\x2C\n  PingRequestSchema\n} = require("@modelcontextprotocol/sdk/types.js");\nconst ToolRegistry = require('./src/registry');\nconst SkillCache = require('./src/cache');\nconst EmbeddingService = require('./src/embedding-service');\nconst SessionState = require('./src/services/session-state');\nconst { generateProjectPrompt } = require('./src/services/project-prompt-generator');\nconst { logger\x2C createLogger } = require('./src/utils/logger');\nconst metrics = require('./src/utils/metrics');\n\nconst SKILLS_DIR = path.resolve(__dirname\x2C '../../');\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Parse CLI flags\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst args = process.argv.slice(2);\nconst useHttp = args.includes('--http');\nconst portFlag = args.find((a\x2C i) => args[i - 1] === '--port');\nconst httpPort = portFlag ? parseInt(portFlag\x2C 10) : 3100;\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Initialize Dependencies\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst serverSessionId = crypto.randomUUID();\nconst registry = new ToolRegistry();\nconst skillCache = new SkillCache();\nconst embeddingService = new EmbeddingService();\nconst sessionState = new SessionState(serverSessionId);\n\nconst deps = {\n  skillCache\x2C\n  embeddingService\x2C\n  sessionState\n};\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Initialize the MCP Server\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst server = new Server(\n  {\n    name: "ase-mcp-server"\x2C\n    version: "4.0.0"\n  }\x2C\n  {\n    capabilities: {\n      tools: {}\x2C\n      resources: {}\x2C\n      prompts: {}\x2C\n      logging: {}  // enable logging capability for progress\n    }\n  }\n);\n\n// Load tools into the registry\nconst toolsDir = path.join(__dirname\x2C 'src'\x2C 'tools');\nregistry.loadToolsFromDirectory(toolsDir\x2C deps);\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Register Tool Listing Handler\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nserver.setRequestHandler(ListToolsRequestSchema\x2C async () => {\n  return {\n    tools: registry.getSchemas()\n  };\n});\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Register Tool Call Handler \u2014 passes `extra` for streaming\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nserver.setRequestHandler(CallToolRequestSchema\x2C async (request\x2C extra) => {\n  const { name\x2C arguments: toolArgs } = request.params;\n\n  // Generate a correlation ID for this request \u2014 all logs from this call chain carry it\n  const reqId = crypto.randomUUID();\n  const reqLogger = createLogger(reqId);\n\n  const tool = registry.get(name);\n  if (!tool) {\n    metrics.inc('tool_errors_total'\x2C name);\n    reqLogger.error('ToolDispatch'\x2C `Tool not found: ${name}`);\n    return {\n      content: [{ type: 'text'\x2C text: `Tool not found: ${name}` }]\x2C\n      isError: true\n    };\n  }\n\n  metrics.inc('tool_calls_total'\x2C name);\n  const startMs = Date.now();\n\n  try {\n    // Inject req_id logger into extra so tool handlers can use it\n    const enrichedExtra = { ...(extra || {})\x2C reqId\x2C reqLogger };\n    const result = await tool.handler(toolArgs || {}\x2C enrichedExtra);\n    const durationMs = Date.now() - startMs;\n\n    metrics.record('tool_call_duration_ms'\x2C durationMs\x2C name);\n    reqLogger.toolResult(name\x2C durationMs\x2C true\x2C { tool: name });\n\n    return {\n      content: [{ type: 'text'\x2C text: JSON.stringify(result\x2C null\x2C 2) }]\n    };\n  } catch (err) {\n    const durationMs = Date.now() - startMs;\n    metrics.inc('tool_errors_total'\x2C name);\n    metrics.record('tool_call_duration_ms'\x2C durationMs\x2C name);\n    reqLogger.toolResult(name\x2C durationMs\x2C false\x2C { tool: name\x2C error: err.message });\n\n    return {\n      content: [{ type: 'text'\x2C text: JSON.stringify({ error: err.message\x2C req_id: reqId }) }]\x2C\n      isError: true\n    };\n  }\n});\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Register Resource Handlers\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nserver.setRequestHandler(ListResourcesRequestSchema\x2C async () => {\n  const resources = [\n    {\n      uri: 'health://status'\x2C\n      name: 'Server Health'\x2C\n      description: 'Live health status: circuit breaker state\x2C DB integrity\x2C skill count\x2C uptime.'\n    }\n  ];\n  try {\n    const entries = await fs.readdir(SKILLS_DIR\x2C { withFileTypes: true });\n    for (const dirent of entries) {\n      if (dirent.isDirectory() && !dirent.name.startsWith('.') && dirent.name !== 'tools' && dirent.name !== 'docs') {\n        resources.push({\n          uri: `skill://${dirent.name}`\x2C\n          name: dirent.name\x2C\n          description: `Instruction set for ${dirent.name}`\n        });\n      }\n    }\n  } catch (err) {\n    console.error('Failed to read skills directory for resources:'\x2C err);\n  }\n  return { resources };\n});\n\nserver.setRequestHandler(ReadResourceRequestSchema\x2C async (request) => {\n  const uri = request.params.uri;\n\n  // \u2500\u2500 health://status \u2500\u2500\n  if (uri === 'health://status') {\n    const health = embeddingService.healthSnapshot;\n    const metricsSnapshot = metrics.snapshot();\n    const status = {\n      server: 'ase-mcp-server'\x2C\n      version: '4.0.0'\x2C\n      uptime_seconds: Math.floor(process.uptime())\x2C\n      memory_mb: Math.round(process.memoryUsage().heapUsed / 1024 / 1024)\x2C\n      embedding_circuit: health.embedding_circuit\x2C\n      skills_indexed: health.skills_indexed\x2C\n      last_sync: health.last_sync\x2C\n      db_ok: health.skills_indexed >= 0\x2C\n      metrics: metricsSnapshot\n    };\n    return {\n      contents: [{\n        uri\x2C\n        mimeType: 'application/json'\x2C\n        text: JSON.stringify(status\x2C null\x2C 2)\n      }]\n    };\n  }\n\n  // \u2500\u2500 skill://{name} \u2500\u2500\n  if (uri.startsWith('skill://')) {\n    const name = uri.substring(8);\n    const skillData = await skillCache.getSkillContent(name);\n    if (!skillData) {\n      throw new Error(`Resource not found: ${uri}`);\n    }\n    return {\n      contents: [{\n        uri\x2C\n        mimeType: 'text/markdown'\x2C\n        text: skillData.content\n      }]\n    };\n  }\n\n  throw new Error(`Unknown resource URI scheme: ${uri}`);\n});\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Register Prompts Handlers\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nserver.setRequestHandler(ListPromptsRequestSchema\x2C async () => {\n  return {\n    prompts: [\n      {\n        name: "project_prompt"\x2C\n        description: "Generates the structured system prompt based on the active .ase-project.json configuration."\x2C\n        arguments: [\n          {\n            name: "project_dir"\x2C\n            description: "Optional. Absolute path to the project root. Defaults to current working directory."\x2C\n            required: false\n          }\n        ]\n      }\n    ]\n  };\n});\n\nserver.setRequestHandler(GetPromptRequestSchema\x2C async (request) => {\n  if (request.params.name === 'project_prompt') {\n    const dir = request.params.arguments?.project_dir || process.cwd();\n    const promptData = await generateProjectPrompt(dir);\n    \n    if (promptData.error) {\n      throw new Error(`Failed to generate prompt: ${promptData.error}`);\n    }\n    \n    return {\n      description: "ASE Project System Prompt"\x2C\n      messages: [\n        {\n          role: "user"\x2C\n          content: {\n            type: "text"\x2C\n            text: promptData.prompt\n          }\n        }\n      ]\n    };\n  }\n  throw new Error(`Unknown prompt: ${request.params.name}`);\n});\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Register Ping Handler\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nserver.setRequestHandler(PingRequestSchema\x2C async () => {\n  return {};\n});\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Start background embedding sync\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nembeddingService.syncSkillsBackground().catch(err => {\n  logger.error('Server'\x2C `Background embedding sync failed: ${err.message}`);\n});\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Connect transport (stdio or HTTP)\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nif (useHttp) {\n  // HTTP mode with Keep-Alive and SSE streaming\n  const { startHttpTransport } = require('./src/transports/http-keepalive');\n  startHttpTransport(server\x2C httpPort).catch(err => {\n    logger.error('Transport'\x2C `Fatal: Failed to start HTTP transport: ${err.message}`);\n    process.exit(1);\n  });\n} else {\n  // Default: stdio mode with buffered writes\n  const { BufferedStdioTransport } = require('./src/transports/buffered-stdio');\n  const transport = new BufferedStdioTransport();\n  server.connect(transport).catch(err => {\n    logger.error('Transport'\x2C `Fatal: Failed to connect StdioServerTransport: ${err.message}`);\n    process.exit(1);\n  });\n}\n

script-source,125,node:internal/modules/typescript,'use strict';\n\nconst {\n  ObjectPrototypeHasOwnProperty\x2C\n} = primordials;\nconst {\n  validateOneOf\x2C\n  validateObject\x2C\n  validateString\x2C\n} = require('internal/validators');\nconst { assertTypeScript\x2C\n        emitExperimentalWarning\x2C\n        getLazy\x2C\n        isUnderNodeModules\x2C\n        kEmptyObject } = require('internal/util');\nconst {\n  ERR_INVALID_TYPESCRIPT_SYNTAX\x2C\n  ERR_UNSUPPORTED_NODE_MODULES_TYPE_STRIPPING\x2C\n  ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX\x2C\n} = require('internal/errors').codes;\nconst { getOptionValue } = require('internal/options');\nconst assert = require('internal/assert');\nconst { Buffer } = require('buffer');\nconst {\n  getCompileCacheEntry\x2C\n  saveCompileCacheEntry\x2C\n  cachedCodeTypes: { kStrippedTypeScript }\x2C\n} = internalBinding('modules');\n\n\n/**\n * Load the TypeScript parser.\n * and returns an object with a `code` property.\n * @returns {Function} The TypeScript parser function.\n */\nconst loadTypeScriptParser = getLazy(() => {\n  assertTypeScript();\n  const amaro = require('internal/deps/amaro/dist/index');\n  return amaro.transformSync;\n});\n\n/**\n *\n * @param {string} source the source code\n * @param {object} options the options to pass to the parser\n * @returns {TransformOutput} an object with a `code` property.\n */\nfunction parseTypeScript(source\x2C options) {\n  const parse = loadTypeScriptParser();\n  try {\n    return parse(source\x2C options);\n  } catch (error) {\n    /**\n     * Amaro v0.3.0 (from SWC v1.10.7) throws an object with `message` and `code` properties.\n     * It allows us to distinguish between invalid syntax and unsupported syntax.\n     */\n    switch (error?.code) {\n      case 'UnsupportedSyntax': {\n        const unsupportedSyntaxError = new ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX(error.message);\n        throw decorateErrorWithSnippet(unsupportedSyntaxError\x2C error); /* node-do-not-add-exception-line
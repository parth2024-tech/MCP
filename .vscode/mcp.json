{
  "servers": {
    "ase": {
      "type": "stdio",
      "command": "${userHome}/.local/bin/mcp-compressor",
      "args": ["--compression-level", "medium", "npx", "tsx", "${workspaceFolder}/ase-mcp-server.ts"]
    },
    "toonify": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "toonify-mcp"]
    }
  }
}

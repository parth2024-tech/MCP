script-source,422,/home/thor/skiils/tools/server/src/tools/log_skill_step.js,module.exports = (deps) => ({\n  name: 'log_skill_step'\x2C\n  description: 'Records the AI\\'s progression through a skill by logging the status of a specific step.'\x2C\n  inputSchema: {\n    type: 'object'\x2C\n    properties: {\n      skill_name: {\n        type: 'string'\x2C\n        description: 'The exact folder/slug name of the skill being executed (e.g. "test-driven-development").'\n      }\x2C\n      step_id: {\n        type: 'string'\x2C\n        description: 'The unique step identifier extracted from the skill markdown (e.g. "tdd/write-failing-test").'\n      }\x2C\n      status: {\n        type: 'string'\x2C\n        enum: ['started'\x2C 'completed'\x2C 'skipped'\x2C 'blocked'\x2C 'failed']\x2C\n        description: 'The current state of the step.'\n      }\x2C\n      context: {\n        type: 'string'\x2C\n        description: 'Optional. A short string to record why a step was skipped\x2C what it found\x2C or error context.'\n      }\n    }\x2C\n    required: ['skill_name'\x2C 'step_id'\x2C 'status']\n  }\x2C\n  handler: async (args) => {\n    const { skill_name\x2C step_id\x2C status\x2C context } = args;\n\n    if (!deps.sessionState) {\n      return { error: 'Session state manager is not initialized.' };\n    }\n\n    try {\n      deps.sessionState.logStep(skill_name\x2C step_id\x2C status\x2C context);\n      return { success: true\x2C message: `Successfully logged step ${step_id} as ${status}.` };\n    } catch (err) {\n      return { error: `Failed to log step: ${err.message}` };\n    }\n  }\n});\n

script-source,421,/home/thor/skiils/tools/server/src/tools/load_skill.js,const fs = require('fs');\nconst path = require('path');\nconst crypto = require('crypto');\nconst { logAccess } = require('../utils/logger');\n\nconst SKILLS_DIR = path.resolve(__dirname\x2C '../../../../');\nconst AUTH_FILE = '/home/thor/.agents/auth.json';\n\n// Load authentication registry\nlet authRegistry = { tokens: {} };\nif (fs.existsSync(AUTH_FILE)) {\n  try {\n    authRegistry = JSON.parse(fs.readFileSync(AUTH_FILE\x2C 'utf8'));\n  } catch (err) {\n    console.error(`ASE MCP Server: Failed to parse auth.json: ${err.message}`);\n  }\n}\n\n// Map skill risk to required security tier\nfunction getRequiredTier(skillName\x2C skillContent) {\n  let risk = 'unknown';\n  if (skillContent.startsWith('---')) {\n    const fmEnd = skillContent.indexOf('---'\x2C 3);\n    if (fmEnd !== -1) {\n      const fm = skillContent.substring(3\x2C fmEnd);\n      const riskMatch = fm.match(/^risk:\\s*(.*)/m);\n      if (riskMatch) {\n        risk = riskMatch[1].trim();\n      }\n    }\n  }\n\n  // Tier rules\n  if (risk === 'none' || risk === 'safe') {\n    return 'Level 1'; // Open to all standard users\n  } else if (risk === 'unknown') {\n    return 'Level 2'; // Requires Developer tier\n  } else if (risk === 'critical' || risk === 'offensive') {\n    return 'Level 3'; // Requires Security Auditor tier\n  }\n  return 'Level 3'; // Default to max protection\n}\n\nfunction resolveUserTier(token) {\n  // Check env override first\n  if (process.env.ASE_AUTH_TOKEN && token && token.length === process.env.ASE_AUTH_TOKEN.length) {\n    if (crypto.timingSafeEqual(Buffer.from(token)\x2C Buffer.from(process.env.ASE_AUTH_TOKEN))) {\n      return 'Level 3'; // Environment override grants Level 3\n    }\n  }\n  \n  const client = authRegistry.tokens[token];\n  if (client) {\n    return client.tier; // Level 2 or Level 3\n  }\n  return 'Level 1'; // No token / invalid token resolves to Level 1\n}\n\nfunction hasAccess(userTier\x2C requiredTier) {\n  const tierWeights = { 'Level 1': 1\x2C 'Level 2': 2\x2C 'Level 3': 3 };\n  const userWeight = tierWeights[userTier] || 1;\n  const requiredWeight = tierWeights[requiredTier] || 1;\n  return userWeight >= requiredWeight;\n}\n\nmodule.exports = (deps) => ({\n  name: 'load_skill'\x2C\n  description: 'Loads the full instruction set of a specific skill\x2C enforcing strict role-based access security tiers.'\x2C\n  inputSchema: {\n    type: 'object'\x2C\n    properties: {\n      skill_name: {\n        type: 'string'\x2C\n        description: 'The exact folder/slug name of the skill to load (e.g. "aws-serverless").'\n      }\x2C\n      auth_token: {\n        type: 'string'\x2C\n        description: 'Optional. The auth token used to unlock elevated (Level 2) and protected (Level 3) security tiers.'\n      }\n    }\x2C\n    required: ['skill_name']\n  }\x2C\n  handler: async (args) => {\n    const { skill_name\x2C auth_token } = args;\n    const startTime = Date.now();\n    \n    // Prevent path traversal\n    if (!skill_name || typeof skill_name !== 'string' || skill_name.includes('/') || skill_name.includes('\\\\') || skill_name.includes('..')) {\n      return { error: 'Invalid skill name. Path traversal characters are not allowed.' };\n    }\n    \n    const skillData = await deps.skillCache.getSkillContent(skill_name);\n\n    if (!skillData) {\n      logAccess('mcp-client'\x2C skill_name\x2C 'not_found'\x2C Date.now() - startTime);\n      return { error: `Skill "${skill_name}" does not exist in local registry or has no markdown file.` };\n    }\n\n    const content = skillData.content;\n    const mdFile = skillData.path;\n\n    // Enforce Access Control boundaries (RBAC)\n    const requiredTier = getRequiredTier(skill_name\x2C content);\n    const userTier = resolveUserTier(auth_token);\n    \n    if (!hasAccess(userTier\x2C requiredTier)) {\n      logAccess('mcp-client'\x2C skill_name\x2C 'denied'\x2C Date.now() - startTime\x2C { required_tier: requiredTier\x2C user_tier: userTier });\n      return { \n        error: `Access Denied! Skill "${skill_name}" requires "${requiredTier}" credentials. Your current access level is "${userTier}". Please provide a valid auth_token in the request parameters to unlock.` \n      };\n    }\n\n    logAccess('mcp-client'\x2C skill_name\x2C 'authorized'\x2C Date.now() - startTime\x2C { required_tier: requiredTier\x2C user_tier: userTier });\n    \n    // Parse step IDs and initialize telemetry\n    const stepIds = [];\n    const stepRegex = /<!--\\s*step_id:\\s*([^\\s>]+)\\s*-->/g;\n    let match;\n    while ((match = stepRegex.exec(content)) !== null) {\n      stepIds.push(match[1]);\n    }\n    \n    if (deps.sessionState && stepIds.length > 0) {\n      try {\n        deps.sessionState.initSkill(skill_name\x2C stepIds);\n      } catch (err) {\n        console.error(`ASE MCP Server: Failed to init skill session state: ${err.message}`);\n      }\n    }\n\n    return { \n      skill_name: skill_name\x2C \n      path: mdFile\x2C\n      required_tier: requiredTier\x2C\n      content: content \n    };\n  }\n});\n

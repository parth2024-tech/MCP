script-source,365,/home/thor/skiils/tools/server/src/embedding-service.js,const fs = require('fs').promises;\nconst path = require('path');\nconst crypto = require('crypto');\nconst Database = require('better-sqlite3');\nconst workerPool = require('./worker-pool');\nconst { parseFrontmatter } = require('./services/context-budget');\nconst { findMainMd } = require('./utils/fs-utils');\nconst { withRetry } = require('./utils/retry');\nconst { warn\x2C logger } = require('./utils/logger');\nconst metrics = require('./utils/metrics');\n\nconst SKILLS_DIR = path.resolve(__dirname\x2C '../../../');\nconst DB_PATH = path.join(__dirname\x2C 'skills.db');\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Circuit Breaker\n// States: CLOSED (normal) \u2192 OPEN (failing) \u2192 HALF_OPEN (probe)\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nclass CircuitBreaker {\n  constructor({ failureThreshold = 3\x2C recoveryMs = 60000 } = {}) {\n    this.failureThreshold = failureThreshold;\n    this.recoveryMs = recoveryMs;\n    this.failureCount = 0;\n    this.state = 'CLOSED';\n    this.openedAt = null;\n  }\n\n  get status() {\n    return {\n      state: this.state\x2C\n      failureCount: this.failureCount\x2C\n      openedAt: this.openedAt ? new Date(this.openedAt).toISOString() : null\n    };\n  }\n\n  async call(fn) {\n    if (this.state === 'OPEN') {\n      if (Date.now() - this.openedAt >= this.recoveryMs) {\n        this.state = 'HALF_OPEN';\n      } else {\n        throw new Error('CircuitBreaker OPEN \u2014 embedding worker unavailable');\n      }\n    }\n\n    try {\n      const result = await fn();\n      this._onSuccess();\n      return result;\n    } catch (err) {\n      this._onFailure(err);\n      throw err;\n    }\n  }\n\n  _onSuccess() {\n    this.failureCount = 0;\n    this.state = 'CLOSED';\n    this.openedAt = null;\n  }\n\n  _onFailure(err) {\n    this.failureCount++;\n    if (this.failureCount >= this.failureThreshold) {\n      this.state = 'OPEN';\n      this.openedAt = Date.now();\n      warn('CircuitBreaker'\x2C `Embedding worker circuit OPENED after ${this.failureCount} failures. Will retry in ${this.recoveryMs / 1000}s.`\x2C { error: err.message });\n    }\n  }\n}\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// EmbeddingService\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nclass EmbeddingService {\n  constructor() {\n    this.db = new Database(DB_PATH);\n    this.db.pragma('journal_mode = WAL');\n    this._cachedIndex = null;\n    this._lastSyncAt = null;\n    this._breaker = new CircuitBreaker({ failureThreshold: 3\x2C recoveryMs: 60000 });\n    this._initDb();\n  }\n\n  _initDb() {\n    this.db.exec(`\n      CREATE TABLE IF NOT EXISTS skills (\n        name TEXT PRIMARY KEY\x2C\n        description TEXT\x2C\n        embedding BLOB\x2C\n        tokenEstimate INTEGER\x2C\n        hash TEXT\n      )\n    `);\n  }\n\n  _computeHash(content) {\n    return crypto.createHash('md5').update(content).digest('hex');\n  }\n\n  /** Health snapshot exposed to health://status resource */\n  get healthSnapshot() {\n    const count = this.db.prepare('SELECT COUNT(*) as c FROM skills').get();\n    return {\n      embedding_circuit: this._breaker.status\x2C\n      skills_indexed: count ? count.c : 0\x2C\n      last_sync: this._lastSyncAt\n    };\n  }\n\n  async syncSkillsBackground() {\n    let files;\n    try {\n      files = await fs.readdir(SKILLS_DIR);\n    } catch (err) {\n      warn('EmbeddingService'\x2C `Cannot read SKILLS_DIR: ${err.message}`\x2C { path: SKILLS_DIR });\n      return;\n    }\n\n    let cacheInvalidated = false;\n    const tasks = [];\n\n    for (const entry of files) {\n      if (entry.startsWith('.') || entry === 'tools' || entry === 'docs') continue;\n\n      let stat;\n      try {\n        stat = await fs.stat(path.join(SKILLS_DIR\x2C entry));\n      } catch (err) {\n        warn('EmbeddingService'\x2C `stat failed for entry "${entry}": ${err.message}`);\n        continue;\n      }\n      if (!stat.isDirectory()) continue;\n      tasks.push({ entry\x2C skillPath: path.join(SKILLS_DIR\x2C entry) });\n    }\n\n    const CONCURRENCY_LIMIT = 5;\n    for (let i = 0; i < tasks.length; i += CONCURRENCY_LIMIT) {\n      const chunk = tasks.slice(i\x2C i + CONCURRENCY_LIMIT);\n\n      await Promise.all(chunk.map(async ({ entry\x2C skillPath }) => {\n        let mdFile;\n        try {\n          mdFile = await findMainMd(skillPath);\n        } catch (err) {\n          warn('EmbeddingService'\x2C `findMainMd failed for "${entry}": ${err.message}`);\n          return;\n        }\n        if (!mdFile) return;\n\n        let content;\n        try {\n          content = await fs.readFile(mdFile\x2C 'utf8');\n        } catch (err) {\n          warn('EmbeddingService'\x2C `readFile failed for "${mdFile}": ${err.message}`);\n          return;\n        }\n\n        const hash = this._computeHash(content);\n        const existing = this.db.prepare('SELECT hash FROM skills WHERE name = ?').get(entry);\n        if (existing && existing.hash === hash) return;\n\n        const fm = parseFrontmatter(content);\n        const desc = (fm && fm.description) ? fm.description : '';\n        const tokenEstimate = Math.ceil(content.length / 4);\n        const textToEmbed = desc || content.substring(0\x2C 800);\n\n        let embeddingArray;\n        try {\n          embeddingArray = await withRetry(\n            () => this._breaker.call(() => workerPool.generateEmbedding(textToEmbed))\x2C\n            { attempts: 3\x2C baseMs: 300\x2C tag: `Embeddings/${entry}` }\n          );\n        } catch (err) {\n          warn('EmbeddingService'\x2C `Embedding generation failed for "${entry}" after retries: ${err.message}`);\n          return; // skip this skill\x2C try again next sync\n        }\n\n        const embeddingBlob = Buffer.from(new Float32Array(embeddingArray).buffer);\n        this.db.prepare(`\n          INSERT INTO skills (name\x2C description\x2C embedding\x2C tokenEstimate\x2C hash)\n          VALUES (@name\x2C @desc\x2C @emb\x2C @tokens\x2C @hash)\n          ON CONFLICT(name) DO UPDATE SET\n            description = excluded.description\x2C\n            embedding = excluded.embedding\x2C\n            tokenEstimate = excluded.tokenEstimate\x2C\n            hash = excluded.hash\n        `).run({ name: entry\x2C desc\x2C emb: embeddingBlob\x2C tokens: tokenEstimate\x2C hash });\n\n        cacheInvalidated = true;\n        logger.info('EmbeddingService'\x2C `Updated: ${entry}`);\n      }));\n    }\n\n    if (cacheInvalidated) {\n      this._cachedIndex = null;\n    }\n\n    // Checkpoint WAL after every sync to prevent unbounded WAL growth\n    try {\n      this.db.pragma('wal_checkpoint(TRUNCATE)');\n    } catch (err) {\n      warn('EmbeddingService'\x2C `WAL checkpoint failed: ${err.message}`);\n    }\n\n    this._lastSyncAt = new Date().toISOString();\n    logger.info('EmbeddingService'\x2C 'Sync complete.');\n  }\n\n  async search(query\x2C limit = 3) {\n    const startMs = Date.now();\n    metrics.inc('embedding_searches');\n\n    let queryEmbedding;\n    try {\n      queryEmbedding = await withRetry(\n        () => this._breaker.call(() => workerPool.generateEmbedding(query))\x2C\n        { attempts: 2\x2C baseMs: 200\x2C tag: 'Embeddings/search' }\n      );\n    } catch (err) {\n      // Circuit is OPEN or retries exhausted \u2014 bubble up so query_skills can fall back\n      throw new Error(`Embedding search unavailable: ${err.message}`);\n    }\n\n    if (!this._cachedIndex) {\n      this._cachedIndex = this.db.prepare('SELECT name\x2C description\x2C embedding\x2C tokenEstimate FROM skills').all();\n    }\n    const rows = this._cachedIndex;\n\n    const scored = rows.map(row => {\n      const embBuffer = row.embedding;\n      const embArray = new Float32Array(embBuffer.buffer\x2C embBuffer.byteOffset\x2C embBuffer.byteLength / 4);\n\n      let score = 0;\n      for (let i = 0; i < embArray.length; i++) {\n        score += embArray[i] * queryEmbedding[i];\n      }\n\n      return {\n        name: row.name\x2C\n        score\x2C\n        tokenEstimate: row.tokenEstimate\x2C\n        description: row.description\n      };\n    });\n\n    scored.sort((a\x2C b) => b.score - a.score);\n    \n    metrics.record('embedding_search_duration_ms'\x2C Date.now() - startMs);\n    return scored.slice(0\x2C limit);\n  }\n}\n\nmodule.exports = EmbeddingService;\n

 nanoid: "nanoid"\x2C\n        guid: "GUID"\x2C\n        cuid: "cuid"\x2C\n        cuid2: "cuid2"\x2C\n        ulid: "ULID"\x2C\n        xid: "XID"\x2C\n        ksuid: "KSUID"\x2C\n        datetime: "data i hora ISO"\x2C\n        date: "data ISO"\x2C\n        time: "hora ISO"\x2C\n        duration: "durada ISO"\x2C\n        ipv4: "adre\xe7a IPv4"\x2C\n        ipv6: "adre\xe7a IPv6"\x2C\n        cidrv4: "rang IPv4"\x2C\n        cidrv6: "rang IPv6"\x2C\n        base64: "cadena codificada en base64"\x2C\n        base64url: "cadena codificada en base64url"\x2C\n        json_string: "cadena JSON"\x2C\n        e164: "n\xfamero E.164"\x2C\n        jwt: "JWT"\x2C\n        template_literal: "entrada"\x2C\n    };\n    const TypeDictionary = {\n        nan: "NaN"\x2C\n    };\n    return (issue) => {\n        switch (issue.code) {\n            case "invalid_type": {\n                const expected = TypeDictionary[issue.expected] ?? issue.expected;\n                const receivedType = util.parsedType(issue.input);\n                const received = TypeDictionary[receivedType] ?? receivedType;\n                if (/^[A-Z]/.test(issue.expected)) {\n                    return `Tipus inv\xe0lid: s'esperava instanceof ${issue.expected}\x2C s'ha rebut ${received}`;\n                }\n                return `Tipus inv\xe0lid: s'esperava ${expected}\x2C s'ha rebut ${received}`;\n            }\n            case "invalid_value":\n                if (issue.values.length === 1)\n                    return `Valor inv\xe0lid: s'esperava ${util.stringifyPrimitive(issue.values[0])}`;\n                return `Opci\xf3 inv\xe0lida: s'esperava una de ${util.joinValues(issue.values\x2C " o ")}`;\n            case "too_big": {\n                const adj = issue.inclusive ? "com a m\xe0xim" : "menys de";\n                const sizing = getSizing(issue.origin);\n                if (sizing)\n                    return `Massa gran: s'esperava que ${issue.origin ?? "el valor"} contingu\xe9s ${adj} ${i
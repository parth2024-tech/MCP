script-source,413,/home/thor/skiils/tools/server/src/services/project-prompt-generator.js,/**\n * ASE Project System Prompt Generator v2\n *\n * Reads .ase-project.json from the project root (with upward directory walk)\n * and generates a structured system prompt that the AI sees before any skill.\n *\n * v2 improvements:\n *   - Strict schema validation with typed fields and clear error messages\n *   - Extended schema: sprint_focus\x2C file_structure\x2C testing_strategy\x2C deployment\n *   - Validation report alongside the prompt so the user knows if their config is broken\n *   - Token accounting so the caller knows the prompt cost\n */\n\nconst fs = require('fs').promises;\nconst path = require('path');\n\nconst PROJECT_CONFIG_FILE = '.ase-project.json';\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Schema definition \u2014 every field\x2C its type\x2C and whether it's required\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst SCHEMA = {\n  name:                  { type: 'string'\x2C   required: true\x2C  description: 'Project name (e.g. "my-saas-app")' }\x2C\n  version:               { type: 'string'\x2C   required: false\x2C description: 'Semantic version (e.g. "1.2.0")' }\x2C\n  description:           { type: 'string'\x2C   required: true\x2C  description: 'One-paragraph project description' }\x2C\n  tech_stack:            { type: 'array'\x2C    required: true\x2C  description: 'Array of strings \u2014 each technology and its version' }\x2C\n  conventions:           { type: 'array'\x2C    required: true\x2C  description: 'Array of coding convention strings' }\x2C\n  architecture_patterns: { type: 'array'\x2C    required: false\x2C description: 'Array of architecture pattern strings in use' }\x2C\n  file_structure:        { type: 'object'\x2C   required: false\x2C description: 'Map of directory \u2192 purpose (e.g. {"src/lib": "shared utilities"})' }\x2C\n  testing_strategy:      { type: 'object'\x2C   required: false\x2C description: 'Testing config: {framework\x2C coverage_target\x2C patterns}' }\x2C\n  deployment:            { type: 'object'\x2C   required: false\x2C description: 'Deployment config: {platform\x2C branch_strategy\x2C environments}' }\x2C\n  sprint_focus:          { type: 'string'\x2C   required: false\x2C description: 'Current sprint goal \u2014 guides the AI to prioritize relevant work' }\x2C\n  sprint_skills:         { type: 'array'\x2C    required: false\x2C description: 'Array of Agent Skills Pack skills relevant to the current sprint' }\x2C\n  never_do:              { type: 'array'\x2C    required: true\x2C  description: 'Array of hard constraint strings \u2014 the AI must NEVER violate these' }\x2C\n  preferred_patterns:    { type: 'array'\x2C    required: false\x2C description: 'Array of preferred pattern strings \u2014 the AI should PREFER these' }\x2C\n  agent_skills:          { type: 'object'\x2C   required: false\x2C description: 'Agent Skills Pack configuration and reporting preferences' }\n};\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Schema validation\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Validates a parsed config object against the schema.\n * Returns { valid: boolean\x2C errors: string[]\x2C warnings: string[] }\n */\nfunction validateConfig(config) {\n  const errors = [];\n  const warnings = [];\n\n  for (const [field\x2C rule] of Object.entries(SCHEMA)) {\n    const value = config[field];\n\n    if (rule.required && (value === undefined || value === null || value === '')) {\n      errors.push(`Missing required field "${field}": ${rule.description}`);\n      continue;\n    }\n\n    if (value === undefined || value === null) continue;\n\n    // Type check\n    if (rule.type === 'string' && typeof value !== 'string') {\n      errors.push(`"${field}" must be a string\x2C got ${typeof value}`);\n    }\n    if (rule.type === 'array' && !Array.isArray(value)) {\n      errors.push(`"${field}" must be an array\x2C got ${typeof value}`);\n    } else if (rule.type === 'array' && Array.isArray(value) && value.length === 0) {\n      warnings.push(`"${field}" is an empty array \u2014 consider populating it`);\n    }\n    if (rule.type === 'object' && (typeof value !== 'object' || Array.isArray(value))) {\n      errors.push(`"${field}" must be an object\x2C got ${Array.isArray(value) ? 'array' : typeof value}`);\n    }\n  }\n\n  // Warn about unrecognized fields (possible typos)\n  for (const key of Object.keys(config)) {\n    if (key.startsWith('_')) continue; // _meta fields are intentionally ignored\n    if (!SCHEMA[key]) {\n      warnings.push(`Unrecognized field "${key}" \u2014 check for typos (valid fields: ${Object.keys(SCHEMA).join('\x2C ')})`);\n    }\n  }\n\n  return {\n    valid: errors.length === 0\x2C\n    errors\x2C\n    warnings\n  };\n}\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Directory walker \u2014 find .ase-project.json\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function findProjectConfig(startDir) {\n  let dir = startDir || process.cwd();\n  const root = path.parse(dir).root;\n\n  while (dir !== root) {\n    const candidate = path.join(dir\x2C PROJECT_CONFIG_FILE);\n    try {\n      await fs.access(candidate);\n      return candidate;\n    } catch (_) {\n      // not found\n    }\n    dir = path.dirname(dir);\n  }\n  return null;\n}\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Prompt generation \u2014 structured markdown output\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Generates a structured system prompt from the project config.\n *\n * @param {string} projectDir - Project root directory\n * @returns {{\n *   config_path: string\x2C\n *   project_name: string\x2C\n *   prompt: string\x2C\n *   prompt_token_estimate: number\x2C\n *   validation: { valid\x2C errors\x2C warnings }\n * } | { error: string\x2C template: object }}\n */\nasync function generateProjectPrompt(projectDir) {\n  const configPath = await findProjectConfig(projectDir || process.cwd());\n\n  if (!configPath) {\n    return {\n      error: `No ${PROJECT_CONFIG_FILE} found. Create one in your project root.`\x2C\n      hint: 'Run "ase-init" in your project directory to auto-generate one.'\x2C\n      template: getConfigTemplate()\n    };\n  }\n\n  let raw;\n  try {\n    raw = await fs.readFile(configPath\x2C 'utf8');\n  } catch (err) {\n    return { error: `Cannot read ${configPath}: ${err.message}` };\n  }\n\n  let config;\n  try {\n    config = JSON.parse(raw);\n  } catch (err) {\n    return { error: `Invalid JSON in ${configPath}: ${err.message}` };\n  }\n\n  // Validate against schema\n  const validation = validateConfig(config);\n\n  // Generate the prompt even if there are warnings (but not if there are errors)\n  if (!validation.valid) {\n    return {\n      error: `Schema validation failed for ${configPath}`\x2C\n      validation\x2C\n      hint: 'Fix the errors above\x2C then retry.'\n    };\n  }\n\n  // \u2500\u2500 Build the system prompt \u2500\u2500\n  const lines = [];\n\n  lines.push(`# Project: ${config.name}`);\n  if (config.version) lines.push(`Version: ${config.version}`);\n  lines.push('');\n\n  // Sprint focus (top of prompt \u2014 most contextually important)\n  if (config.sprint_focus) {\n    lines.push('## \ud83c\udfaf Current Sprint Focus');\n    lines.push(`> ${config.sprint_focus}`);\n    if (config.sprint_skills && config.sprint_skills.length) {\n      lines.push('');\n      lines.push(`**Relevant Sprint Skills**: ${config.sprint_skills.join('\x2C ')}`);\n    }\n    lines.push('');\n  }\n\n  lines.push('## Description');\n  lines.push(config.description);\n  lines.push('');\n\n  // Tech Stack\n  lines.push('## Tech Stack');\n  for (const tech of config.tech_stack) {\n    lines.push(`- ${tech}`);\n  }\n  lines.push('');\n\n  // Conventions\n  lines.push('## Coding Conventions');\n  for (const conv of config.conventions) {\n    lines.push(`- ${conv}`);\n  }\n  lines.push('');\n\n  // Architecture\n  if (config.architecture_patterns && config.architecture_patterns.length) {\n    lines.push('## Architecture Patterns');\n    for (const pattern of config.architecture_patterns) {\n      lines.push(`- ${pattern}`);\n    }\n    lines.push('');\n  }\n\n  // File Structure\n  if (config.file_structure && typeof config.file_structure === 'object') {\n    lines.push('## File Structure');\n    for (const [dir\x2C purpose] of Object.entries(config.file_structure)) {\n      lines.push(`- \\`${dir}/\\` \u2014 ${purpose}`);\n    }\n    lines.push('');\n  }\n\n  // Testing Strategy\n  if (config.testing_strategy) {\n    lines.push('## Testing Strategy');\n    const ts = config.testing_strategy;\n    if (ts.framework) lines.push(`- Framework: ${ts.framework}`);\n    if (ts.coverage_target) lines.push(`- Coverage target: ${ts.coverage_target}`);\n    if (ts.patterns && Array.isArray(ts.patterns)) {\n      for (const p of ts.patterns) {\n        lines.push(`- ${p}`);\n      }\n    }\n    lines.push('');\n  }\n\n  // Deployment\n  if (config.deployment) {\n    lines.push('## Deployment');\n    const dep = config.deployment;\n    if (dep.platform) lines.push(`- Platform: ${dep.platform}`);\n    if (dep.branch_strategy) lines.push(`- Branch strategy: ${dep.branch_strategy}`);\n    if (dep.environments && Array.isArray(dep.environments)) {\n      lines.push(`- Environments: ${dep.environments.join('\x2C ')}`);\n    }\n    lines.push('');\n  }\n\n  // NEVER DO \u2014 critical constraints\n  lines.push('## \u26d4 NEVER Do the Following');\n  lines.push('> Violating ANY of these will break the project. Treat as non-negotiable.');\n  for (const rule of config.never_do) {\n    lines.push(`- \u274c ${rule}`);\n  }\n  lines.push('');\n\n  // Preferred patterns\n  if (config.preferred_patterns && config.preferred_patterns.length) {\n    lines.push('## \u2705 Always Prefer These Patterns');\n    for (const pref of config.preferred_patterns) {\n      lines.push(`- ${pref}`);\n    }\n    lines.push('');\n  }\n\n  // Agent Workflow\n  if (config.agent_skills) {\n    lines.push('## \ud83e\udd16 Agent Workflow');\n    const skills = config.agent_skills;\n    if (skills.directory) lines.push(`- **Skills Directory**: ${skills.directory}`);\n    if (skills.default_skills && skills.default_skills.length) {\n      lines.push(`- **Default Skills to Load**: ${skills.default_skills.join('\x2C ')}`);\n    }\n    if (skills.mandatory_skills) {\n      const triggers = Object.entries(skills.mandatory_skills).map(([k\x2C v]) => `${k} files -> ${v}`).join('\x2C ');\n      lines.push(`- **Mandatory Skills**: ${triggers}`);\n    }\n    if (skills.session_reporting_preference !== undefined) {\n      lines.push(`- **Session Reporting**: ${skills.session_reporting_preference ? 'Yes (Call get_skill_session_report at session end)' : 'No'}`);\n    }\n    lines.push('');\n  }\n\n  const prompt = lines.join('\\n');\n\n  return {\n    config_path: configPath\x2C\n    project_name: config.name\x2C\n    prompt\x2C\n    prompt_token_estimate: Math.ceil(prompt.length / 4)\x2C\n    validation\n  };\n}\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Config template \u2014 opinionated starter\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getConfigTemplate() {\n  return {\n    name: 'my-project'\x2C\n    version: '1.0.0'\x2C\n    description: 'One-paragraph description of what this project does and who it serves.'\x2C\n    tech_stack: [\n      'Next.js 15 (App Router)'\x2C\n      'TypeScript 5.5'\x2C\n      'PostgreSQL 16 via Drizzle ORM'\x2C\n      'Tailwind CSS v4'\x2C\n      'Vercel Deployment'\n    ]\x2C\n    conventions: [\n      'All components use named exports\x2C never default exports'\x2C\n      'Database queries live exclusively in /lib/db/*.ts'\x2C\n      'API routes use Route Handlers in /app/api/**/*.ts'\x2C\n      'Zod schemas validate all external input'\n    ]\x2C\n    architecture_patterns: [\n      'Server Components for data fetching\x2C Client Components for interactivity only'\x2C\n      'Repository pattern for database access'\x2C\n      'Feature-based folder structure under /features'\n    ]\x2C\n    file_structure: {\n      'src/app': 'Next.js App Router pages and layouts'\x2C\n      'src/features': 'Feature modules with co-located components\x2C hooks\x2C and types'\x2C\n      'src/lib': 'Shared utilities\x2C database client\x2C auth helpers'\x2C\n      'src/components/ui': 'Reusable UI primitives (Button\x2C Modal\x2C Input)'\x2C\n      'tests': 'Test files mirroring src/ structure'\n    }\x2C\n    testing_strategy: {\n      framework: 'Vitest + React Testing Library'\x2C\n      coverage_target: '80%'\x2C\n      patterns: [\n        'Unit tests for all utility functions'\x2C\n        'Integration tests for API routes'\x2C\n        'Component tests for interactive UI elements'\n      ]\n    }\x2C\n    deployment: {\n      platform: 'Vercel'\x2C\n      branch_strategy: 'main \u2192 production\x2C dev \u2192 preview'\x2C\n      environments: ['development'\x2C 'staging'\x2C 'production']\n    }\x2C\n    sprint_focus: 'Building the user onboarding flow with email verification and profile setup.'\x2C\n    sprint_skills: [\n      'lifecycle/security-and-hardening'\x2C\n      'lifecycle/api-and-interface-design'\x2C\n      'lifecycle/test-driven-development'\n    ]\x2C\n    never_do: [\n      'Never use useEffect for data fetching \u2014 use Server Components or SWR'\x2C\n      'Never store secrets in .env files committed to git'\x2C\n      'Never use inline styles \u2014 always use Tailwind classes'\x2C\n      'Never use `any` TypeScript type \u2014 always type explicitly'\x2C\n      'Never mix database queries into React components'\n    ]\x2C\n    preferred_patterns: [\n      'Use Zod for all schema validation'\x2C\n      'Use Drizzle ORM for all database access'\x2C\n      'Use server actions for mutations'\x2C\n      'Use Next.js Image component for all images'\n    ]\x2C\n    agent_skills: {\n      directory: '/home/thor/skiils'\x2C\n      default_skills: [\n        'lifecycle/using-agent-skills'\x2C\n        'lifecycle/context-engineering'\n      ]\x2C\n      mandatory_skills: {\n        api: 'lifecycle/api-and-interface-design'\x2C\n        auth: 'lifecycle/security-and-hardening'\n      }\x2C\n      session_reporting_preference: true\n    }\n  };\n}\n\nmodule.exports = { generateProjectPrompt\x2C findProjectConfig\x2C getConfigTemplate\x2C validateConfig };\n

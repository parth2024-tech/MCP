script-source,367,/home/thor/skiils/tools/server/node_modules/better-sqlite3/lib/database.js,'use strict';\nconst fs = require('fs');\nconst path = require('path');\nconst util = require('./util');\nconst SqliteError = require('./sqlite-error');\n\nlet DEFAULT_ADDON;\n\nfunction Database(filenameGiven\x2C options) {\n\x09if (new.target == null) {\n\x09\x09return new Database(filenameGiven\x2C options);\n\x09}\n\n\x09// Apply defaults\n\x09let buffer;\n\x09if (Buffer.isBuffer(filenameGiven)) {\n\x09\x09buffer = filenameGiven;\n\x09\x09filenameGiven = ':memory:';\n\x09}\n\x09if (filenameGiven == null) filenameGiven = '';\n\x09if (options == null) options = {};\n\n\x09// Validate arguments\n\x09if (typeof filenameGiven !== 'string') throw new TypeError('Expected first argument to be a string');\n\x09if (typeof options !== 'object') throw new TypeError('Expected second argument to be an options object');\n\x09if ('readOnly' in options) throw new TypeError('Misspelled option "readOnly" should be "readonly"');\n\x09if ('memory' in options) throw new TypeError('Option "memory" was removed in v7.0.0 (use ":memory:" filename instead)');\n\n\x09// Interpret options\n\x09const filename = filenameGiven.trim();\n\x09const anonymous = filename === '' || filename === ':memory:';\n\x09const readonly = util.getBooleanOption(options\x2C 'readonly');\n\x09const fileMustExist = util.getBooleanOption(options\x2C 'fileMustExist');\n\x09const timeout = 'timeout' in options ? options.timeout : 5000;\n\x09const verbose = 'verbose' in options ? options.verbose : null;\n\x09const nativeBinding = 'nativeBinding' in options ? options.nativeBinding : null;\n\n\x09// Validate interpreted options\n\x09if (readonly && anonymous && !buffer) throw new TypeError('In-memory/temporary databases cannot be readonly');\n\x09if (!Number.isInteger(timeout) || timeout < 0) throw new TypeError('Expected the "timeout" option to be a positive integer');\n\x09if (timeout > 0x7fffffff) throw new RangeError('Option "timeout" cannot be greater than 2147483647');\n\x09if (verbose != null && typeof verbose !== 'function') throw new TypeError('Expected the "verbose" option to be a function');\n\x09if (nativeBinding != null && typeof nativeBinding !== 'string' && typeof nativeBinding !== 'object') throw new TypeError('Expected the "nativeBinding" option to be a string or addon object');\n\n\x09// Load the native addon\n\x09let addon;\n\x09if (nativeBinding == null) {\n\x09\x09addon = DEFAULT_ADDON || (DEFAULT_ADDON = require('bindings')('better_sqlite3.node'));\n\x09} else if (typeof nativeBinding === 'string') {\n\x09\x09// See <https://webpack.js.org/api/module-variables/#__non_webpack_require__-webpack-specific>\n\x09\x09const requireFunc = typeof __non_webpack_require__ === 'function' ? __non_webpack_require__ : require;\n\x09\x09addon = requireFunc(path.resolve(nativeBinding).replace(/(\\.node)?$/\x2C '.node'));\n\x09} else {\n\x09\x09// See <https://github.com/WiseLibs/better-sqlite3/issues/972>\n\x09\x09addon = nativeBinding;\n\x09}\n\n\x09if (!addon.isInitialized) {\n\x09\x09addon.setErrorConstructor(SqliteError);\n\x09\x09addon.isInitialized = true;\n\x09}\n\n\x09// Make sure the specified directory exists\n\x09if (!anonymous && !filename.startsWith('file:') && !fs.existsSync(path.dirname(filename))) {\n\x09\x09throw new TypeError('Cannot open database because the directory does not exist');\n\x09}\n\n\x09Object.defineProperties(this\x2C {\n\x09\x09[util.cppdb]: { value: new addon.Database(filename\x2C filenameGiven\x2C anonymous\x2C readonly\x2C fileMustExist\x2C timeout\x2C verbose || null\x2C buffer || null) }\x2C\n\x09\x09...wrappers.getters\x2C\n\x09});\n}\n\nconst wrappers = require('./methods/wrappers');\nDatabase.prototype.prepare = wrappers.prepare;\nDatabase.prototype.transaction = require('./methods/transaction');\nDatabase.prototype.pragma = require('./methods/pragma');\nDatabase.prototype.backup = require('./methods/backup');\nDatabase.prototype.serialize = require('./methods/serialize');\nDatabase.prototype.function = require('./methods/function');\nDatabase.prototype.aggregate = require('./methods/aggregate');\nDatabase.prototype.table = require('./methods/table');\nDatabase.prototype.loadExtension = wrappers.loadExtension;\nDatabase.prototype.exec = wrappers.exec;\nDatabase.prototype.close = wrappers.close;\nDatabase.prototype.defaultSafeIntegers = wrappers.defaultSafeIntegers;\nDatabase.prototype.unsafeMode = wrappers.unsafeMode;\nDatabase.prototype[util.inspect] = require('./methods/inspect');\n\nmodule.exports = Database;\n

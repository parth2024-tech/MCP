script-source,417,/home/thor/skiils/tools/server/src/services/model-router.js,const fs = require('fs').promises;\nconst path = require('path');\nconst { logAccess\x2C logger } = require('../utils/logger');\n\nconst CONFIG_PATH = path.join(__dirname\x2C '../../../config/model-params.json');\n\nlet config = null;\nlet compiledSignals = {};\n\nasync function loadConfig() {\n  if (config) return config;\n  try {\n    const raw = await fs.readFile(CONFIG_PATH\x2C 'utf8');\n    config = JSON.parse(raw);\n  } catch (err) {\n    logger.error('ModelRouter'\x2C `Failed to load config ${CONFIG_PATH}: ${err.message}`);\n    config = { task_types: {} }; // fallback\n  }\n\n  // Pre-compile signals\n  for (const [taskType\x2C profile] of Object.entries(config.task_types || {})) {\n    const signals = profile.signals || {};\n    const keywords = (signals.keywords || []).map(k => ({\n      pattern: k.toLowerCase()\x2C\n      weight: 1\n    }));\n    const phrases = (signals.phrases || []).map(p => ({\n      pattern: p.toLowerCase()\x2C\n      weight: 3\n    }));\n\n    compiledSignals[taskType] = [...phrases\x2C ...keywords].sort((a\x2C b) => b.pattern.length - a.pattern.length);\n  }\n\n  return config;\n}\n\nasync function routeModel(request) {\n  const cfg = await loadConfig();\n  const taskTypes = cfg.task_types || {};\n  const FALLBACK = cfg.fallback || 'coding';\n  const MIN_CONFIDENCE = (cfg.global_constraints && cfg.global_constraints.min_confidence_score) || 2;\n\n  if (!request || typeof request !== 'string') {\n    return buildResult(taskTypes\x2C FALLBACK\x2C FALLBACK\x2C 0\x2C []\x2C 'Empty or invalid request. Using fallback.');\n  }\n\n  const lower = request.toLowerCase();\n  let bestType = null;\n  let bestScore = 0;\n  let bestMatches = [];\n\n  for (const [taskType\x2C signals] of Object.entries(compiledSignals)) {\n    let score = 0;\n    const matches = [];\n\n    for (const signal of signals) {\n      if (lower.includes(signal.pattern)) {\n        score += signal.weight;\n        matches.push(signal.pattern);\n      }\n    }\n\n    if (score > bestScore) {\n      bestScore = score;\n      bestType = taskType;\n      bestMatches = matches;\n    }\n  }\n\n  if (!bestType || bestScore < MIN_CONFIDENCE) {\n    const result = buildResult(\n      taskTypes\x2C\n      FALLBACK\x2C\n      FALLBACK\x2C\n      bestScore\x2C\n      bestMatches\x2C\n      bestScore === 0\n        ? 'No signal matches detected. Routing to default coding profile.'\n        : `Low confidence (${bestScore} < ${MIN_CONFIDENCE}). Nearest match was "${bestType}" but defaulting to "${FALLBACK}" for safety.`\n    );\n    result.suggested_action = 'Confidence below threshold. Recommend calling query_skills before proceeding.';\n    return result;\n  }\n\n  return buildResult(\n    taskTypes\x2C\n    bestType\x2C\n    FALLBACK\x2C\n    bestScore\x2C\n    bestMatches\x2C\n    `Matched ${bestMatches.length} signal(s) with total confidence ${bestScore} for task type "${bestType}".`\n  );\n}\n\nfunction buildResult(taskTypes\x2C taskType\x2C fallback\x2C confidence\x2C matchedSignals\x2C rationale) {\n  const profile = taskTypes[taskType];\n  if (!profile) {\n    return {\n      task_type: 'coding'\x2C\n      model: 'claude-sonnet-4-5'\x2C\n      temperature: 0.15\x2C\n      top_p: 0.95\x2C\n      max_tokens: 8192\x2C\n      description: 'Config error \u2014 using hardcoded emergency fallback.'\x2C\n      lifecycle_phase: 'build'\x2C\n      recommended_skills: []\x2C\n      confidence: 0\x2C\n      matched_signals: []\x2C\n      rationale: `Task type "${taskType}" not found in model-params.json. Using emergency fallback.`\n    };\n  }\n\n  return {\n    task_type: taskType\x2C\n    model: profile.model\x2C\n    temperature: profile.temperature\x2C\n    top_p: profile.top_p\x2C\n    max_tokens: profile.max_tokens\x2C\n    description: profile.description\x2C\n    lifecycle_phase: profile.lifecycle_phase\x2C\n    recommended_skills: profile.recommended_skills || []\x2C\n    confidence\x2C\n    matched_signals: matchedSignals\x2C\n    rationale\n  };\n}\n\nasync function getTaskTaxonomy() {\n  const cfg = await loadConfig();\n  return Object.entries(cfg.task_types || {}).map(([key\x2C profile]) => ({\n    task_type: key\x2C\n    model: profile.model\x2C\n    temperature: profile.temperature\x2C\n    description: profile.description\n  }));\n}\n\nasync function reloadConfig() {\n  try {\n    const raw = await fs.readFile(CONFIG_PATH\x2C 'utf8');\n    const fresh = JSON.parse(raw);\n\n    // Build new compiled signals into a local object first\n    const newSignals = {};\n    for (const [taskType\x2C profile] of Object.entries(fresh.task_types || {})) {\n      const signals = profile.signals || {};\n      const keywords = (signals.keywords || []).map(k => ({ pattern: k.toLowerCase()\x2C weight: 1 }));\n      const phrases = (signals.phrases || []).map(p => ({ pattern: p.toLowerCase()\x2C weight: 3 }));\n      newSignals[taskType] = [...phrases\x2C ...keywords].sort((a\x2C b) => b.pattern.length - a.pattern.length);\n    }\n\n    // Atomic swap: both module-level references update in the same synchronous tick.\n    // Any concurrent routeModel() call either sees the fully old state or the fully new state \u2014 never a mix.\n    config = fresh;\n    compiledSignals = newSignals;\n\n    return { success: true\x2C task_count: Object.keys(fresh.task_types || {}).length };\n  } catch (err) {\n    return { success: false\x2C error: err.message };\n  }\n}\n\nmodule.exports = { routeModel\x2C getTaskTaxonomy\x2C reloadConfig };\n
